// N3485 15.4p9, 15.5.2: an exception escaping a throw(int) function that has a
// local with a destructor must still call std::unexpected() -> terminate;
// expect exit 0
#include <exception>
#include <cstdlib>
static int d = 0;
struct L { ~L() { ++d; } };
void term() { std::exit(0); }
void thrower() { throw 'c'; }
void k6() throw(int) { L l; thrower(); }
int main() { std::set_terminate(term); try { k6(); } catch (...) { return 1; } return 2; }
