// N3485 15.3p2, 15.5.1p1: inside a noexcept function, or a destructor, an
// exception from an array element's construction or destruction, a
// new-expression's elements or a std::initializer_list's array is caught by an
// enclosing handler of the same function after the elements already
// constructed are destroyed; std::terminate is called only when no handler
// takes it
#include "600-hosted-eh-noexcept-try-arrays.helper.h"
#include <initializer_list>
static int n, k, r;
struct U { U() { if (++n == k) throw 5; } U(const U&) { if (++n == k) throw 6; } ~U() { r += 1; } };
struct E { int id; E(int i) : id(i) {} ~E() noexcept(false) { r += 10; if (id == k) throw 7; } };
static int f1() noexcept { try { U v[2]; return 1; } catch (...) { return 3; } }
static int f2() noexcept { try { U v[2][2]; return 1; } catch (...) { return 3; } }
static int f3() noexcept { try { U v[10]; return 1; } catch (...) { return 3; } }
static int f4() noexcept { try { try { throw 1; } catch (int) { U v[3]; } return 1; } catch (...) { return 3; } }
static int f5() noexcept { try { try { throw 1; } catch (int) { delete[] new U[3]; } return 1; } catch (...) { return 3; } }
static int f6() noexcept { try { E v[3] = { E(1), E(2), E(3) }; } catch (int) { return 3; } return 1; }
static int f7() noexcept { try { std::initializer_list<U> l = { U(), U(), U() }; (void)l; return 1; } catch (...) { return 3; } }
static int f8() noexcept { try { U a; U v[2]; return 1; } catch (...) { return 3; } }
struct S { int* out; ~S() { try { U v[3]; } catch (...) { *out += 100; } } };
static int f9() { int got = 0; { S s; s.out = &got; } return got; }
int main()
{
  int (*fs[])() = { f1, f2, f3, f4, f5, f6, f7, f8, f9 };
  for (int f = 0; f < 9; ++f)
    for (k = 1; k <= 4; ++k)
    {
      n = 0;
      r = 0;
      int got = fs[f]();
      out_line("f", (unsigned long long)(f * 1000000 + k * 10000 + got * 1000 + r));
    }
  return 0;
}
