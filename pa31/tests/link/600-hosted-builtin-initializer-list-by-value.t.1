// N3485 8.5.4p5, 18.9: a std::initializer_list<int> parameter initialized from
// {7, 8} sees both elements
#ifdef __CPPGM__
namespace std { template<class T> class initializer_list; }
#else
#include <initializer_list>
#endif
int sum(std::initializer_list<int> l) { int s = 0; for (int x : l) s = s * 10 + x; return s; }
int main() { return sum({7, 8}) == 78 ? 0 : 1; }
