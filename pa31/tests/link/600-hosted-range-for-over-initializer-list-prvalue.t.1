// N3485 6.5.4p1, 8.5.4p5, 12.2p5: a range-for whose range is the prvalue
// std::initializer_list<int>{1, 2} (bound to __range, lives through the loop);
// expect exit 0
#include <initializer_list>
int main() { int s = 0; for (int x : std::initializer_list<int>{1, 2}) s += x; return s == 3 ? 0 : 1; }
