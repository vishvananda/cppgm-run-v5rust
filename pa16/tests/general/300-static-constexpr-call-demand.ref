function @read(%value : ptr [pass=by_address, object_bytes=4]) -> i32 [binding=strong, object=_Z4readRKi] {
  slot $value : ptr

  block ^entry:
    store typed ptr %value, $value
    %t1 = load typed ptr $value
    %t2 = load typed i32 %t1
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = addr @stored__value
