global @value [binding=strong] = {
  zero 1
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr @value
    %t2 = call u8 @query(%t1)
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load typed i32 $cond__1
    return i32 %t3
}
function @query(%x : ptr [pass=by_address, object_bytes=1]) -> u8 [binding=weak, object=_Z5queryI4LazyIiEEbRT_] {
  slot $x : ptr

  block ^entry:
    store typed ptr %x, $x
    return u8 1
}
