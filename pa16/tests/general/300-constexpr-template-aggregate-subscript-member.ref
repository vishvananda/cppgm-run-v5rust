    store typed i32 7, %t11
    %t12 = addr $flat_values
    %t13 = index i8 [projection=field] %t12, 0
    %t14 = index i32 [projection=array_element] %t13, 1
    store typed i32 11, %t14
    %t15 = addr $flat_values
    %t16 = index i8 [projection=field] %t15, 0
    %t17 = index i32 [projection=array_element] %t16, 2
    store typed i32 13, %t17
    %t18 = addr $flat_values
    %t19 = index i8 [projection=field] %t18, 0
    %t20 = index i32 [projection=array_element] %t19, 3
