declare function @consume(%arg0 : ptr) -> void [binding=strong, object=_Z7consumeP6opaque]

function @relay(%value : ptr [pass=by_address]) -> void [binding=strong, object=_Z5relayR6opaque] {
  slot $value : ptr

  block ^entry:
    store typed ptr %value, $value
    %t1 = load typed ptr $value
    call void @consume(%t1)
    return void
}
