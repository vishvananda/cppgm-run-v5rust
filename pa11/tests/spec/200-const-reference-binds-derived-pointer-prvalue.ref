global @object : obj<8x4> [binding=strong] = {
  zero 8
}
global @saved : ptr [binding=strong] = zero

function @get() -> ptr [binding=strong, object=_Z3getv] {
  block ^entry:
    %t1 = addr @object
    return ptr %t1
}
function @push(%p : ptr [pass=by_address, object_bytes=8]) -> void [binding=strong, object=_Z4pushRKP4Base] {
  slot $p : ptr

  block ^entry:
    store typed ptr %p, $p
    %t1 = load typed ptr $p
    %t2 = load typed ptr %t1
    store typed ptr %t2, @saved
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $refarg__1 : ptr
  slot $cond__2 : i32

  block ^entry:
    %t1 = call ptr @get()
    %t2 = index i8 %t1, 0
    store typed ptr %t2, $refarg__1
    %t3 = addr $refarg__1
    call void @push(%t3)
    %t4 = load typed ptr @saved
    %t5 = addr @object
    %t6 = index i8 %t5, 0
    %t7 = cmp eq ptr %t4, %t6
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__2
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__2
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load typed i32 $cond__2
    return i32 %t8
}
