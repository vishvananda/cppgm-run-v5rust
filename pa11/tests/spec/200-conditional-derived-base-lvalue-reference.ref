function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $b : obj<4x4>
  slot $d : obj<4x4>
  slot $flag : u8
  slot $ref : ptr
  slot $condaddr__1 : ptr
  slot $cond__2 : i32

  block ^entry:
    %t1 = addr $b
    %t2 = addr $d
    %t3 = addr $b
    %t4 = index i8 [projection=field] %t3, 0
    store typed i32 1, %t4
    %t5 = addr $d
    %t6 = index i8 %t5, 0
    %t7 = index i8 [projection=field] %t6, 0
    store typed i32 2, %t7
    store u8 0, $flag
    %t8 = load u8 $flag
    branch %t8, ^condaddr_then_1, ^condaddr_else_2

  block ^condaddr_then_1:
    %t9 = addr $b
    store typed ptr %t9, $condaddr__1
    jump ^condaddr_end_3

  block ^condaddr_else_2:
    %t10 = addr $d
    %t11 = index i8 %t10, 0
    store typed ptr %t11, $condaddr__1
    jump ^condaddr_end_3

  block ^condaddr_end_3:
    %t12 = load typed ptr $condaddr__1
    store typed ptr %t12, $ref
    %t13 = load typed ptr $ref
    %t14 = index i8 [projection=field] %t13, 0
    store typed i32 4, %t14
    %t15 = addr $d
    %t16 = index i8 %t15, 0
    %t17 = index i8 [projection=field] %t16, 0
    %t18 = load typed i32 %t17
    %t19 = cmp eq i32 %t18, 4
    branch %t19, ^cond_then_4, ^cond_else_5

  block ^cond_then_4:
    store typed i32 0, $cond__2
    jump ^cond_end_6

  block ^cond_else_5:
    store typed i32 1, $cond__2
    jump ^cond_end_6

  block ^cond_end_6:
    %t20 = load typed i32 $cond__2
    return i32 %t20
}
