function @value() -> i32 [binding=strong, object=_Z5valuev] {
  slot $source : obj<1x1>
  slot $result : i32

  block ^entry:
    %t1 = addr $source
    store typed i32 0, $result
    %t2 = load typed i32 $result
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @value()
    return i32 %t1
}
