function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = const i64 8
    %t2 = const i64 8
    %t3 = cmp ne i64 %t1, %t2
    branch %t3, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t4 = const i64 8
    %t5 = const i64 8
    %t6 = cmp eq i64 %t4, %t5
    branch %t6, ^cond_then_4, ^cond_else_5

  block ^cond_then_4:
    store typed i32 0, $cond__1
    jump ^cond_end_6

  block ^cond_else_5:
    store typed i32 1, $cond__1
    jump ^cond_end_6

  block ^cond_end_6:
    %t7 = load typed i32 $cond__1
    return i32 %t7
}
