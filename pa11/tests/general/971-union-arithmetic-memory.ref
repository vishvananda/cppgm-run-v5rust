function @f(%u : ptr [pass=by_address, object_bytes=8], %i : i32) -> i32 [binding=strong, object=_Z1fR1Ui] {
  slot $u : ptr
  slot $i : i32

  block ^entry:
    store typed ptr %u, $u
    store typed i32 %i, $i
    %t1 = load typed ptr $u
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load typed i32 $i
    %t4 = convert sext i64 i32 %t3
    %t5 = binary mul i64 %t4, 4
    %t6 = index i8 %t2, %t5
    %t7 = load i32 %t6
    return i32 %t7
}
