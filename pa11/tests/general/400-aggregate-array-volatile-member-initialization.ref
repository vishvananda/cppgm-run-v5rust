function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $devices : obj<16x4>
  slot $first : i32
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = addr $devices
    call void @Device__Device__aggregate(%t1, 3, 1)
    %t2 = index i8 %t1, 8
    call void @Device__Device__aggregate(%t2, 4, 2)
    %t3 = addr $devices
    %t4 = binary mul i64 0, 8
    %t5 = index i8 [projection=array_element] %t3, %t4
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = load volatile i32 %t6
    store typed i32 %t7, $first
    %t8 = addr $devices
    %t9 = binary mul i64 1, 8
    %t10 = index i8 [projection=array_element] %t8, %t9
    %t11 = index i8 [projection=field] %t10, 0
    store volatile i32 8, %t11
    %t12 = load typed i32 $first
    %t13 = cmp eq i32 %t12, 3
    branch %t13, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t14 = addr $devices
    %t15 = binary mul i64 1, 8
    %t16 = index i8 [projection=array_element] %t14, %t15
    %t17 = index i8 [projection=field] %t16, 0
    %t18 = load volatile i32 %t17
    %t19 = cmp eq i32 %t18, 8
    %t20 = cmp ne i64 %t19, 0
    store typed i64 %t20, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t21 = load typed i64 $land__2
    branch %t21, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t22 = addr $devices
    %t23 = binary mul i64 0, 8
    %t24 = index i8 [projection=array_element] %t22, %t23
    %t25 = index i8 [projection=field] %t24, 4
    %t26 = load typed i32 %t25
    %t27 = cmp eq i32 %t26, 1
    %t28 = cmp ne i64 %t27, 0
    store typed i64 %t28, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t29 = load typed i64 $land__3
    branch %t29, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t30 = addr $devices
    %t31 = binary mul i64 1, 8
    %t32 = index i8 [projection=array_element] %t30, %t31
    %t33 = index i8 [projection=field] %t32, 4
    %t34 = load typed i32 %t33
    %t35 = cmp eq i32 %t34, 2
    %t36 = cmp ne i64 %t35, 0
    store typed i64 %t36, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t37 = load typed i64 $land__4
    branch %t37, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t38 = load typed i32 $cond__1
    return i32 %t38
}
function @Device__Device__aggregate(%this : ptr [object_bytes=8], %status : i32, %data : i32) -> void [unwind=no, binding=internal] {
  slot $this : ptr
  slot $status : i32
  slot $data : i32

  block ^entry:
    store typed ptr %this, $this
    store typed i32 %status, $status
    store typed i32 %data, $data
    %t1 = load typed i32 $status
    %t2 = load typed ptr $this
    %t3 = index i8 [projection=field] %t2, 0
    store volatile i32 %t1, %t3
    %t4 = load typed i32 $data
    %t5 = load typed ptr $this
    %t6 = index i8 [projection=field] %t5, 4
    store typed i32 %t4, %t6
    return void
}
