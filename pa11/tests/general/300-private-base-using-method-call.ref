function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $d : obj<1x1>

  block ^entry:
    %t1 = addr $d
    %t2 = addr $d
    %t3 = index i8 %t2, 0
    %t4 = call i32 @Base__f(%t3)
    %t5 = binary sub nowrap i32 %t4, 7
    return i32 %t5
}
function @Base__f(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZNK4Base1fEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i32 7
}
