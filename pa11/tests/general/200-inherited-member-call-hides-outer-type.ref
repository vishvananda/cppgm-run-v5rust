global @value : i32 [binding=strong] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $d : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $d
    %t2 = addr $d
    %t3 = call ptr @D__g(%t2)
    %t4 = addr @value
    %t5 = cmp eq ptr %t3, %t4
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t6 = load typed i32 $cond__1
    return i32 %t6
}
function @D__g(%this : ptr [object_bytes=1]) -> ptr [binding=weak, object=_ZN1D1gEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index i8 %t1, 0
    %t3 = call ptr @B__f(%t2)
    return ptr %t3
}
function @B__f(%this : ptr [object_bytes=1]) -> ptr [binding=weak, object=_ZN1B1fEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = addr @value
    return ptr %t1
}
