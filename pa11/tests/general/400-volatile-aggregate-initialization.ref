function @local() -> i32 [binding=strong, object=_Z5localv] {
  slot $device : obj<32x8>

  block ^entry:
    %t1 = addr $device
    %t2 = addr $device
    %t3 = index i8 [projection=field] %t2, 0
    store volatile i32 1, %t3
    %t4 = addr $device
    %t5 = index i8 [projection=field] %t4, 4
    %t6 = index i32 [projection=array_element] %t5, 0
    store volatile i32 2, %t6
    %t7 = addr $device
    %t8 = index i8 [projection=field] %t7, 4
    %t9 = index i32 [projection=array_element] %t8, 1
    store volatile i32 3, %t9
    %t10 = addr $device
    %t11 = index i8 [projection=field] %t10, 12
    %t12 = index i8 [projection=field] %t11, 0
    store volatile i32 4, %t12
    %t13 = addr $device
    %t14 = index i8 [projection=field] %t13, 16
    %t15 = binary and u32 7, 5
    store volatile u32 %t15, %t14
    %t16 = addr $device
    %t17 = index i8 [projection=field] %t16, 24
    store volatile ptr 0, %t17
    %t18 = addr $device
    %t19 = index i8 [projection=field] %t18, 0
    %t20 = load volatile i32 %t19
    %t21 = addr $device
    %t22 = index i8 [projection=field] %t21, 4
    %t23 = index i32 [projection=array_element] %t22, 1
    %t24 = load volatile i32 %t23
    %t25 = binary add nowrap i32 %t20, %t24
    %t26 = addr $device
    %t27 = index i8 [projection=field] %t26, 12
    %t28 = index i8 [projection=field] %t27, 0
    %t29 = load volatile i32 %t28
    %t30 = binary add nowrap i32 %t25, %t29
    %t31 = addr $device
    %t32 = index i8 [projection=field] %t31, 16
    %t33 = load volatile i32 %t32
    %t34 = binary and i32 %t33, 7
    %t35 = copy u32 %t34
    %t36 = copy i32 %t35
    %t37 = binary add nowrap i32 %t30, %t36
    return i32 %t37
}
