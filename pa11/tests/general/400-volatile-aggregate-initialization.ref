function @bits(%device : ptr [pass=by_address, object_bytes=32]) -> i32 [binding=strong, object=_Z4bitsRV6Device] {
  slot $device : ptr

  block ^entry:
    store typed ptr %device, $device
    %t1 = load typed ptr $device
    %t2 = index i8 [projection=field] %t1, 16
    %t3 = binary and i32 2, 7
    %t4 = copy u32 %t3
    %t5 = load volatile i32 %t2
    %t6 = binary and i32 %t5, -8
    %t7 = binary or i32 %t6, %t3
    store volatile i32 %t7, %t2
    %t8 = load typed ptr $device
    %t9 = index i8 [projection=field] %t8, 16
    %t10 = load volatile i32 %t9
    %t11 = binary and i32 %t10, 7
    %t12 = copy u32 %t11
    %t13 = copy i32 %t12
    %t14 = binary add nowrap i32 %t13, 1
    %t15 = load typed ptr $device
    %t16 = index i8 [projection=field] %t15, 16
    %t17 = binary and i32 %t14, 7
    %t18 = copy u32 %t17
    %t19 = load volatile i32 %t16
    %t20 = binary and i32 %t19, -8
    %t21 = binary or i32 %t20, %t17
    store volatile i32 %t21, %t16
    %t22 = load typed ptr $device
    %t23 = index i8 [projection=field] %t22, 16
    %t24 = load volatile i32 %t23
    %t25 = binary and i32 %t24, 7
    %t26 = copy u32 %t25
    %t27 = copy i32 %t26
    return i32 %t27
