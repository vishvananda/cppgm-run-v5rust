function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $plain : obj<32x8>
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = addr $plain
    %t2 = addr $plain
    %t3 = index i8 [projection=field] %t2, 0
    store typed i32 0, %t3
    %t4 = addr $plain
    %t5 = index i8 [projection=field] %t4, 4
    %t6 = index i32 [projection=array_element] %t5, 0
    store typed i32 0, %t6
    %t7 = addr $plain
    %t8 = index i8 [projection=field] %t7, 4
    %t9 = index i32 [projection=array_element] %t8, 1
    store typed i32 0, %t9
    %t10 = addr $plain
    %t11 = index i8 [projection=field] %t10, 12
    %t12 = index i8 [projection=field] %t11, 0
    store typed i32 0, %t12
    %t13 = addr $plain
    %t14 = index i8 [projection=field] %t13, 16
    %t15 = binary and u32 7, 0
    store u32 %t15, %t14
    %t16 = addr $plain
    %t17 = index i8 [projection=field] %t16, 24
    store typed ptr 0, %t17
    %t18 = call i32 @local()
    %t19 = cmp eq i32 %t18, 13
    branch %t19, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t20 = call i32 @partial()
    %t21 = cmp eq i32 %t20, 0
    %t22 = cmp ne i64 %t21, 0
    store typed i64 %t22, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t23 = load typed i64 $land__2
    branch %t23, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t24 = call i32 @grid()
    %t25 = cmp eq i32 %t24, 20
    %t26 = cmp ne i64 %t25, 0
    store typed i64 %t26, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t27 = load typed i64 $land__3
    branch %t27, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t28 = addr $plain
    %t29 = call i32 @bits(%t28)
    %t30 = cmp eq i32 %t29, 3
    %t31 = cmp ne i64 %t30, 0
    store typed i64 %t31, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t32 = load typed i64 $land__4
    branch %t32, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
