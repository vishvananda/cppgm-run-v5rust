function @observe(%value : ptr [pass=by_address, object_bytes=4], %x : ptr [pass=by_address, object_bytes=4]) -> i32 [binding=strong, object=_Z7observeRKiR1X] {
  slot $value : ptr
  slot $x : ptr

  block ^entry:
    store typed ptr %value, $value
    store typed ptr %x, $x
    %t1 = load typed ptr $x
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = unary neg i32 1
    %t4 = binary and i32 %t3, 7
    %t5 = binary shl i32 %t4, 29
    %t6 = binary shr i32 %t5, 29
    %t7 = load i32 %t2
    %t8 = binary and i32 %t7, -8
    %t9 = binary or i32 %t8, %t4
    store i32 %t9, %t2
    %t10 = load typed ptr $value
    %t11 = load typed i32 %t10
    return i32 %t11
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : obj<4x4>
  slot $snapshot : ptr
  slot $tmpref__1 : i32
  slot $lor__2 : i64
  slot $refarg__3 : i32

  block ^entry:
    %t1 = addr $x
    %t2 = addr $x
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = binary and i32 7, 3
    store i32 %t4, %t3
    %t5 = addr $x
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = load i32 %t6
    %t8 = binary and i32 %t7, 7
    %t9 = binary shl i32 %t8, 29
    %t10 = binary shr i32 %t9, 29
    store typed i32 %t10, $tmpref__1
    %t11 = addr $tmpref__1
    store typed ptr %t11, $snapshot
    %t12 = addr $x
    %t13 = index i8 [projection=field] %t12, 0
    %t14 = unary neg i32 1
    %t15 = binary and i32 %t14, 7
    %t16 = binary shl i32 %t15, 29
    %t17 = binary shr i32 %t16, 29
    %t18 = load i32 %t13
    %t19 = binary and i32 %t18, -8
    %t20 = binary or i32 %t19, %t15
    store i32 %t20, %t13
    %t21 = load typed ptr $snapshot
    %t22 = load typed i32 %t21
    %t23 = cmp ne i32 %t22, 3
    branch %t23, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t24 = addr $x
    %t25 = index i8 [projection=field] %t24, 0
    %t26 = load i32 %t25
    %t27 = binary and i32 %t26, 7
    %t28 = binary shl i32 %t27, 29
    %t29 = binary shr i32 %t28, 29
    %t30 = unary neg i32 1
    %t31 = cmp ne i32 %t29, %t30
    branch %t31, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_4

  block ^if_end_4:
    %t32 = addr $x
    %t33 = index i8 [projection=field] %t32, 0
    %t34 = binary and i32 3, 7
    %t35 = binary shl i32 %t34, 29
    %t36 = binary shr i32 %t35, 29
    %t37 = load i32 %t33
    %t38 = binary and i32 %t37, -8
    %t39 = binary or i32 %t38, %t34
    store i32 %t39, %t33
    %t40 = addr $x
    %t41 = index i8 [projection=field] %t40, 0
    %t42 = load i32 %t41
    %t43 = binary and i32 %t42, 7
    %t44 = binary shl i32 %t43, 29
    %t45 = binary shr i32 %t44, 29
    store typed i32 %t45, $refarg__3
    %t46 = addr $refarg__3
    %t47 = addr $x
    %t48 = call i32 @observe(%t46, %t47)
    %t49 = cmp ne i32 %t48, 3
    branch %t49, ^lor_short_6, ^lor_rhs_5

  block ^lor_rhs_5:
    %t50 = addr $x
    %t51 = index i8 [projection=field] %t50, 0
    %t52 = load i32 %t51
    %t53 = binary and i32 %t52, 7
    %t54 = binary shl i32 %t53, 29
    %t55 = binary shr i32 %t54, 29
    %t56 = unary neg i32 1
    %t57 = cmp ne i32 %t55, %t56
    %t58 = cmp ne i64 %t57, 0
    store typed i64 %t58, $lor__2
    jump ^lor_end_7

  block ^lor_short_6:
    store typed i64 1, $lor__2
    jump ^lor_end_7

  block ^lor_end_7:
    %t59 = load typed i64 $lor__2
    %t60 = convert trunc i32 i64 %t59
    return i32 %t60
}
