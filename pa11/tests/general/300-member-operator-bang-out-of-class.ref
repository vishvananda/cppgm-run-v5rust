function @Box__operator_(%this : ptr [object_bytes=1]) -> u8 [binding=strong, object=_ZNK3BoxntEv] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return u8 1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $box : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $box
    %t2 = addr $box
    %t3 = call u8 @Box__operator_(%t2)
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load typed i32 $cond__1
    return i32 %t4
}
