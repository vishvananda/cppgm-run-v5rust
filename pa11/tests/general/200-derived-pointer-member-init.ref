function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $node : obj<1x1>
  slot $iter : obj<8x8>

  block ^entry:
    %t1 = addr $node
    %t2 = addr $iter
    %t3 = addr $node
    call void @Iter__Iter(%t2, %t3)
