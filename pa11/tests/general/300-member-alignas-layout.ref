function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = const i64 8
    %t2 = convert sext i64 i32 8
    %t3 = cmp eq i64 %t1, %t2
    branch %t3, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t4 = const i64 8
    %t5 = convert sext i64 i32 8
    %t6 = cmp eq i64 %t4, %t5
    %t7 = cmp ne i64 %t6, 0
    store typed i64 %t7, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t8 = load typed i64 $land__2
    branch %t8, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t9 = load typed i32 $cond__1
    return i32 %t9
}
