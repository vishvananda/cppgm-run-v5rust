    %t4 = unary neg i32 1
    store typed i32 %t4, $subscript
    store typed u32 2, $index
    %t5 = addr $values
    %t6 = binary mul i64 1, 4
    %t7 = index i8 %t5, %t6
    %t8 = addr $subscript
    %t9 = call i32 @read(%t7, %t8)
    %t10 = cmp ne i32 %t9, 7
