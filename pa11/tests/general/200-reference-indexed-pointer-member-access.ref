    %t12 = addr $index
    %t13 = call i32 @read_unsigned(%t11, %t12)
    %t14 = cmp ne i32 %t13, 19
    %t15 = cmp ne i64 %t14, 0
    store typed i64 %t15, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
