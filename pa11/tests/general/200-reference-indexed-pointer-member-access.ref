    store typed ptr %subscript, $subscript
    %t1 = load typed ptr $elements
    %t2 = load typed ptr $subscript
    %t3 = load typed i32 %t2
    %t4 = convert sext i64 i32 %t3
    %t5 = binary mul i64 %t4, 4
    %t6 = index i8 [projection=array_element] %t1, %t5
    %t7 = index i8 [projection=field] %t6, 0
    %t8 = load typed i32 %t7
    return i32 %t8
}
