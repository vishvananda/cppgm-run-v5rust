function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $box : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $box
    %t2 = addr $box
    %t3 = index i8 [projection=field] %t2, 0
    store typed i32 7, %t3
    %t4 = addr $box
    %t5 = call i32 @Box__read(%t4)
    %t6 = cmp eq i32 %t5, 7
    branch %t6, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t7 = load typed i32 $cond__1
    return i32 %t7
}
function @Box__read(%this : ptr [object_bytes=4]) -> i32 [binding=weak, object=_ZN3Box4readEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = call i32 @Box__pick(%t1)
    return i32 %t2
}
function @Box__pick(%this : ptr [object_bytes=4]) -> i32 [binding=weak, object=_ZN3Box4pickEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load typed i32 %t2
    return i32 %t3
}
