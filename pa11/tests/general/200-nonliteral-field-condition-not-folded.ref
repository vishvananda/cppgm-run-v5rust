function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $one : i32
  slot $empty : obj<16x8>
  slot $full : obj<16x8>
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    store typed i32 1, $one
    %t1 = addr $empty
    %t2 = addr $empty
    %t3 = index i8 [projection=field] %t2, 0
    store u8 0, %t3
    %t4 = addr $empty
    %t5 = index i8 [projection=field] %t4, 8
    store typed ptr 0, %t5
    %t6 = addr $full
    %t7 = addr $full
    %t8 = index i8 [projection=field] %t7, 0
    store u8 0, %t8
    %t9 = addr $one
    %t10 = addr $full
    %t11 = index i8 [projection=field] %t10, 8
    store typed ptr %t9, %t11
    %t12 = addr $empty
    %t13 = call u8 @state__read(%t12)
    %t14 = cmp eq u8 %t13, 0
    branch %t14, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t15 = addr $full
    %t16 = call u8 @state__read(%t15)
    %t17 = cmp ne i64 %t16, 0
    store typed i64 %t17, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t18 = load typed i64 $land__2
    branch %t18, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t19 = load typed i32 $cond__1
    return i32 %t19
}
function @state__read(%this : ptr [object_bytes=16]) -> u8 [binding=weak, object=_ZNK5state4readEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index i8 [projection=field] %t1, 8
    %t3 = load typed ptr %t2
    branch %t3, ^if_then_1, ^if_else_2

  block ^if_then_1:
    %t4 = load typed ptr $this
    %t5 = index i8 [projection=field] %t4, 8
    %t6 = load typed ptr %t5
    %t7 = load typed i32 %t6
    %t8 = cmp ne i32 %t7, 0
    %t9 = convert trunc u8 i64 %t8
    return u8 %t9

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t10 = load typed ptr $this
    %t11 = index i8 [projection=field] %t10, 0
    %t12 = load u8 %t11
    return u8 %t12
}
