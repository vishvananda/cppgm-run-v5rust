function @operator__(%p : ptr [pass=by_address, object_bytes=4], %__param1 : i64) -> u8 [binding=strong, object=_ZneRK3PtrDn] {
  slot $p : ptr
  slot $__param1 : i64

  block ^entry:
    store typed ptr %p, $p
    store typed i64 %__param1, $__param1
    %t1 = load typed ptr $p
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load typed i32 %t2
    %t4 = cmp ne i32 %t3, 0
    %t5 = convert trunc u8 i64 %t4
    return u8 %t5
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $p : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $p
    %t2 = addr $p
    %t3 = index i8 [projection=field] %t2, 0
    store typed i32 1, %t3
    %t4 = addr $p
    %t5 = call u8 @operator__(%t4, 0)
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
