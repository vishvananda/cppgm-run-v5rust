function @array__begin(%this : ptr [object_bytes=4]) -> ptr [unwind=no, binding=strong, object=_ZN5array5beginEv] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    return ptr %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $a
    %t2 = addr $a
    %t3 = index i8 [projection=field] %t2, 0
    store typed i32 7, %t3
    %t4 = addr $a
    %t5 = call ptr @array__begin(%t4)
    %t6 = load typed i32 %t5
    %t7 = cmp eq i32 %t6, 7
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load typed i32 $cond__1
    return i32 %t8
}
