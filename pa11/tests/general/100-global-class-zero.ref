global @g : obj<8x4> [binding=strong] = {
  zero 8
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = const i64 8
    %t2 = convert trunc i32 i64 %t1
    return i32 %t2
}
function @__cppgm_init() -> void [role=init, binding=internal] {
  block ^entry:
    return void
}
