    %t13 = convert trunc i32 i64 %t12
    %t14 = cmp eq f80 %t1, %t11
    %t15 = convert trunc i32 i64 %t14
    %t16 = binary or i32 %t13, %t15
    %t17 = binary sub i32 1, %t16
    %t18 = binary and i32 %t10, %t17
    %t19 = binary and i32 %t18, %t7
    return i32 %t19
}
