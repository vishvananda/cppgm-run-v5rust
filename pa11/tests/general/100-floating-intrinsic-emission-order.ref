function @finite(%value : f80) -> i32 [binding=strong, object=_Z6finitee] {
  slot $value : f80

  block ^entry:
    store typed f80 %value, $value
    %t1 = load typed f80 $value
    %t2 = cmp ne f80 %t1, %t1
    %t3 = convert trunc i32 i64 %t2
    %t4 = binary sub i32 1, %t3
    %t5 = unary neg f80 INFINITYL
    %t6 = cmp eq f80 %t1, INFINITYL
    %t7 = convert trunc i32 i64 %t6
    %t8 = cmp eq f80 %t1, %t5
    %t9 = convert trunc i32 i64 %t8
    %t10 = binary or i32 %t7, %t9
    %t11 = binary sub i32 1, %t10
    %t12 = binary and i32 %t4, %t11
    return i32 %t12
}
function @infinite(%value : f80) -> i32 [binding=strong, object=_Z8infinitee] {
  slot $value : f80

  block ^entry:
    store typed f80 %value, $value
