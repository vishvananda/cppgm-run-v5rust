    %t7 = binary or i32 %t4, %t6
    %t8 = cmp ne f80 %t1, %t1
    %t9 = convert trunc i32 i64 %t8
    %t10 = binary sub i32 1, %t9
    %t11 = unary neg f80 INFINITYL
