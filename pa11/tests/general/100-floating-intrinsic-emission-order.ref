    %t4 = convert trunc i32 i64 %t3
    %t5 = cmp eq f80 %t1, %t2
    %t6 = convert trunc i32 i64 %t5
    %t7 = binary or i32 %t4, %t6
    return i32 %t7
}
function @normal(%value : f80) -> i32 [binding=strong, object=_Z6normale] {
  slot $value : f80

  block ^entry:
    store typed f80 %value, $value
    %t1 = load typed f80 $value
