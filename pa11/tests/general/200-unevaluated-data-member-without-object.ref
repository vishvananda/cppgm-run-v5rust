global @value : i32 [binding=strong] = 4

function @width() -> i32 [binding=strong, object=_Z5widthv] {
  block ^entry:
    %t1 = const i64 4
    %t2 = const i64 1
    %t3 = binary add i64 %t1, %t2
    %t4 = convert trunc i32 i64 %t3
    return i32 %t4
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = load typed i32 @value
    %t2 = cmp eq i32 %t1, 4
    branch %t2, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t3 = call i32 @width()
    %t4 = cmp eq i32 %t3, 5
    %t5 = cmp ne i64 %t4, 0
    store typed i64 %t5, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t6 = load typed i64 $land__2
    branch %t6, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t7 = load typed i32 $cond__1
    return i32 %t7
}
