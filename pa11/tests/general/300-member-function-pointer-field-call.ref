function @plus_one(%x : i32) -> i32 [binding=strong, object=_Z8plus_onei] {
  slot $x : i32

  block ^entry:
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    %t2 = binary add nowrap i32 %t1, 1
    return i32 %t2
}
function @call(%h : ptr [pass=by_address, object_bytes=8]) -> i32 [binding=strong, object=_Z4callRK5Hooks] {
  slot $h : ptr

  block ^entry:
    store typed ptr %h, $h
    %t1 = load typed ptr $h
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load typed ptr %t2
    %t4 = call i32 %t3(4) as (%arg0 : i32) -> i32
    return i32 %t4
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $h : obj<8x8>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $h
    %t2 = addr @plus_one
    %t3 = addr $h
    %t4 = index i8 [projection=field] %t3, 0
    store typed ptr %t2, %t4
    %t5 = addr $h
    %t6 = call i32 @call(%t5)
    %t7 = cmp eq i32 %t6, 5
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load typed i32 $cond__1
    return i32 %t8
}
