// N3485 3.6.2p2/14.7.1: a class template's thread_local static member used by
// two TUs is one object, initialized once per thread (shared guard, Itanium
// 2.8 _ZGV/_ZTW); expect exit 0
int count;
int counter() { return ++count; }
template<class T> struct X { static thread_local int n; };
template<class T> thread_local int X<T>::n = counter();
int other();
int main() { int a = X<int>::n; int b = other(); return a == 1 && b == 1 && count == 1 ? 0 : 1; }
