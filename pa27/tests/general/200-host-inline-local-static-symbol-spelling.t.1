#include "200-host-inline-local-static-symbol-spelling.helper.h"

int host_calls();

int main()
{
  // _ZZ7countervE5value, _ZZNK3Box4bumpEvE5calls and
  // _ZZZ19local_class_countervEN5Local4nextEvE1n: each static is shared with
  // the host-built unit, so its second use sees the first.
  const int local = counter() + Box().bump() + local_class_counter();
