namespace {

struct Primary
{
  virtual ~Primary() noexcept {}
  virtual int value() const noexcept { return 1; }
};

struct VirtualBase
{
  virtual ~VirtualBase() noexcept {}
};

struct Derived : Primary, virtual VirtualBase
{
  ~Derived() noexcept {}
  int value() const noexcept override { return 7; }
};

int through_primary(const Primary &value)
{
  return value.value();
}

}  // namespace

int main()
{
  Derived value;
  return through_primary(value) == 7 ? 0 : 1;
}
