__attribute__((noinline))
void fail(int a, int b, int c, int d, int e, int f, int g, int h, int i)
{
  if (a + b + c + d + e + f + g + h + i == 45)
    throw 7;
}

int main()
{
  try
  {
    fail(1, 2, 3, 4, 5, 6, 7, 8, 9);
  }
  catch (int value)
  {
    return value == 7 ? 0 : 1;
  }
  return 2;
}
