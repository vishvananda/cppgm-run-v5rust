declare function @first() -> u8 [binding=strong, object=_Z5firstv]
declare function @second() -> u8 [unwind=no, binding=strong, object=_Z6secondv]

function @evaluate() -> u8 [binding=strong, object=_Z8evaluatev] {
  slot $guard : obj<1x1>

  block ^entry:
    %t1 = addr $guard
    %t2 = call u8 @first()
    branch %t2, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t3 = call u8 @second()
    %t4 = cmp eq u8 %t3, 0
    branch %t4, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return u8 1

  block ^if_else_2:
    jump ^if_end_4

  block ^if_end_4:
    return u8 0
}
function @Guard___Guard(%this : ptr [object_bytes=1]) -> void [unwind=no, binding=weak, object=_ZN5GuardD1Ev, object_root=yes, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return void
}
alias object _ZN5GuardD2Ev = @Guard___Guard
