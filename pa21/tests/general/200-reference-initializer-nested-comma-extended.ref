    jump ^for_cond_5

  block ^for_end_8:
    jump ^for_iter_3

  block ^for_iter_3:
    %t82 = load typed i32 @selected
    %t83 = binary add nowrap i32 %t82, 1
    store typed i32 %t83, @selected
    jump ^for_cond_1

  block ^for_end_4:
    %t84 = load typed i32 @bad
    branch %t84, ^cond_then_37, ^cond_else_38

  block ^cond_then_37:
    store typed i32 10, $cond__4
    jump ^cond_end_39

  block ^cond_else_38:
    store typed i32 0, $cond__4
    jump ^cond_end_39

  block ^cond_end_39:
    %t85 = load typed i32 $cond__4
    return i32 %t85
}
