machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @sum8
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    param %g -> [rbp+<off0>] : i64
    param %h -> [rbp+<off1>] : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %g -> [rbp-<off0>] : i64
    param-slot %h -> [rbp-<off1>] : i64

  block ^entry
    load.i64 rax, [rbp+<off0>]
    store.i64 [rbp-<off0>], rax
    load.i64 rax, [rbp+<off1>]
    store.i64 [rbp-<off1>], rax
    add rdi, rsi
    add rdi, rdx
    add rdi, rcx
    add rdi, r8
    add rdi, r9
    add rdi, [rbp-<off0>]
    add rdi, [rbp-<off1>]
    ret rdi

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %r -> [rbp-<off0>] : i64

  block ^entry
    sub rsp, 16
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    mov <gpr0>, 7
    store.i64 [rsp], <gpr0>
    mov <gpr0>, 8
    store.i64 [rsp+<off0>], <gpr0>
    call @sum8 [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    store.i64 [rbp-<off0>], rax
    load.i64 r8, [rbp-<off0>]
    sub r8, 36
    ret r8
