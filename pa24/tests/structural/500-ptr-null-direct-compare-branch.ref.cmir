machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @g
    cmp.ptr r8, 0
    jne ^good
    jmp ^bad

  block ^bad
    mov rax, 1
    ret rax

  block ^good
    mov rax, 0
    ret rax
