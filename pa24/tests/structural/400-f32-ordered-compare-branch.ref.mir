machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fcmp.f32 1.0f, 2.0f
    ja ^wrong
    jmp ^right

  block ^wrong
    mov rax, 1
    ret rax

  block ^right
    mov rax, 0
    ret rax
