machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r9, 1
    mov rdi, 2
    mov r8, 0
    jmp ^loop

  block ^loop
    cmp.i64 r8, 1
    jge ^exit
    jmp ^latch

  block ^latch
    mov rsi, r8
    add rsi, 1
    mov r8, rsi
    mov <gpr0>, r9
    mov r9, rdi
    mov rdi, <gpr0>
    jmp ^loop

  block ^exit
    imul r9, 10
    add r9, rdi
    ret r9
