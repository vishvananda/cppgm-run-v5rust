machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @make_value
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tmp -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 7
    load.i64 rax, [rbp-8]
    ret

function @unwrap
  abi
    param %x -> rdi : obj<8x8>
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $x -> [rbp-8] : obj<8x8>
    param-slot %x -> [rbp-16] : obj<8x8>

  block ^entry
    store.i64 [rbp-16], rdi
    copy_bytes 8x8, [rbp-8], [rbp-16]
    load.i64 rax, [rbp-8]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %v -> [rbp-8] : obj<8x8>

  block ^entry
    call @make_value [args=()]
    store.i64 [rbp-8], rax
    load.i64 rdi, [rbp-8]
    call @unwrap [args=(rdi)]
    ret rax
