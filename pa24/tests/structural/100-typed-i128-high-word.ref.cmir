machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @wide
  storage scalar i128
  init i128 0x00000010000000000000000000000000

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %wide -> [rbp-<off0>] : i128

  block ^entry
    mov.i128 [rbp-<off0>], @wide
    set.ne.i128 rax, [rbp-<off0>], 0x00000010000000000000000000000000
    ret rax
