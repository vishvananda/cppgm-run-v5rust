machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fadd.f64 xmm0, 1.5, 2.25
    fcmp.f64 xmm0, 3.75
    jp ^bad
    je ^ok
    jmp ^bad

  block ^bad
    mov rax, 1
    ret rax

  block ^ok
    mov rax, 0
    ret rax
