machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage data
  item i64 47

function @read
  abi
    param %address -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rdi]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13

  block ^entry
    mov rdi, @value
    call @read [args=(rdi)]
    mov rbx, rax
    mov r12, @value
    mov rdi, r12
    call @read [args=(rdi)]
    mov r13, rax
    mov rdi, r12
    call @read [args=(rdi)]
    add rbx, r13
    add rbx, rax
    ret rbx
