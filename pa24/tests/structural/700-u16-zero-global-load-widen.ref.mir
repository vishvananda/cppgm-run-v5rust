machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar u16
  init u16 65535

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.u16 r8, @g
    cmp.i64 r8, 65535
    sete r8
    movzx r8, r8
    ret r8
