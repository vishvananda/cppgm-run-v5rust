machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov <gpr0>, 7
    sitofp.u32.f64 xmm0, <gpr0>
    fptosi.f64.u32 r8, xmm0
    zext.i32 r8
    cmp.u32 r8, 7
    je ^ok
    jmp ^bad

  block ^bad
    mov rax, 1
    ret rax

  block ^ok
    mov rax, 0
    ret rax
