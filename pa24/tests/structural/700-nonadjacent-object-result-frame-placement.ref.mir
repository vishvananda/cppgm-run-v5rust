machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @result
  storage data
  item i64 0
  item i64 0

function @make_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], 17
    store.i64 [rbp-8], 23
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @forward_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $result -> [rbp-16] : obj<16x8>
    temp %value -> [rbp-32] : obj<16x8>

  block ^entry
    call @make_pair [args=()]
    store.i64 [rbp-32], rax
    store.i64 [rbp-24], rdx
    copy_bytes 16x8, [rbp-16], [rbp-32]
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %value -> [rbp-16] : obj<16x8>

  block ^entry
    call @forward_pair [args=()]
    store.i64 [rbp-16], rax
    store.i64 [rbp-8], rdx
    copy_bytes 16x8, @result, [rbp-16]
    load.i64 r8, @result
    load.i64 r9, @result+8
    mov rdx, 17
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rdx, 23
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    or r8, r9
    sext.i32 r8
    ret r8
