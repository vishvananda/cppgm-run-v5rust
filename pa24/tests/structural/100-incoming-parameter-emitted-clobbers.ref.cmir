machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 0
  item i64 0
  item i64 0

global @source
  storage scalar i64
  init i64 99

function @write_fields
  abi
    param %base -> rdi : ptr
    param %first -> rsi : ptr
    param %number -> rdx : i64
    param %last -> rcx : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.ptr [rdi], rsi
    store.i64 [rdi+<off0>], rdx
    store.ptr [rdi+<off1>], rcx
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve <gpr0>

  block ^entry
    mov <gpr0>, @cells
    mov rsi, @source
    mov rdi, <gpr0>
    mov rdx, 17
    mov rcx, rsi
    call @write_fields [args=(rcx,rdx,rsi,rdi)]
    load.ptr <gpr0>, [<gpr0>+<off0>]
    mov rdx, 99
    cmp.i64 [<gpr0>], rdx
    setne rax
    movzx rax, rax
    ret rax
