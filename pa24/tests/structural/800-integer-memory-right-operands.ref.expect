# budget from 800-integer-memory-right-operands.ref.mir: the course solution's count, widened by 100% and rounded up, plus one, and at least three more than the count
instructions <= 351
blocks <= 25
count(call) <= 23
mem <= 83
instructions <= 5 in @add_global
stack_size <= 320 in @add_global
instructions <= 9 in @sub_frame
stack_size <= 352 in @sub_frame
instructions <= 5 in @and_dereference
stack_size <= 320 in @and_dereference
instructions <= 5 in @or_indexed
stack_size <= 320 in @or_indexed
instructions <= 5 in @xor_global
stack_size <= 320 in @xor_global
instructions <= 11 in @multiply_frame
stack_size <= 352 in @multiply_frame
instructions <= 9 in @compare_indexed
stack_size <= 320 in @compare_indexed
instructions <= 11 in @divide_dereference
stack_size <= 320 in @divide_dereference
instructions <= 11 in @shift_frame
stack_size <= 352 in @shift_frame
instructions <= 9 in @multiply_byte
stack_size <= 320 in @multiply_byte
instructions <= 9 in @add_byte_indexed
stack_size <= 320 in @add_byte_indexed
instructions <= 273 in @main
stack_size <= 512 in @main
