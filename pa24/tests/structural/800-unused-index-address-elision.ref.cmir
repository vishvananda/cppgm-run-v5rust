machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $byte -> [rbp-<off0>] : i8

  block ^entry
    mov rax, 0
    ret rax
