machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    jmp ^entry~join

  block ^entry~join
    mov r8, 7
    jmp ^join

  block ^side
    mov r8, 9
    jmp ^join

  block ^join
    mov r9, r8
    jmp ^loop

  block ^loop
    cmp.i64 r9, 12
    jge ^exit
    jmp ^latch

  block ^latch
    mov r8, r9
    add r8, 1
    mov r9, r8
    jmp ^loop

  block ^exit
    ret r9
