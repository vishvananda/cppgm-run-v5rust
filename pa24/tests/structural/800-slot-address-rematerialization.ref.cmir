machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @mark
  abi
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @sink
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], 1
    store.i64 [rsi], 2
    ret

function @f
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>
    slot $x -> [rbp-<off0>] : i64
    slot $y -> [rbp-<off1>] : i64

  block ^entry
    lea <gpr0>, [rbp-<off0>]
    lea <gpr1>, [rbp-<off1>]
    call @mark [args=()]
    mov rdi, <gpr0>
    mov rsi, <gpr1>
    call @sink [args=(rsi,rdi)]
    load.i64 r8, [rbp-<off0>]
    add r8, [rbp-<off1>]
    ret r8

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @f [args=()]
    ret rax
