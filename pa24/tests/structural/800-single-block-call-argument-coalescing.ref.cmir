machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage data
  item i64 47

function @read
  abi
    param %address -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rdi]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @value
    call @read [args=(rdi)]
    mov rdx, 47
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
