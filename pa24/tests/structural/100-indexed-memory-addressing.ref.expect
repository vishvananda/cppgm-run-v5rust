# budget from 100-indexed-memory-addressing.ref.mir: the course solution's count, widened by 100% and rounded up, plus one, and at least three more than the count
instructions <= 35
blocks <= 7
count(call) <= 5
mem <= 9
instructions <= 5 in @load_at
stack_size <= 320 in @load_at
instructions <= 5 in @store_at
stack_size <= 320 in @store_at
instructions <= 27 in @main
stack_size <= 352 in @main
