machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @shift_with_typed_count
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 3
    shl r8, 2
    sext.i32 r8
    ret r8

function @explicit_truncation
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 4294967297
    sext.i32 rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve <gpr0>

  block ^entry
    call @shift_with_typed_count [args=()]
    mov <gpr0>, rax
    sext.i32 <gpr0>
    call @explicit_truncation [args=()]
    sext.i32 rax
    mov rdx, 12
    cmp.i32 <gpr0>, rdx
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rdx, 1
    cmp.i32 rax, rdx
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    sext.i32 <gpr0>
    ret <gpr0>
