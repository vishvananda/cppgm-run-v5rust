machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @makef
  abi
    return f32 -> xmm0
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fmov.f32 xmm0, 1.5f
    ret xmm0

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    call @makef [args=()]
    fcmp.f32 xmm0, 1.5f
    jp ^wrong
    je ^right
    jmp ^wrong

  block ^wrong
    mov rax, 1
    ret rax

  block ^right
    mov rax, 0
    ret rax
