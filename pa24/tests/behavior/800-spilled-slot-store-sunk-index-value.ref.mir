machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @buffer
  storage data
  item i64 10
  item i64 20
  item i64 30
  item i64 40

global @which
  storage scalar i64
  init i64 2

function @touch
  abi
    param %scratch -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @run
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $scratch -> [rbp-40] : obj<40x8>

  block ^entry
    lea rdi, [rbp-40]
    call @touch [args=(rdi)]
    mov r8, @buffer
    load.i64 r9, @which
    lea rbx, [r8+r9*8]
    lea r8, [r8+16]
    cmp.ptr rbx, r8
    je ^check_value
    jmp ^bad

  block ^check_value
    mov rdx, 30
    cmp.i64 [rbx], rdx
    sete r8
    movzx r8, r8
    cmp.i64 r8, 0
    sete r8
    movzx r8, r8
    ret r8

  block ^bad
    mov rax, 1
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @run [args=()]
    ret rax
