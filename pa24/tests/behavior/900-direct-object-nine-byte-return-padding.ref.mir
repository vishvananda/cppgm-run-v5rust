machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @copied
  storage data
  item zero 9

function @make
  abi
    return obj<9x1> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-16] : obj<9x1>

  block ^entry
    zero_bytes 9x1, [rbp-16]
    store.i8 [rbp-16], 11
    store.i8 [rbp-8], 22
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %value -> [rbp-16] : obj<9x1>

  block ^entry
    call @make [args=()]
    store.i64 [rbp-16], rax
    store.i64 [rbp-8], rdx
    copy_bytes 9x1, @copied, [rbp-16]
    load.i8 r8, @copied
    load.i8 r9, @copied+8
    mov rdx, 11
    cmp.i8 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 22
    cmp.i8 r9, rdx
    sete r9
    movzx r9, r9
    and r8, r9
    cmp.i64 r8, 0
    sete r8
    movzx r8, r8
    ret r8
