machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @dirty_stack
  abi
    return void -> void
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $junk -> [rbp-64] : obj<64x8>

  block ^entry
    store.i64 [rbp-64], -1
    store.i64 [rbp-56], -1
    store.i64 [rbp-48], -1
    store.i64 [rbp-40], -1
    store.i64 [rbp-32], -1
    store.i64 [rbp-24], -1
    store.i64 [rbp-16], -1
    store.i64 [rbp-8], -1
    ret

function @side_effect
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @fold
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    param %c -> rdx : i32
    param %d -> rcx : i32
    param %e -> r8 : i32
    param %f -> r9 : i32
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    param-slot %f -> [rbp-8] : i32

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    mov r15, r8
    store.i32 [rbp-8], r9
    call @side_effect [args=()]
    sar rbx, 1
    mov r11, 2
    mov rax, r12
    cqo
    idiv r11
    mov r8, rax
    sext.i32 r8
    mov r11, 3
    mov rax, r13
    cqo
    idiv r11
    add rbx, r8
    sext.i32 rbx
    add rbx, rdx
    sext.i32 rbx
    add rbx, r14
    sext.i32 rbx
    add rbx, r15
    sext.i32 rbx
    add.i32 rbx, [rbp-8]
    sext.i32 rbx
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @dirty_stack [args=()]
    mov rdi, -8
    mov rsi, -8
    mov rdx, -7
    mov rcx, 1
    mov r8, 2
    mov r9, 3
    call @fold [args=(rcx,rdx,rsi,rdi,r8,r9)]
    mov r8, rax
    sext.i32 r8
    cmp.i32 r8, -3
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax
