machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cell
  storage data
  item i64 11

function @g
  abi
    param %a -> rdi : ptr
    param %b -> rsi : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], rsi
    ret rdi

function @f
  abi
    param %this -> rdi : ptr
    param %hash -> rsi : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @g [args=(rsi,rdi)]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @cell
    mov rdi, rbx
    mov rsi, 123
    call @f [args=(rsi,rdi)]
    mov r8, rax
    cmp.ptr r8, rbx
    jne ^bad_ptr
    jmp ^check_value

  block ^bad_ptr
    mov rax, 1
    ret rax

  block ^check_value
    cmp.i64 [rbx], 123
    setne rax
    movzx rax, rax
    ret rax
