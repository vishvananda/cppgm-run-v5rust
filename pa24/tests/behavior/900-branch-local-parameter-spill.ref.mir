machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @condition
  storage scalar i64
  init i64 0

global @expected
  storage scalar i64
  init i64 7

global @fields
  storage data
  item i64 0
  item i64 0
  item i64 0

global @late_result
  storage scalar i64
  init i64 0

global @late_source
  storage scalar i64
  init i64 13

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @probe
  abi
    param %condition -> rdi : ptr
    param %value -> rsi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rsi
    load.i64 rdi, [rdi]
    cmp.i64 rdi, 0
    jne ^pressure
    jmp ^merge

  block ^pressure
    call @noop [args=()]
    jmp ^merge

  block ^merge
    load.i64 rax, [rbx]
    ret rax

function @probe_temporary
  abi
    param %condition -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rdi, [rdi]
    cmp.i64 rdi, 0
    jne ^pressure
    jmp ^merge

  block ^pressure
    call @noop [args=()]
    jmp ^merge

  block ^merge
    mov rax, 7
    ret rax

function @probe_forwarded_alias
  abi
    param %base -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13

  block ^entry
    mov rbx, rdi
    store.i64 [rbx], 11
    lea r12, [rbx+8]
    store.i64 [r12], 22
    lea r13, [rbx+16]
    store.i64 [r13], 33
    call @noop [args=()]
    jmp ^check

  block ^check
    load.i64 rbx, [rbx]
    load.i64 r12, [r12]
    load.i64 r13, [r13]
    mov rdx, 11
    cmp.i64 rbx, rdx
    sete rbx
    movzx rbx, rbx
    mov rdx, 22
    cmp.i64 r12, rdx
    sete r12
    movzx r12, r12
    mov rdx, 33
    cmp.i64 r13, rdx
    sete r13
    movzx r13, r13
    and rbx, r12
    and rbx, r13
    ret rbx

function @clobber_first_argument
  abi
    param %value -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rdi]
    ret rax

function @write_after_call
  abi
    param %result -> rdi : ptr
    param %source -> rsi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rdi
    mov rdi, rsi
    call @clobber_first_argument [args=(rdi)]
    jmp ^write

  block ^write
    store.i64 [rbx], 77
    ret

function @dead_parameter_pressure
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    add rdi, rsi
    add rdx, rcx
    add rdi, rdx
    mov rbx, rdi
    add rbx, r8
    call @noop [args=()]
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 96
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15

  block ^entry
    mov rbx, @condition
    mov rsi, @expected
    mov rdi, rbx
    call @probe [args=(rsi,rdi)]
    mov r12, rax
    mov rdi, rbx
    call @probe_temporary [args=(rdi)]
    mov rbx, rax
    mov rdi, @fields
    call @probe_forwarded_alias [args=(rdi)]
    mov r13, rax
    mov r14, @late_result
    mov r15, @late_source
    mov rdi, r14
    mov rsi, r15
    call @write_after_call [args=(rsi,rdi)]
    load.i64 r14, [r14]
    load.i64 r15, [r15]
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @dead_parameter_pressure [args=(rcx,rdx,rsi,rdi,r8)]
    mov rdx, 7
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov rdx, 7
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 0
    cmp.i64 r13, rdx
    sete r13
    movzx r13, r13
    mov rdx, 77
    cmp.i64 r14, rdx
    setne r14
    movzx r14, r14
    mov rdx, 13
    cmp.i64 r15, rdx
    setne r15
    movzx r15, r15
    mov rdx, 15
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or r12, rbx
    or r12, r13
    or r14, r15
    or r12, r14
    or r12, rax
    sext.i32 r12
    ret r12
