machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 10
    add r8, 20
    add r8, 30
    add r8, 40
    mov rdx, 100
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    ret r8
