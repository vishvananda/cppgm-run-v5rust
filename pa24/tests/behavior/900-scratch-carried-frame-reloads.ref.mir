machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @v0
  storage scalar i64
  init i64 1

global @v1
  storage scalar i64
  init i64 2

global @v2
  storage scalar i64
  init i64 3

global @v3
  storage scalar i64
  init i64 4

global @v4
  storage scalar i64
  init i64 5

global @v5
  storage scalar i64
  init i64 6

global @v6
  storage scalar i64
  init i64 7

global @v7
  storage scalar i64
  init i64 8

global @v8
  storage scalar i64
  init i64 9

global @v9
  storage scalar i64
  init i64 10

global @v10
  storage scalar i64
  init i64 11

global @v11
  storage scalar i64
  init i64 12

global @v12
  storage scalar i64
  init i64 13

global @v13
  storage scalar i64
  init i64 14

global @v14
  storage scalar i64
  init i64 15

global @v15
  storage scalar i64
  init i64 16

function @sum_under_pressure
  abi
    return i64 -> rax
  frame
    stack_size 144
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %v12 -> [rbp-8] : i64
    temp %v13 -> [rbp-16] : i64
    temp %v14 -> [rbp-24] : i64
    temp %v15 -> [rbp-32] : i64
    temp %x0 -> [rbp-40] : i64
    temp %x1 -> [rbp-48] : i64
    temp %x2 -> [rbp-56] : i64
    temp %x3 -> [rbp-64] : i64
    temp %x4 -> [rbp-72] : i64
    temp %x5 -> [rbp-80] : i64
    temp %x6 -> [rbp-88] : i64
    temp %x7 -> [rbp-96] : i64

  block ^entry
    load.i64 r8, @v0
    load.i64 r9, @v1
    load.i64 rdi, @v2
    load.i64 rsi, @v3
    load.i64 rdx, @v4
    load.i64 rcx, @v5
    load.i64 rax, @v6
    load.i64 rbx, @v7
    load.i64 r12, @v8
    load.i64 r13, @v9
    load.i64 r14, @v10
    load.i64 r15, @v11
    load.i64 r10, @v12
    store.i64 [rbp-8], r10
    load.i64 r10, @v13
    store.i64 [rbp-16], r10
    load.i64 r10, @v14
    store.i64 [rbp-24], r10
    load.i64 r10, @v15
    store.i64 [rbp-32], r10
    mov r10, r8
    add r10, r9
    store.i64 [rbp-40], r10
    mov r10, rdi
    add r10, rsi
    store.i64 [rbp-48], r10
    mov r10, rdx
    add r10, rcx
    store.i64 [rbp-56], r10
    mov r10, rax
    add r10, rbx
    store.i64 [rbp-64], r10
    mov r10, r12
    add r10, r13
    store.i64 [rbp-72], r10
    mov r10, r14
    add r10, r15
    store.i64 [rbp-80], r10
    load.i64 r10, [rbp-8]
    add r10, [rbp-16]
    store.i64 [rbp-88], r10
    load.i64 r10, [rbp-24]
    add r10, [rbp-32]
    store.i64 [rbp-96], r10
    add r8, r9
    add rdi, rsi
    add rdx, rcx
    add rax, rbx
    add r12, r13
    add r14, r15
    load.i64 r9, [rbp-8]
    add r9, [rbp-16]
    load.i64 rsi, [rbp-24]
    add rsi, [rbp-32]
    add r8, rdi
    add rdx, rax
    add r12, r14
    add r9, rsi
    add r8, rdx
    add r12, r9
    add r8, r12
    load.i64 r9, [rbp-40]
    add r9, [rbp-48]
    load.i64 rdi, [rbp-56]
    add rdi, [rbp-64]
    load.i64 rsi, [rbp-72]
    add rsi, [rbp-80]
    load.i64 rdx, [rbp-88]
    add rdx, [rbp-96]
    add r9, rdi
    add rsi, rdx
    add r9, rsi
    add r8, r9
    ret r8

function @sum_under_float_pressure
  abi
    return i64 -> rax
  frame
    stack_size 224
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %v12 -> [rbp-8] : i64
    temp %v13 -> [rbp-16] : i64
    temp %v14 -> [rbp-24] : i64
    temp %v15 -> [rbp-32] : i64
    temp %x0 -> [rbp-40] : i64
    temp %x1 -> [rbp-48] : i64
    temp %x2 -> [rbp-56] : i64
    temp %x3 -> [rbp-64] : i64
    temp %x4 -> [rbp-72] : i64
    temp %x5 -> [rbp-80] : i64
    temp %x6 -> [rbp-88] : i64
    temp %x7 -> [rbp-96] : i64
    temp %x8 -> [rbp-104] : i64
    temp %x10 -> [rbp-112] : i64
    temp %x11 -> [rbp-120] : i64

  block ^entry
    load.i64 r8, @v0
    load.i64 r9, @v1
    load.i64 rdi, @v2
    load.i64 rsi, @v3
    load.i64 rdx, @v4
    load.i64 rcx, @v5
    load.i64 rax, @v6
    load.i64 rbx, @v7
    load.i64 r12, @v8
    load.i64 r13, @v9
    load.i64 r14, @v10
    load.i64 r15, @v11
    load.i64 r10, @v12
    store.i64 [rbp-8], r10
    load.i64 r10, @v13
    store.i64 [rbp-16], r10
    load.i64 r10, @v14
    store.i64 [rbp-24], r10
    load.i64 r10, @v15
    store.i64 [rbp-32], r10
    mov r10, r8
    add r10, r9
    store.i64 [rbp-40], r10
    mov r10, rdi
    add r10, rsi
    store.i64 [rbp-48], r10
    mov r10, rdx
    add r10, rcx
    store.i64 [rbp-56], r10
    mov r10, rax
    add r10, rbx
    store.i64 [rbp-64], r10
    mov r10, r12
    add r10, r13
    store.i64 [rbp-72], r10
    mov r10, r14
    add r10, r15
    store.i64 [rbp-80], r10
    load.i64 r10, [rbp-8]
    add r10, [rbp-16]
    store.i64 [rbp-88], r10
    load.i64 r10, [rbp-24]
    add r10, [rbp-32]
    store.i64 [rbp-96], r10
    load.i64 r10, [rbp-40]
    add r10, [rbp-48]
    store.i64 [rbp-104], r10
    load.i64 r10, [rbp-72]
    add r10, [rbp-80]
    store.i64 [rbp-112], r10
    load.i64 r10, [rbp-88]
    add r10, [rbp-96]
    store.i64 [rbp-120], r10
    fadd.f64 xmm0, 1.5, 2.5
    add r8, r9
    add rdi, rsi
    add rdx, rcx
    add rax, rbx
    add r12, r13
    add r14, r15
    load.i64 r9, [rbp-8]
    add r9, [rbp-16]
    load.i64 rsi, [rbp-24]
    add rsi, [rbp-32]
    add r8, rdi
    add rdx, rax
    add r12, r14
    add r9, rsi
    add r8, rdx
    add r12, r9
    add r8, r12
    load.i64 r9, [rbp-56]
    add r9, [rbp-64]
    add r9, [rbp-104]
    load.i64 rdi, [rbp-112]
    add rdi, [rbp-120]
    add r9, rdi
    add r8, r9
    fne.f64 r9, xmm0, 4.0
    add r8, r9
    ret r8

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @sum_under_pressure [args=()]
    mov rbx, rax
    call @sum_under_float_pressure [args=()]
    mov rdx, 272
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 272
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or rbx, rax
    ret rbx
