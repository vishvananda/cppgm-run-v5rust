function @smod3
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 3
    mov rax, rdi
    cqo
    idiv r11
    ret rdx

