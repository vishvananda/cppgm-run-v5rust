machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @sink
  storage scalar i64
  init i64 0

function @accept
  abi
    param %value -> rdi : u8
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.u8 rdi, 2
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax

function @get_record
  abi
    param %one -> rdi : i64
    param %two -> rsi : i64
    param %three -> rdx : i64
    param %four -> rcx : i64
    param %five -> r8 : i64
    param %record -> r9 : ptr
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret r9

function @reduced
  abi
    param %record -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, rdi
    mov rdi, 1
    call @get_record [args=(rcx,rdx,rsi,rdi,r8,r9), unwind=no]
    mov r8, rax
    eh_push ^unwind, 0
    load.u8 rdi, [r8+8]
    mov r8, 20
    add r8, 22
    store.i64 @sink, r8
    call @accept [args=(rdi)]
    sext.i32 rax
    eh_pop
    ret rax

  block ^unwind
    resume

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $record -> [rbp-16] : obj<16x8>

  block ^entry
    lea rdi, [rbp-16]
    store.u8 [rdi+8], 2
    call @reduced [args=(rdi)]
    sext.i32 rax
    ret rax
