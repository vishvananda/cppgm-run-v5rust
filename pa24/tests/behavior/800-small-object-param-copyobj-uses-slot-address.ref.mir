machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @copied
  storage data
  item i64 0

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @make_tag
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tmp -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 77
    load.i64 rax, [rbp-8]
    ret

function @copy_after_call
  abi
    param %tag -> rdi : obj<8x8>
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %tag -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], rdi
    call @touch [args=()]
    copy_bytes 8x8, @copied, [rbp-8]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    temp %tag -> [rbp-8] : obj<8x8>

  block ^entry
    call @make_tag [args=()]
    store.i64 [rbp-8], rax
    load.i64 rdi, [rbp-8]
    call @copy_after_call [args=(rdi)]
    mov rdx, 77
    cmp.i64 @copied, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
