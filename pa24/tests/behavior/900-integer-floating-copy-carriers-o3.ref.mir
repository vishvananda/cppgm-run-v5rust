machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @raw32
  abi
    param %bits -> rdi : i32
    return f32 -> xmm0
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmov.f32 xmm0, rdi
    ret xmm0

function @raw64
  abi
    param %bits -> rdi : i64
    return f64 -> xmm0
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmov.f64 xmm0, rdi
    ret xmm0

function @main
  abi
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated
    temp %a -> [rbp-8] : f32

  block ^entry
    mov rdi, 1065353216
    call @raw32 [args=(rdi)]
    fmov.f32 xmm14, xmm0
    fmov.f32 [rbp-8], xmm14
    mov rdi, 4607182418800017408
    call @raw64 [args=(rdi)]
    mov r10, 4611686018427387904
    fmov.f64 xmm1, r10
    fne.f32 r8, [rbp-8], 1.0f
    fne.f64 r9, xmm0, 1.0
    fne.f64 rdi, xmm1, 2.0
    or r8, r9
    or r8, rdi
    ret r8
