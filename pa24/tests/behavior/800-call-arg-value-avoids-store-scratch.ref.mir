machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @good
  storage scalar i64
  init i64 42

global @sink
  storage scalar i64
  init i64 0

global @object
  storage data
  item i64 0
  item i64 0

function @read_first
  abi
    param %p -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rdi]
    ret rax

function @run
  abi
    param %p -> rdi : ptr
    param %q -> rsi : i64
    param %r -> rdx : i64
    param %s -> rcx : i64
    param %t -> r8 : i64
    param %u -> r9 : i64
    param %v -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rdi
    jmp ^call

  block ^call
    store.i64 @sink, 5
    store.i64 @object+8, 123456789
    mov rdi, rbx
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    call @read_first [args=(rcx,rdx,rsi,rdi)]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @good
    sub rsp, 16
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, 4
    mov r9, 5
    mov r11, 6
    store.i64 [rsp], r11
    call @run [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    mov rdx, 42
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    mov rdx, 5
    cmp.i64 @sink, rdx
    sete r8
    movzx r8, r8
    mov rdx, 123456789
    cmp.i64 @object+8, rdx
    sete r9
    movzx r9, r9
    and rax, r8
    and rax, r9
    mov rdx, 0
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    ret rax
