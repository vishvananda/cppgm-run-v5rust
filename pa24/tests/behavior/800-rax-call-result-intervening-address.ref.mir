machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage scalar i64
  init i64 11

function @produce
  abi
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, @value
    ret rax

function @read
  abi
    param %address -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rdi]
    ret rax

function @exercise
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    slot $other -> [rbp-8] : i64
    temp %saved -> [rbp-16] : ptr
    temp %other_address -> [rbp-24] : ptr
    temp %first -> [rbp-32] : i64
    temp %second -> [rbp-40] : i64
    temp %third -> [rbp-48] : i64

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    mov r15, r8
    store.i64 [rbp-8], 22
    call @produce [args=()]
    mov r10, rax
    store.ptr [rbp-16], r10
    lea r10, [rbp-8]
    store.ptr [rbp-24], r10
    load.ptr rdi, [rbp-16]
    call @read [args=(rdi)]
    mov r10, rax
    store.i64 [rbp-32], r10
    load.ptr rdi, [rbp-24]
    call @read [args=(rdi)]
    mov r10, rax
    store.i64 [rbp-40], r10
    load.ptr rdi, [rbp-16]
    call @read [args=(rdi)]
    mov r10, rax
    store.i64 [rbp-48], r10
    load.ptr rdi, [rbp-24]
    call @read [args=(rdi)]
    add rbx, r12
    add rbx, r13
    add rbx, r14
    add rbx, r15
    load.i64 r8, [rbp-32]
    add r8, [rbp-40]
    add r8, [rbp-48]
    add r8, rax
    add r8, rbx
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @exercise [args=(rcx,rdx,rsi,rdi,r8)]
    mov rdx, 81
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
