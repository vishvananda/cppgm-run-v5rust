machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @state
  storage scalar i64
  init i64 0

global @trash
  storage scalar i64
  init i64 0

function @sink
  abi
    param %value -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @write_and_clobber
  abi
    param %output -> rdi : ptr
    param %value -> rsi : i64
    param %other -> rdx : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], rsi
    mov rdi, rdx
    call @sink [args=(rdi)]
    ret

function @loop_store
  abi
    param %output -> rdi : ptr
    param %other -> rsi : ptr
    param %limit -> rdx : i64
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14
    slot $iteration -> [rbp-8] : i64

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    store.i64 [rbp-8], 0
    jmp ^condition

  block ^condition
    load.i64 r14, [rbp-8]
    cmp.i64 r14, r13
    jb ^body
    jmp ^done

  block ^body
    mov rdi, rbx
    mov rsi, r14
    mov rdx, r12
    call @write_and_clobber [args=(rdx,rsi,rdi)]
    mov r8, r14
    add r8, 1
    store.i64 [rbp-8], r8
    jmp ^condition

  block ^done
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov rbx, @state
    mov r12, @trash
    mov rdi, rbx
    mov rsi, r12
    mov rdx, 2
    call @loop_store [args=(rdx,rsi,rdi)]
    load.i64 rbx, [rbx]
    load.i64 r12, [r12]
    mov rdx, 1
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 0
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    or rbx, r12
    sext.i32 rbx
    ret rbx
