machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @calc
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, 0
    mov r8, rdi
    add r8, 2
    add r8, rdi
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 10
    call @calc [args=(rdi)]
    mov rdx, 22
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    mov rdx, 0
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    ret rax
