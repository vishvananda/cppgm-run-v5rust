machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @source
  storage data
  item i64 11
  item i64 22
  item i64 33
  item i64 44

global @dest
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

global @good
  storage scalar i64
  init i64 0

function @mark
  abi
    param %target -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], 99
    ret

function @copy_then_mark
  abi
    param %target -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    copy_bytes 24x8, @dest, @source
    call @mark [args=(rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @good
    call @copy_then_mark [args=(rdi)]
    load.i64 r8, @good
    load.i64 r9, @dest
    load.i64 rdi, @dest+8
    load.i64 rsi, @dest+16
    load.i64 rcx, @dest+24
    mov rdx, 99
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 11
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 22
    cmp.i64 rdi, rdx
    sete rdi
    movzx rdi, rdi
    mov rdx, 33
    cmp.i64 rsi, rdx
    sete rsi
    movzx rsi, rsi
    mov rdx, 0
    cmp.i64 rcx, rdx
    sete rcx
    movzx rcx, rcx
    and r8, r9
    and rdi, rsi
    and r8, rdi
    and r8, rcx
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
