machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @byte
  storage scalar u8
  init u8 42

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @source
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @pressure
  abi
    param %high -> rdi : i64
    param %enter -> rsi : i64
    param %offset -> rdx : i64
    param %a -> rcx : i64
    param %b -> r8 : i64
    param %c -> r9 : i64
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %sib_bc -> [rbp-8] : i64
    temp %q6 -> [rbp-16] : i64
    temp %q7 -> [rbp-24] : i64
    temp %q8 -> [rbp-32] : i64

  block ^entry
    mov rbx, rdx
    mov r13, rcx
    mov r12, r8
    mov r14, r9
    cmp.i64 rdi, 0
    jne ^high_pressure
    jmp ^select

  block ^select
    cmp.i64 rsi, 0
    jne ^compute
    jmp ^sibling_setup

  block ^sibling_setup
    mov r15, r13
    add r15, r12
    mov r8, r12
    add r8, r14
    store.i64 [rbp-8], r8
    jmp ^sibling_use

  block ^compute
    mov r15, @byte
    add rbx, 0
    call @touch [args=()]
    load.i8 r15, [r15+rbx]
    zext.i8 r15
    add r13, r12
    add r13, r14
    add r15, r13
    ret r15

  block ^sibling_use
    add r15, r13
    add r14, [rbp-8]
    add r15, r14
    ret r15

  block ^high_pressure
    mov rdi, 1
    call @source [args=(rdi)]
    mov rbx, rax
    mov rdi, 2
    call @source [args=(rdi)]
    mov r12, rax
    mov rdi, 3
    call @source [args=(rdi)]
    mov r13, rax
    mov rdi, 4
    call @source [args=(rdi)]
    mov r14, rax
    mov rdi, 5
    call @source [args=(rdi)]
    mov r15, rax
    mov rdi, 6
    call @source [args=(rdi)]
    mov r10, rax
    store.i64 [rbp-16], r10
    mov rdi, 7
    call @source [args=(rdi)]
    mov r10, rax
    store.i64 [rbp-24], r10
    mov rdi, 8
    call @source [args=(rdi)]
    mov r10, rax
    store.i64 [rbp-32], r10
    call @touch [args=()]
    add rbx, r12
    add r13, r14
    add r15, [rbp-16]
    load.i64 r8, [rbp-24]
    add r8, [rbp-32]
    add rbx, r13
    add r15, r8
    add rbx, r15
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 0
    mov rsi, 1
    mov rdx, 0
    mov rcx, 1
    mov r8, 2
    mov r9, 3
    call @pressure [args=(rcx,rdx,rsi,rdi,r8,r9)]
    mov rdx, 48
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
