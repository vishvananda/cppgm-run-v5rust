machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @record
  storage data
  item zero 41

function @identity
  abi
    param %record -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @record
    call @identity [args=(rdi)]
    store.u8 [rax+40], 1
    mov rax, 0
    ret rax
