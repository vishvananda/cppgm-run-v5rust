machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @sink
  abi
    param %v -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @run
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    param %g -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $cell -> [rbp-8] : i64

  block ^entry
    store.i64 [rbp-8], 42
    load.i64 rdi, [rbp-8]
    call @sink [args=(rdi)]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    sub rsp, 16
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    mov r11, 7
    store.i64 [rsp], r11
    call @run [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    mov rdx, 42
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    mov rdx, 0
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    ret rax
