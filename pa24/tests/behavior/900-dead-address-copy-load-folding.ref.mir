machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 17
  item i64 25

function @identity
  abi
    param %address -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @values+8
    call @identity [args=(rdi)]
    load.i64 rax, [rax]
    add rax, @values
    mov rdx, 42
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
