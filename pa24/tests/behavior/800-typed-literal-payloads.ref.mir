machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @single
  storage scalar f32
  init f32 1.0000001f

global @double
  storage scalar f64
  init f64 1.0000000000000002

global @extended
  storage scalar f80
  init f80 1.0000000000000000001L

global @wide
  storage scalar i128
  init i128 -1

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    temp %extended -> [rbp-16] : f80
    temp %wide -> [rbp-32] : i128

  block ^entry
    fmov.f32 xmm0, @single
    fne.f32 r8, xmm0, 1.0000001f
    fmov.f64 xmm0, @double
    fne.f64 r9, xmm0, 1.0000000000000002
    fmov.f80 [rbp-16], @extended
    fne.f80 rdi, [rbp-16], 1.0000000000000000001L
    mov.i128 [rbp-32], @wide
    set.ne.i128 rsi, [rbp-32], -1
    or r8, r9
    or rdi, rsi
    or r8, rdi
    sext.i32 r8
    ret r8
