machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pressure
  abi
    param %width -> rdi : u32
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    param %gate -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    slot $selected -> [rbp-8] : i64
    param-slot %gate -> [rbp-16] : i64

  block ^entry
    load.i64 rax, [rbp+16]
    store.i64 [rbp-16], rax
    mov rbx, rcx
    cmp.i64 [rbp-16], 0
    jne ^convert
    jmp ^short

  block ^convert
    mov r12, rsi
    add r12, 0
    mov rcx, rdi
    mov rax, 1
    shl rax, rcx
    store.i64 [rbp-8], rax
    jmp ^merge

  block ^short
    store.i64 [rbp-8], 0
    jmp ^merge

  block ^merge
    load.i64 rcx, [rbp-8]
    add rsi, rdx
    add rbx, r8
    add rsi, rbx
    add r9, r12
    add rsi, r9
    add rsi, rdi
    add rsi, rcx
    ret rsi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    sub rsp, 16
    mov rdi, 6
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    mov r11, 1
    store.i64 [rsp], r11
    call @pressure [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    mov rdx, 92
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
