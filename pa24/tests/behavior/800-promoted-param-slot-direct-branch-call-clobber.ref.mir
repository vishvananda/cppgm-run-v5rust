machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret r8

function @size
  abi
    param %this -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 10
    mov rsi, 20
    mov rdx, 30
    mov rcx, 40
    mov r8, 12345
    mov r9, 60
    call @clobber [args=(rcx,rdx,rsi,rdi,r8,r9)]
    mov rax, 1
    ret rax

function @check
  abi
    param %this -> rdi : ptr
    param %index -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rsi
    call @size [args=(rdi)]
    mov r8, rax
    cmp.i64 rbx, r8
    jae ^bad
    jmp ^good

  block ^bad
    mov rax, 3
    ret rax

  block ^good
    mov rax, 0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 0
    mov rsi, 0
    call @check [args=(rsi,rdi)]
    ret rax
