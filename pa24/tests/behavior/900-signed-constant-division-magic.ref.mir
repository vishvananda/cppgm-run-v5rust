    mov rax, rdi
    cqo
    idiv r11
    sext.i8 rax
    ret rax

function @div_narrow_negative3
  abi
    param %value -> rdi : i8
    return i8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
