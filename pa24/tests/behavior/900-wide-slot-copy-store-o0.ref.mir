machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @copy_wide
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i128 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $source -> [rbp-16] : i128
    param-slot %value -> [rbp-32] : i128
    temp %copy -> [rbp-48] : i128

  block ^entry
    store.i64 [rbp-32], rdi
    store.i64 [rbp-24], rsi
    mov.i128 [rbp-16], [rbp-32]
    mov.i128 [rbp-48], [rbp-16]
    load.i64 rax, [rbp-48]
    load.i64 rdx, [rbp-40]
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 208
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $wide_source -> [rbp-16] : i128
    slot $wide_target -> [rbp-32] : i128
    slot $float_source -> [rbp-48] : f80
    slot $float_target -> [rbp-64] : f80
    slot $object_source -> [rbp-72] : obj<8x8>
    slot $object_target -> [rbp-80] : obj<8x8>
    temp %wide -> [rbp-96] : i128
    temp %wide_again -> [rbp-112] : i128
    temp %float -> [rbp-128] : f80
    temp %float_again -> [rbp-144] : f80
    temp %object -> [rbp-152] : obj<8x8>

  block ^entry
    mov.i128 [rbp-16], 0x00000000000000010000000000000029
    mov rdi, 41
    mov rsi, 1
    call @copy_wide [args=(rsi,rdi)]
    store.i64 [rbp-96], rax
    store.i64 [rbp-88], rdx
    mov.i128 [rbp-32], [rbp-16]
    mov.i128 [rbp-112], [rbp-32]
    set.ne.i128 r8, [rbp-96], 0x00000000000000010000000000000029
    set.ne.i128 r9, [rbp-112], 0x00000000000000010000000000000029
    fmov.f80 [rbp-48], 41.0L
    fmov.f80 [rbp-128], [rbp-48]
    fmov.f80 [rbp-64], [rbp-48]
    fmov.f80 [rbp-144], [rbp-64]
    fne.f80 rdi, [rbp-128], 41.0L
    fne.f80 rsi, [rbp-144], 41.0L
    store.i64 [rbp-72], 73
    copy_bytes 8x8, [rbp-152], [rbp-72]
    copy_bytes 8x8, [rbp-80], [rbp-152]
    mov rdx, 73
    cmp.i64 [rbp-80], rdx
    setne rcx
    movzx rcx, rcx
    store.i64 [rbp-72], 97
    copy_bytes 8x8, [rbp-80], [rbp-72]
    mov rdx, 97
    cmp.i64 [rbp-80], rdx
    setne rdx
    movzx rdx, rdx
    or r8, r9
    or rdi, rsi
    or rcx, rdx
    or r8, rdi
    or r8, rcx
    ret r8
