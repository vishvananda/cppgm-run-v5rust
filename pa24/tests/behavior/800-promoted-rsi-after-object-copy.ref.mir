machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @observed
  storage scalar i64
  init i64 0

function @observe
  abi
    param %ignored -> rdi : ptr
    param %value -> rsi : i64
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 @observed, rsi
    ret

function @copy_then_use
  abi
    param %source -> rdi : ptr
    param %value -> rsi : i64
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $copy -> [rbp-16] : obj<16x8>

  block ^entry
    lea r8, [rbp-16]
    copy_bytes 16x8, r8, rdi
    mov rdi, r8
    call @observe [args=(rsi,rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $source -> [rbp-16] : obj<16x8>

  block ^entry
    lea rdi, [rbp-16]
    mov rsi, 42
    call @copy_then_use [args=(rsi,rdi)]
    mov rdx, 42
    cmp.i64 @observed, rdx
    setne rax
    movzx rax, rax
    ret rax
