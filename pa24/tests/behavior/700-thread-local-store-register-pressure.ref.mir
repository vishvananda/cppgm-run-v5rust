machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g thread_local
  storage scalar i64
  init i64 0

function @f
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %x -> r9 : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, 1
    add rsi, 2
    add rdx, 3
    add rcx, 4
    add r8, 5
    add r9, 1
    store.i64 @g, r9
    add rdi, rsi
    add rdi, rdx
    add rdi, rcx
    add rdi, r8
    add rdi, r9
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @f [args=(rcx,rdx,rsi,rdi,r8,r9)]
    sext.i32 rax
    ret rax
