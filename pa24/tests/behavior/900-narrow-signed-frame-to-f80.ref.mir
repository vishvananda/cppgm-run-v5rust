machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx
    temp %floating -> [rbp-16] : f80

  block ^entry
    mov rbx, 218
    sext.i8 rbx
    jmp ^convert

  block ^detour
    call @noop [args=()]
    jmp ^convert

  block ^convert
    sitofp.i8.f80 [rbp-16], rbx
    fptosi.f80.i64 r8, [rbp-16]
    mov rdx, -38
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    ret r8
