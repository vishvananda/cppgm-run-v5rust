machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $backing -> [rbp-16] : obj<16x8>

  block ^entry
    lea rbx, [rbp-16]
    store.i64 [rbx], 1
    call @touch [args=()]
    cmp.ptr rbx, rbx
    sete rbx
    movzx rbx, rbx
    mov rdx, 0
    cmp.i64 rbx, rdx
    sete rbx
    movzx rbx, rbx
    ret rbx
