machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @observe
  abi
    param %ignored -> rdi : i64
    param %payload -> [rbp+16] : obj<112x8>
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rsi

function @forward
  abi
    param %ignored -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 112
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $payload -> [rbp-112] : obj<112x8>

  block ^entry
    mov r8, rdi
    mov r9, rsi
    sub rsp, 112
    copy_bytes 112x8, [rsp], [rbp-112]
    mov rdi, r8
    mov rsi, r9
    call @observe [args=(rsi,rdi), stack=112]
    add rsp, 112
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 0
    mov rsi, 42
    call @forward [args=(rsi,rdi)]
    mov rdx, 42
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
