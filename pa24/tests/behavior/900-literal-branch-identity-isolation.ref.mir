machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @zero
  storage scalar i64
  init i64 0

function @false_condition
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @one
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    call @false_condition [args=()]
    mov r8, rax
    cmp.i64 r8, 0
    jne ^wrong
    jmp ^continue

  block ^continue
    call @one [args=()]
    jmp ^correct

  block ^wrong
    mov rax, 1
    ret rax

  block ^correct
    mov rax, 0
    ret rax
