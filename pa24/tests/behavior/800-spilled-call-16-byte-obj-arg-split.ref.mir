machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @target
  abi
    param %pair -> rdi : i64
    param %pair -> rsi : i64
    param %io -> rdx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $pair -> [rbp-16] : obj<16x8>
    param-slot %pair -> [rbp-32] : obj<16x8>

  block ^entry
    store.i64 [rbp-32], rdi
    store.i64 [rbp-24], rsi
    copy_bytes 16x8, [rbp-16], [rbp-32]
    load.i64 r8, [rbp-16]
    add r8, [rbp-8]
    add r8, rdx
    ret r8

function @mid
  abi
    param %fp -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    param %e -> r9 : i64
    param %f -> [rbp+16] : i64
    param %g -> [rbp+24] : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $pair -> [rbp-16] : obj<16x8>

  block ^entry
    mov r8, rdi
    store.i64 [rbp-16], 1000
    store.i64 [rbp-8], 2000
    load.i64 rdi, [rbp-16]
    load.i64 rsi, [rbp-8]
    mov rdx, 111
    call *r8 [args=(rdx,rsi,rdi)]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @target
    sub rsp, 16
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, 4
    mov r9, 5
    mov r11, 6
    store.i64 [rsp], r11
    mov r11, 7
    store.i64 [rsp+8], r11
    call @mid [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    mov rdx, 3111
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    cmp.i64 rax, 0
    sete rax
    movzx rax, rax
    ret rax
