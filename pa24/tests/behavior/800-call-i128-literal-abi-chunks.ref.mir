machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @accept
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %value -> [rbp-16] : i128

  block ^entry
    store.i64 [rbp-16], rdi
    store.i64 [rbp-8], rsi
    set.eq.i128 r8, [rbp-16], 0
    cmp.i64 r8, 0
    sete r8
    movzx r8, r8
    ret r8

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 0
    mov rsi, 0
    call @accept [args=(rsi,rdi)]
    ret rax
