machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @single_observed
  storage scalar i64
  init i64 0

global @shared_observed
  storage scalar i64
  init i64 0

function @pressure
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 @single_observed, 11
    store.i64 @shared_observed, 13
    mov r9, rdi
    add r9, rsi
    mov rax, rdx
    add rax, rcx
    add rdi, r8
    add rsi, rdx
    add rcx, r8
    add r9, rax
    add rdi, rsi
    add r9, rdi
    add r9, rcx
    mov r8, 13
    add r8, 2
    load.i64 rdi, @single_observed
    load.i64 rsi, @shared_observed
    mov rdx, 100
    add rdx, 200
    add rdi, rsi
    add rdi, r8
    add rdx, rdi
    add rdx, r9
    ret rdx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @pressure [args=(rcx,rdx,rsi,rdi,r8)]
    mov rdx, 369
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
