machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @dispatch
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13
    slot $selector_word -> [rbp-8] : i64
    slot $poison_word -> [rbp-16] : i64
    temp %selector -> [rbp-24] : u32
    temp %all -> [rbp-32] : i64

  block ^entry
    store.i64 [rbp-8], 4294967335
    store.i64 [rbp-16], 1
    load.u32 rax, [rbp-16]
    load.u32 rbx, [rbp-8]
    store.u32 [rbp-24], rbx
    jmp ^dispatch

  block ^dispatch
    mov rbx, rdi
    add rbx, rsi
    mov r12, rdx
    add r12, rcx
    mov r13, r8
    add r13, r9
    add rbx, r12
    add rbx, r13
    store.i64 [rbp-32], rbx
    load.u32 r10, [rbp-24]
    cmp.u32 r10, 39
    je ^success
    cmp.u32 r10, rax
    je ^failure
    jmp ^retry

  block ^retry
    jmp ^dispatch

  block ^success
    load.i64 rax, [rbp-32]
    ret rax

  block ^failure
    mov rax, -1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @dispatch [args=(rcx,rdx,rsi,rdi,r8,r9)]
    mov rdx, 21
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
