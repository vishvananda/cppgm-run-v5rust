machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @select_local_address
  abi
    param %take_left -> rdi : i64
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-8] : obj<8x8>

  block ^entry
    lea r8, [rbp-8]
    zero_bytes 8x8, r8
    store.i64 [r8], 77
    cmp.i64 rdi, 0
    jne ^left
    jmp ^right

  block ^left
    mov r9, r8
    jmp ^join

  block ^right
    mov r9, r8
    jmp ^join

  block ^join
    load.i64 r9, [r9]
    sext.i32 r9
    ret r9

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rdi, 1
    call @select_local_address [args=(rdi)]
    mov rbx, rax
    sext.i32 rbx
    mov rdi, 0
    call @select_local_address [args=(rdi)]
    sext.i32 rax
    mov rdx, 77
    cmp.i32 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 77
    cmp.i32 rax, rdx
    setne rax
    movzx rax, rax
    or rbx, rax
    ret rbx
