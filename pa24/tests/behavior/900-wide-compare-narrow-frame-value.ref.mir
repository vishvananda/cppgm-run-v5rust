machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @check
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $attempt -> [rbp-8] : i64

  block ^entry
    store.i64 [rbp-8], 256
    jmp ^test

  block ^test
    mov r10, 0
    cmp.i64 r10, 0
    je ^good
    jmp ^retry

  block ^retry
    cmp.i64 [rbp-8], 256
    je ^again
    jmp ^bad

  block ^again
    store.i64 [rbp-8], 257
    jmp ^test

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    call @check [args=()]
    sext.i32 rax
    ret rax
