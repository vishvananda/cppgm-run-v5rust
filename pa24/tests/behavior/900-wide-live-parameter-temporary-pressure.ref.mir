machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @base_vtable
  storage data
  item zero 128

global @derived_vtable
  storage data
  item zero 128

function @token_ctor
  abi
    param %address -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.u8 [rdi], 99
    ret

function @construct
  abi
    param %this -> rdi : ptr
    param %reference -> rsi : ptr
    param %a -> rdx : i32
    param %b -> rcx : i32
    param %c -> r8 : i64
    param %d -> r9 : u8
    param %e -> [rbp+16] : u8
    param %f -> [rbp+24] : i32
    param %g -> [rbp+32] : i32
    param %h -> [rbp+40] : i64
    param %i -> [rbp+48] : i64
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %e -> [rbp-8] : u8
    param-slot %f -> [rbp-16] : i32
    param-slot %g -> [rbp-24] : i32
    param-slot %h -> [rbp-32] : i64
    param-slot %i -> [rbp-40] : i64

  block ^entry
    load.u8 rax, [rbp+16]
    store.u8 [rbp-8], rax
    load.i32 rax, [rbp+24]
    store.i32 [rbp-16], rax
    load.i32 rax, [rbp+32]
    store.i32 [rbp-24], rax
    load.i64 rax, [rbp+40]
    store.i64 [rbp-32], rax
    load.i64 rax, [rbp+48]
    store.i64 [rbp-40], rax
    mov rax, @base_vtable+16
    store.ptr [rdi], rax
    mov rax, @derived_vtable+16
    store.ptr [rdi], rax
    store.ptr [rdi+8], rsi
    store.i32 [rdi+16], rdx
    store.i32 [rdi+20], rcx
    store.i64 [rdi+24], r8
    store.u8 [rdi+32], r9
    load.u8 r11, [rbp-8]
    store.u8 [rdi+33], r11
    load.i32 r11, [rbp-16]
    store.i32 [rdi+36], r11
    load.i32 r11, [rbp-24]
    store.i32 [rdi+40], r11
    load.i64 r11, [rbp-32]
    store.i64 [rdi+48], r11
    load.i64 r11, [rbp-40]
    store.i64 [rdi+56], r11
    lea rdi, [rdi+72]
    call @token_ctor [args=(rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 176
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    slot $object -> [rbp-96] : obj<96x8>
    slot $reference -> [rbp-104] : i64

  block ^entry
    zero_bytes 96x8, [rbp-96]
    lea rbx, [rbp-96]
    lea r12, [rbp-104]
    sub rsp, 48
    mov rdi, rbx
    mov rsi, r12
    mov rdx, 11
    mov rcx, 12
    mov r8, 13
    mov r9, 14
    mov r11, 15
    store.u8 [rsp], r11
    mov r11, 16
    store.i32 [rsp+8], r11
    mov r11, 17
    store.i32 [rsp+16], r11
    mov r11, 18
    store.i64 [rsp+24], r11
    mov r11, 19
    store.i64 [rsp+32], r11
    call @construct [args=(rcx,rdx,rsi,rdi,r8,r9), stack=48]
    add rsp, 48
    load.ptr r8, [rbx]
    mov r9, @derived_vtable+16
    cmp.ptr r8, r9
    setne r8
    movzx r8, r8
    cmp.ptr [rbx+8], r12
    setne r12
    movzx r12, r12
    mov rdx, 11
    cmp.i32 [rbx+16], rdx
    setne r9
    movzx r9, r9
    mov rdx, 99
    cmp.u8 [rbx+72], rdx
    setne rdi
    movzx rdi, rdi
    or r8, r12
    or r9, rdi
    or r8, r9
    sext.i32 r8
    ret r8
