machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @good
  storage scalar i64
  init i64 7

global @bad
  storage scalar i64
  init i64 13

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %wrong -> r8 : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @return_saved
  abi
    param %target -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    param %e -> r9 : i64
    param %f -> [rbp+16] : i64
    param %g -> [rbp+24] : i64
    param %h -> [rbp+32] : i64
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rdi
    jmp ^after

  block ^after
    mov r8, @bad
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    call @clobber [args=(rcx,rdx,rsi,rdi,r8)]
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @good
    sub rsp, 32
    mov rdi, rbx
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, 4
    mov r9, 5
    mov r11, 6
    store.i64 [rsp], r11
    mov r11, 7
    store.i64 [rsp+8], r11
    mov r11, 8
    store.i64 [rsp+16], r11
    call @return_saved [args=(rcx,rdx,rsi,rdi,r8,r9), stack=32]
    add rsp, 32
    cmp.ptr rax, rbx
    sete rbx
    movzx rbx, rbx
    mov rdx, 7
    cmp.i64 [rax], rdx
    sete r8
    movzx r8, r8
    and rbx, r8
    mov rdx, 0
    cmp.i64 rbx, rdx
    sete rbx
    movzx rbx, rbx
    ret rbx
