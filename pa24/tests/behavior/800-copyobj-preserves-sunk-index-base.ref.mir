machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cell
  storage data
  item i64 0

global @source
  storage data
  item i64 11
  item i64 22
  item i64 33
  item i64 44

global @dest
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0

function @mark
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], 99
    ret

function @copy_then_mark_base
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    copy_bytes 24x8, @dest, @source
    call @mark [args=(rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @cell
    call @copy_then_mark_base [args=(rdi)]
    mov rdx, 99
    cmp.i64 @cell, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
