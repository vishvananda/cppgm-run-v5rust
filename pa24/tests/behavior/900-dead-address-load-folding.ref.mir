machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 17
  item i64 25

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 r8, @values+8
    add r8, @values
    mov rdx, 42
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    ret r8
