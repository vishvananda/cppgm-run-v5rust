machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @table
  storage data
  item i64 11
  item i64 22
  item i64 33

function @dirty_stack
  abi
    return void -> void
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $junk -> [rbp-64] : obj<64x8>

  block ^entry
    store.i64 [rbp-64], -1
    store.i64 [rbp-56], -1
    store.i64 [rbp-48], -1
    store.i64 [rbp-40], -1
    store.i64 [rbp-32], -1
    store.i64 [rbp-24], -1
    store.i64 [rbp-16], -1
    store.i64 [rbp-8], -1
    ret

function @side_effect
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @lookup
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    param %c -> rdx : i32
    param %d -> rcx : i32
    param %e -> r8 : i32
    param %level -> r9 : i32
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    param-slot %level -> [rbp-8] : i32

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    mov r15, r8
    store.i32 [rbp-8], r9
    call @side_effect [args=()]
    mov r8, @table
    load.i32 r10, [rbp-8]
    mov r9, r10
    imul r9, 8
    load.i64 r8, [r8+r9]
    imul rbx, 1
    imul r12, 1
    imul r13, 1
    imul r14, 1
    imul r15, 1
    add r8, rbx
    add r8, r12
    add r8, r13
    add r8, r14
    add r8, r15
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @dirty_stack [args=()]
    mov rdi, 2
    mov rsi, 3
    mov rdx, 4
    mov rcx, 5
    mov r8, 6
    mov r9, 1
    call @lookup [args=(rcx,rdx,rsi,rdi,r8,r9)]
    mov r8, rax
    cmp.i64 r8, 42
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax
