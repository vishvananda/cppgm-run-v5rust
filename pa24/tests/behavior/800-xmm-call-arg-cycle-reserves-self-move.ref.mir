machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @check
  abi
    param %a0 -> xmm0 : f32
    param %a1 -> xmm1 : f32
    param %a2 -> xmm2 : f32
    param %a3 -> xmm3 : f32
    param %a4 -> xmm4 : f32
    param %a5 -> xmm5 : f32
    param %a6 -> xmm6 : f32
    param %a7 -> xmm7 : f32
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    param-slot %a1 -> [rbp-8] : f32

  block ^entry
    fmov.f32 [rbp-8], xmm1
    fcmp.f32 [rbp-8], 2.0f
    jp ^fail
    je ^pass
    jmp ^fail

  block ^fail
    mov rax, 1
    ret rax

  block ^pass
    mov rax, 0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fmov.f32 xmm0, 3.0f
    fmov.f32 xmm1, 2.0f
    fmov.f32 xmm2, 5.0f
    fmov.f32 xmm3, 1.0f
    fmov.f32 xmm4, 7.0f
    fmov.f32 xmm5, 4.0f
    fmov.f32 xmm6, 6.0f
    fmov.f32 xmm7, 8.0f
    call @check [args=(xmm0,xmm1,xmm2,xmm3,xmm4,xmm5,xmm6,xmm7)]
    ret rax
