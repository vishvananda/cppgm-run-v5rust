machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @preserve_third
  abi
    param %first -> rdi : i64
    param %second -> rsi : i64
    param %third -> rdx : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %third_wide -> [rbp-16] : i128

  block ^entry
    sext.i128 [rbp-16], rdx
    load.i64 rax, [rbp-16]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 14
    call @preserve_third [args=(rdx,rsi,rdi)]
    mov rdx, 14
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
