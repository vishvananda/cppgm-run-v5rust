machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @pair
  storage data
  item i64 0
  item i64 0

function @store_dec
  abi
    param %p -> rdi : ptr
    param %dec -> rsi : i64
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], 99
    ret

function @call_field_with_later_arg
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $this -> [rbp-8] : ptr

  block ^entry
    store.ptr [rbp-8], rdi
    store.ptr [rbp-8], rdi
    load.ptr r8, [rbp-8]
    lea r8, [r8+8]
    mov rdi, r8
    mov rsi, -1
    call @store_dec [args=(rsi,rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @pair
    mov rdi, rbx
    call @call_field_with_later_arg [args=(rdi)]
    load.i64 r8, @pair
    load.i64 rbx, [rbx+8]
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 99
    cmp.i64 rbx, rdx
    sete rbx
    movzx rbx, rbx
    and r8, rbx
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
