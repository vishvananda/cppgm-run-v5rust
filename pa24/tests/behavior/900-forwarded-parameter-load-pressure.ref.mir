machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @first_value
  storage scalar i64
  init i64 11

global @second_value
  storage scalar i64
  init i64 13

global @third_value
  storage scalar i64
  init i64 17

global @observed
  storage scalar i64
  init i64 0

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @finish
  abi
    param %first -> rdi : ptr
    param %second -> rsi : ptr
    param %third -> rdx : ptr
    param %fourth -> rcx : i32
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rdi, [rdi]
    load.i64 rsi, [rsi]
    load.i64 rdx, [rdx]
    add rdi, rsi
    add rdi, rdx
    add rdi, rcx
    store.i64 @observed, rdi
    ret

function @reduced
  abi
    param %first -> rdi : ptr
    param %second -> rsi : ptr
    param %third -> rdx : ptr
    param %fourth -> rcx : i32
    return void -> void
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    call @touch [args=()]
    mov rdi, rbx
    mov rsi, r12
    mov rdx, r13
    mov rcx, r14
    call @finish [args=(rcx,rdx,rsi,rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @first_value
    mov rsi, @second_value
    mov rdx, @third_value
    mov rcx, 19
    call @reduced [args=(rcx,rdx,rsi,rdi)]
    mov rdx, 60
    cmp.i64 @observed, rdx
    setne rax
    movzx rax, rax
    ret rax
