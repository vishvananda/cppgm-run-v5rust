machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @read_fifth
  abi
    param %unused0 -> rdi : ptr
    param %unused1 -> rsi : i64
    param %unused2 -> rdx : i64
    param %unused3 -> rcx : i64
    param %value -> r8 : ptr
    param %unused5 -> r9 : i64
    param %unused6 -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $scratch1 -> [rbp-8] : i64
    slot $scratch2 -> [rbp-16] : i64

  block ^entry
    load.i64 rax, [r8]
    store.i64 [rbp-8], 11
    store.i64 [rbp-16], 22
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-8] : i64

  block ^entry
    lea rdi, [rbp-8]
    store.i64 [rdi], 77
    sub rsp, 16
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, rdi
    mov r9, 5
    mov r11, 6
    store.i64 [rsp], r11
    call @read_fifth [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    mov rdx, 77
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
