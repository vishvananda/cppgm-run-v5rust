machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $source -> [rbp-8] : obj<8x8>
    slot $destination -> [rbp-16] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 7
    copy_bytes 8x8, [rbp-16], [rbp-8]
    load.i64 r8, [rbp-8]
    mov r9, 10
    add r9, 20
    add r9, r8
    mov rdx, 37
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    ret r9
