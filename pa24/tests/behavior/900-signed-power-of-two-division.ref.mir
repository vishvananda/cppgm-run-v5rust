machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @div2
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 2
    mov rax, rdi
    cqo
    idiv r11
    ret rax

function @mod8
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 8
    mov rax, rdi
    cqo
    idiv r11
    ret rdx

