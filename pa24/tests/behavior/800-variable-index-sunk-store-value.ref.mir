machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @buffer
  storage data
  item i64 10
  item i64 20
  item i64 30
  item i64 40

global @which
  storage scalar i64
  init i64 2

global @saved
  storage scalar ptr
  init ptr 0

function @touch
  abi
    param %scratch -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @run
  abi
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $scratch -> [rbp-40] : obj<40x8>

  block ^entry
    lea rdi, [rbp-40]
    call @touch [args=(rdi)]
    mov r8, @buffer
    load.i64 r9, @which
    lea r8, [r8+r9*8]
    store.ptr @saved, r8
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    call @run [args=()]
    mov r8, @buffer+16
    load.ptr r9, @saved
    cmp.ptr r9, r8
    sete r8
    movzx r8, r8
    mov rdx, 30
    cmp.i64 [r9], rdx
    sete r9
    movzx r9, r9
    and r8, r9
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
