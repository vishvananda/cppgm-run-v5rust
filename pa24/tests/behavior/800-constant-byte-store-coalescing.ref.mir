machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @bytes
  storage data
  item zero 16

function @initialize
  abi
    param %base -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i8 [rdi], 1
    store.i8 [rdi+1], 35
    store.i8 [rdi+2], 69
    store.i8 [rdi+3], 103
    store.i8 [rdi+4], -119
    store.i8 [rdi+5], -85
    store.i8 [rdi+6], -51
    store.i8 [rdi+7], -17
    store.i8 [rdi+8], -2
    store.i8 [rdi+9], -36
    store.i8 [rdi+10], -70
    store.i8 [rdi+11], -104
    store.i8 [rdi+12], 118
    store.i8 [rdi+13], 84
    store.i8 [rdi+14], 50
    store.i8 [rdi+15], 16
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @bytes
    call @initialize [args=(rdi)]
    cmp.i64 @bytes, -1167088121787636991
    jne ^bad
    jmp ^second

  block ^second
    cmp.i64 @bytes+8, 1167088121787636990
    jne ^bad
    jmp ^ok

  block ^bad
    mov rax, 1
    ret rax

  block ^ok
    mov rax, 0
    ret rax
