machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @loop_value
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14
    slot $iteration -> [rbp-8] : i64
    slot $result -> [rbp-16] : i64
    param-slot %a -> [rbp-24] : i64
    param-slot %b -> [rbp-32] : i64
    param-slot %c -> [rbp-40] : i64
    param-slot %d -> [rbp-48] : i64
    param-slot %e -> [rbp-56] : i64

  block ^entry
    store.i64 [rbp-24], rdi
    store.i64 [rbp-32], rsi
    store.i64 [rbp-40], rdx
    store.i64 [rbp-48], rcx
    store.i64 [rbp-56], r8
    store.i64 [rbp-8], 0
    store.i64 [rbp-16], 0
    jmp ^loop_condition

  block ^loop_condition
    cmp.i64 [rbp-8], 1
    jl ^loop_body
    jmp ^loop_end

  block ^loop_body
    load.i64 rbx, [rbp-56]
    add rbx, 1
    load.i64 r12, [rbp-24]
    add r12, [rbp-32]
    load.i64 r13, [rbp-32]
    add r13, [rbp-40]
    load.i64 r14, [rbp-40]
    add r14, [rbp-48]
    call @touch [args=()]
    add r12, r13
    add r14, rbx
    add r12, r14
    add r12, [rbp-24]
    add r12, [rbp-32]
    add r12, [rbp-40]
    add r12, [rbp-48]
    store.i64 [rbp-16], r12
    load.i64 r8, [rbp-8]
    add r8, 1
    store.i64 [rbp-8], r8
    jmp ^loop_condition

  block ^loop_end
    load.i64 rax, [rbp-16]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @loop_value [args=(rcx,rdx,rsi,rdi,r8)]
    mov rdx, 31
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
