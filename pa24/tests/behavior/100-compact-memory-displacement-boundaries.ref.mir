machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @bytes
  storage data
  item zero 512

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i8 @bytes+127, 11
    store.i8 @bytes+128, 22
    store.i8 @bytes+255, 33
    store.i8 @bytes+256, 44
    store.i8 @bytes+257, 55
    store.i8 @bytes+383, 66
    store.i8 @bytes+384, 77
    mov rdx, 11
    cmp.i8 @bytes+127, rdx
    setne r8
    movzx r8, r8
    mov rdx, 22
    cmp.i8 @bytes+128, rdx
    setne r9
    movzx r9, r9
    or r8, r9
    mov rdx, 33
    cmp.i8 @bytes+255, rdx
    setne r9
    movzx r9, r9
    mov rdx, 44
    cmp.i8 @bytes+256, rdx
    setne rdi
    movzx rdi, rdi
    or r9, rdi
    mov rdx, 55
    cmp.i8 @bytes+257, rdx
    setne rdi
    movzx rdi, rdi
    mov rdx, 66
    cmp.i8 @bytes+383, rdx
    setne rsi
    movzx rsi, rsi
    or rdi, rsi
    mov rdx, 77
    cmp.i8 @bytes+384, rdx
    setne rsi
    movzx rsi, rsi
    or r8, r9
    or rdi, rsi
    or r8, rdi
    sext.i32 r8
    ret r8
