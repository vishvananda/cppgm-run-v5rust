machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, r8
    ret rdi

function @classify
  abi
    param %kind -> rdi : i32
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rdx, 1
    cmp.i32 rdi, rdx
    setne rbx
    movzx rbx, rbx
    cmp.i64 rbx, 0
    je ^named_path
    jmp ^merge

  block ^named_path
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @clobber [args=(rcx,rdx,rsi,rdi,r8)]
    jmp ^merge

  block ^merge
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    call @classify [args=(rdi)]
    mov rdi, 0
    call @classify [args=(rdi)]
    mov rdx, 1
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
