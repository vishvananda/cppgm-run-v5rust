machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 17
  item i64 0
  item i64 0

global @other
  storage data
  item i64 25

function @write_second
  abi
    param %base -> rdi : ptr
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi+8], rsi
    store.i64 [rdi+16], rsi
    load.i64 rax, @other
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @values
    mov rsi, 25
    call @write_second [args=(rsi,rdi)]
    load.i64 r8, @values+8
    load.i64 r9, @values+16
    mov rdx, 25
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rdx, 25
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdx, 25
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or r8, r9
    or r8, rax
    sext.i32 r8
    ret r8
