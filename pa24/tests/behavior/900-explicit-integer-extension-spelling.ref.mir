machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, -1
    zext.i8 r8
    mov rdx, 255
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, 255
    sext.i8 r9
    mov rdx, -1
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdi, -1
    zext.i16 rdi
    mov rdx, 65535
    cmp.i32 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rsi, 65535
    sext.i16 rsi
    mov rdx, -1
    cmp.i32 rsi, rdx
    setne rsi
    movzx rsi, rsi
    or r8, r9
    or rdi, rsi
    or r8, rdi
    sext.i32 r8
    ret r8
