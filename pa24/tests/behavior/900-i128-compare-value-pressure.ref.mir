machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @wide
  storage scalar i128
  init i128 1

global @g1
  storage scalar i64
  init i64 1

global @g2
  storage scalar i64
  init i64 2

global @g3
  storage scalar i64
  init i64 3

global @g4
  storage scalar i64
  init i64 4

global @g5
  storage scalar i64
  init i64 5

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @probe
  abi
    param %p1 -> rdi : ptr
    param %p2 -> rsi : ptr
    param %p3 -> rdx : ptr
    param %p4 -> rcx : ptr
    param %p5 -> r8 : ptr
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %wide -> [rbp-16] : i128
    temp %positive -> [rbp-24] : i64

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    mov r15, r8
    mov.i128 [rbp-16], @wide
    set.gt.i128 r10, [rbp-16], 0
    store.i64 [rbp-24], r10
    call @touch [args=()]
    load.i64 rbx, [rbx]
    load.i64 r12, [r12]
    load.i64 r13, [r13]
    load.i64 r14, [r14]
    load.i64 r15, [r15]
    add rbx, r12
    add rbx, r13
    add rbx, r14
    add rbx, r15
    add rbx, [rbp-24]
    ret rbx

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @g1
    mov rsi, @g2
    mov rdx, @g3
    mov rcx, @g4
    mov r8, @g5
    call @probe [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 16
    setne rax
    movzx rax, rax
    ret rax
