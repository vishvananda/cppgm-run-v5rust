machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @one
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 7
    ret rax

function @id
  abi
    param %a -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @one [args=()]
    mov rbx, rax
    mov rdi, 99
    call @id [args=(rdi)]
    cmp.i64 rbx, 7
    setne rbx
    movzx rbx, rbx
    ret rbx
