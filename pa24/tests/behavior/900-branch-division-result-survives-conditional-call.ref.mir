machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @choose
  abi
    param %value -> rdi : i64
    param %enter -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    cmp.i64 rsi, 0
    jne ^compute
    jmp ^sibling

  block ^compute
    mov r11, 1
    mov rax, rdi
    cqo
    idiv r11
    mov rbx, rax
    cmp.i64 rbx, 0
    jl ^call_path
    jmp ^merge

  block ^call_path
    call @touch [args=()]
    jmp ^merge

  block ^merge
    ret rbx

  block ^sibling
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, -9
    mov rsi, 1
    call @choose [args=(rsi,rdi)]
    mov rdi, 7
    mov rsi, 1
    call @choose [args=(rsi,rdi)]
    mov rdx, 7
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
