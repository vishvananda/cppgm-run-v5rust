machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @observed
  storage scalar u32
  init u32 0

function @sink
  abi
    param %ret -> rdi : ptr
    param %this -> rsi : ptr
    param %initializer -> rdx : u32
    param %scope -> rcx : u32
    param %type -> r8 : u32
    param %local -> r9 : u8
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.u32 @observed, r8
    ret

function @wide
  abi
    param %ret -> rdi : ptr
    param %this -> rsi : ptr
    param %initializer -> rdx : u32
    param %scope -> rcx : u32
    param %type -> r8 : u32
    param %local -> r9 : u8
    param %require -> [rbp+16] : u8
    param %preserve -> [rbp+24] : u8
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rsi+8]
    add rax, 1
    store.i64 [rsi+8], rax
    call @sink [args=(rcx,rdx,rsi,rdi,r8,r9)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $object -> [rbp-16] : obj<16x8>

  block ^entry
    lea rbx, [rbp-16]
    store.i64 [rbx+8], 0
    sub rsp, 16
    mov rdi, rbx
    mov rsi, rbx
    mov rdx, 1
    mov rcx, 2
    mov r8, 77
    mov r9, 0
    mov r11, 1
    store.u8 [rsp], r11
    mov r11, 1
    store.u8 [rsp+8], r11
    call @wide [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    mov rdx, 77
    cmp.u32 @observed, rdx
    setne r8
    movzx r8, r8
    mov rdx, 1
    cmp.i64 [rbx+8], rdx
    setne r9
    movzx r9, r9
    or r8, r9
    sext.i32 r8
    ret r8
