machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @a
  storage scalar i64
  init i64 0

global @b
  storage scalar i64
  init i64 0

function @target
  abi
    param %x -> rdi : ptr
    param %y -> rsi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @run
  abi
    param %p -> rdi : ptr
    param %q -> rsi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r10, rdi
    mov rdi, rsi
    mov rsi, r10
    call @target [args=(rsi,rdi)]
    mov rax, 7
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @a
    mov rsi, @b
    call @run [args=(rsi,rdi)]
    mov r10, 1234605616436508552
    mov rdx, 1234605616436508552
    cmp.i64 r10, rdx
    sete r8
    movzx r8, r8
    mov rdx, 7
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    and r8, rax
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
