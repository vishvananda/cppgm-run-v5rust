machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @result
  storage data
  item i64 0

global @other
  storage data
  item i64 25

function @produce
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 17
    ret rax

function @write
  abi
    param %base -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rdi
    call @produce [args=()]
    store.i64 [rbx], rax
    add rax, @other
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @result
    call @write [args=(rdi)]
    mov rdx, 17
    cmp.i64 @result, rdx
    setne r8
    movzx r8, r8
    mov rdx, 42
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or r8, rax
    sext.i32 r8
    ret r8
