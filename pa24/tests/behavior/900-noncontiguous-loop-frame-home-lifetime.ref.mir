machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @make_value
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @probe
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $outer -> [rbp-8] : i64
    slot $inner -> [rbp-16] : i64
    slot $total -> [rbp-24] : i64

  block ^entry
    mov rdi, 91
    call @make_value [args=(rdi)]
    mov rbx, rax
    store.i64 [rbp-8], 2
    store.i64 [rbp-24], 0
    jmp ^outer_cond

  block ^outer_cond
    load.i64 r8, [rbp-8]
    mov r9, r8
    sub r9, 1
    store.i64 [rbp-8], r9
    cmp.i64 r8, 0
    jne ^outer_body
    jmp ^exit

  block ^outer_body
    mov r8, rbx
    add r8, [rbp-24]
    store.i64 [rbp-24], r8
    store.i64 [rbp-16], 1
    jmp ^inner_cond

  block ^inner_cond
    load.i64 r8, [rbp-16]
    mov r9, r8
    sub r9, 1
    store.i64 [rbp-16], r9
    cmp.i64 r8, 0
    jne ^inner_body
    jmp ^outer_cond

  block ^inner_body
    mov rdi, 7
    call @make_value [args=(rdi)]
    jmp ^after_replacement

  block ^after_replacement
    mov rdi, 3
    call @make_value [args=(rdi)]
    jmp ^inner_cond

  block ^exit
    load.i64 rax, [rbp-24]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @probe [args=()]
    mov rdx, 182
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
