machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @single_result
  storage data
  item i64 17

global @pair_result
  storage data
  item i64 0
  item i64 0

function @make_single
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 23
    load.i64 rax, [rbp-8]
    ret

function @make_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], 29
    store.i64 [rbp-8], 31
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    temp %single -> [rbp-8] : obj<8x8>
    temp %pair -> [rbp-24] : obj<16x8>

  block ^entry
    call @make_single [args=()]
    store.i64 [rbp-8], rax
    copy_bytes 8x8, @single_result, [rbp-8]
    call @make_pair [args=()]
    store.i64 [rbp-24], rax
    store.i64 [rbp-16], rdx
    copy_bytes 16x8, @pair_result, [rbp-24]
    load.i64 r8, @single_result
    load.i64 r9, @pair_result
    load.i64 rdi, @pair_result+8
    mov rdx, 23
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rdx, 29
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdx, 31
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    or r9, rdi
    or r8, r9
    sext.i32 r8
    ret r8
