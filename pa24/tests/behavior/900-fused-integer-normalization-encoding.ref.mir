machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @signed_source
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -17
    ret rax

function @unsigned_source
  abi
    return u8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 250
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @signed_source [args=()]
    mov rbx, rax
    sext.i32 rbx
    call @unsigned_source [args=()]
    zext.i8 rax
    mov r8, 17
    sext.i32 r8
    mov rdx, -17
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 250
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    mov rdx, 17
    cmp.i32 r8, rdx
    setne r8
    movzx r8, r8
    or rbx, rax
    or rbx, r8
    sext.i32 rbx
    ret rbx
