machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @saved_power
  storage scalar i64
  init i64 0

global @saved_magic
  storage scalar i64
  init i64 0

function @divide_and_store
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, rdi
    sar r8, 63
    shr r8, 59
    add r8, rdi
    sar r8, 5
    store.i64 @saved_power, r8
    add r8, 1
    mov rax, rdi
    mov r11, 5270498306774157605
    imul r11
    sar rdx, 1
    mov rax, rdx
    shr rax, 63
    add rdx, rax
    store.i64 @saved_magic, rdx
    add rdx, 1
    load.i64 r9, @saved_power
    add r9, @saved_magic
    add r8, rdx
    add r9, r8
    ret r9

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov rdi, 224
    call @divide_and_store [args=(rdi)]
    cmp.i64 rax, 80
    setne rbx
    movzx rbx, rbx
    mov rdi, -224
    call @divide_and_store [args=(rdi)]
    cmp.i64 rax, -76
    setne rax
    movzx rax, rax
    or rbx, rax
    ret rbx
