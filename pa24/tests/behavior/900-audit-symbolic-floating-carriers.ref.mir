machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage scalar i64
  init i64 7

function @address_f32
  abi
    return f32 -> xmm0
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov xmm0, @value
    ret xmm0

function @address_f64
  abi
    return f64 -> xmm0
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov xmm0, @value
    ret xmm0

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax
