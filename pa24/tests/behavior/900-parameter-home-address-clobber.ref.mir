machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 160
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14
    slot $object -> [rbp-24] : obj<24x8>
    slot $first -> [rbp-32] : i64
    slot $second -> [rbp-40] : i64
    slot $context -> [rbp-48] : i64
    slot $atomic_object -> [rbp-72] : obj<24x8>
    slot $atomic_context -> [rbp-80] : i64

  block ^entry
    lea rdi, [rbp-24]
    lea rbx, [rbp-32]
    lea r12, [rbp-40]
    lea r13, [rbp-48]
    mov rsi, rbx
    mov rdx, r12
    mov rcx, r13
    call @initialize [args=(rcx,rdx,rsi,rdi)]
    cmp.ptr rax, r13
    setne r13
    movzx r13, r13
    lea rdi, [rbp-72]
    lea r14, [rbp-80]
    mov rsi, rbx
    mov rdx, r12
    mov rcx, r14
    call @initialize_atomic [args=(rcx,rdx,rsi,rdi)]
    cmp.ptr rax, r14
    setne rax
    movzx rax, rax
    or r13, rax
    sext.i32 r13
    ret r13

function @initialize
  abi
    param %this -> rdi : ptr
    param %first -> rsi : ptr
    param %second -> rdx : ptr
    param %context -> rcx : ptr
    return ptr -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %context_field -> [rbp-8] : ptr

  block ^entry
    lea rdi, [rdi+16]
    store.ptr [rbp-8], rdi
    store.ptr [rdi], rcx
    eh_push ^unwind, 0
    call @touch [args=()]
    eh_pop
    jmp ^read_context

  block ^unwind
    resume

  block ^read_context
    load.ptr r10, [rbp-8]
    load.ptr rax, [r10]
    ret rax

function @initialize_atomic
  abi
    param %this -> rdi : ptr
    param %first -> rsi : ptr
    param %second -> rdx : ptr
    param %context -> rcx : ptr
    return ptr -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %context_field -> [rbp-8] : ptr

  block ^entry
    lea rdi, [rdi+16]
    store.ptr [rbp-8], rdi
    store.ptr [rdi], rcx
    eh_push ^unwind, 0
    call @touch [args=()]
    eh_pop
    jmp ^read_context

  block ^unwind
    resume

  block ^read_context
    load.ptr r10, [rbp-8]
    load.ptr rax, [r10]
    ret rax

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret
