machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @allocate
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    param %bytes -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $size -> [rbp-8] : i64
    param-slot %bytes -> [rbp-16] : i64

  block ^entry
    load.i64 rax, [rbp+16]
    store.i64 [rbp-16], rax
    load.i64 r11, [rbp-16]
    store.i64 [rbp-8], r11
    stack_alloc r8, 16
    load.i64 r10, [rbp-8]
    stack_alloc r9, r10
    sub r8, r9
    cmp.i64 r8, [rbp-16]
    setne r8
    movzx r8, r8
    store.i64 [r9], 73
    mov rdx, 73
    cmp.i64 [r9], rdx
    setne r9
    movzx r9, r9
    or r8, r9
    ret r8

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    sub rsp, 16
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    mov r11, 32
    store.i64 [rsp], r11
    call @allocate [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    ret rax
