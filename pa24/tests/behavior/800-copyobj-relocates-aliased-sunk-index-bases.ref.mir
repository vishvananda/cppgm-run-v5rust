machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @pair
  storage data
  item i64 0
  item i64 0

global @source
  storage data
  item i64 11
  item i64 22
  item i64 33
  item i64 44

global @dest
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0

function @mark_two
  abi
    param %first -> rdi : ptr
    param %second -> rsi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], 99
    store.i64 [rsi], 77
    ret

function @copy_then_mark_two
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    lea rsi, [rdi+8]
    copy_bytes 24x8, @dest, @source
    call @mark_two [args=(rsi,rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @pair
    mov rdi, rbx
    call @copy_then_mark_two [args=(rdi)]
    load.i64 r8, @pair
    load.i64 rbx, [rbx+8]
    mov rdx, 99
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 77
    cmp.i64 rbx, rdx
    sete rbx
    movzx rbx, rbx
    and r8, rbx
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
