machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 17
  item i64 19

global @observed
  storage scalar i64
  init i64 0

function @probe
  abi
    param %base -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 @observed, 11
    load.i64 rdi, [rdi+8]
    mov r9, rsi
    add r9, rdx
    mov rax, rcx
    add rax, r8
    add rsi, rcx
    add rdx, r8
    add r9, rax
    add rsi, rdx
    add r9, rsi
    load.i64 r8, @observed
    mov rsi, 100
    add rsi, 200
    add rdi, r8
    add rsi, rdi
    add rsi, r9
    ret rsi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @cells
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, 4
    call @probe [args=(rcx,rdx,rsi,rdi,r8)]
    mov rdx, 350
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
