machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 11
  item i64 22
  item i64 33

global @holder
  storage data
  item ptr addr @values

function @g
  abi
    param %this -> rdi : ptr
    param %__i -> rsi : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.ptr rdi, [rdi]
    lea rdi, [rdi+rsi*8]
    ret rdi

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @holder
    mov rsi, 2
    call @g [args=(rsi,rdi)]
    cmp.i64 [rax], 33
    setne rax
    movzx rax, rax
    ret rax
