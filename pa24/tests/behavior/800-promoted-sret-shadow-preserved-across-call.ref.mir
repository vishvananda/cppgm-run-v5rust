machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @saved_ret
  storage scalar ptr
  init ptr 0

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @make_pair
  abi
    param %ret -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rdi
    store.ptr @saved_ret, rbx
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @clobber [args=(rcx,rdx,rsi,rdi,r8,r9)]
    store.i64 [rbx], 11
    store.i64 [rbx+8], 22
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $out -> [rbp-16] : obj<16x8>

  block ^entry
    lea rbx, [rbp-16]
    mov rdi, rbx
    call @make_pair [args=(rdi)]
    cmp.ptr @saved_ret, rbx
    sete r8
    movzx r8, r8
    load.i64 r9, [rbx]
    load.i64 rbx, [rbx+8]
    mov rdx, 11
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 22
    cmp.i64 rbx, rdx
    sete rbx
    movzx rbx, rbx
    and r9, rbx
    and r8, r9
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
