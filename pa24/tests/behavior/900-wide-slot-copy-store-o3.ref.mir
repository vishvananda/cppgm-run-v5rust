machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @copy_wide
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i128 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $source -> [rbp-48] : i128
    param-slot %value -> [rbp-16] : i128
    temp %copy -> [rbp-32] : i128

  block ^entry
    store.i64 [rbp-16], rdi
    store.i64 [rbp-8], rsi
    mov.i128 [rbp-48], [rbp-16]
    mov.i128 [rbp-32], [rbp-48]
    load.i64 rax, [rbp-32]
    load.i64 rdx, [rbp-24]
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 208
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated
    slot $wide_source -> [rbp-80] : i128
    slot $wide_target -> [rbp-96] : i128
    slot $float_source -> [rbp-48] : f80
    slot $float_target -> [rbp-112] : f80
    slot $object_source -> [rbp-8] : obj<8x8>
    slot $object_target -> [rbp-16] : obj<8x8>
    temp %wide -> [rbp-64] : i128
    temp %wide_again -> [rbp-128] : i128
    temp %float -> [rbp-144] : f80
    temp %float_again -> [rbp-160] : f80
    temp %object -> [rbp-24] : obj<8x8>

  block ^entry
    mov.i128 [rbp-80], 0x00000000000000010000000000000029
    mov rdi, 41
    mov rsi, 1
    call @copy_wide [args=(rsi,rdi)]
    store.i64 [rbp-64], rax
    store.i64 [rbp-56], rdx
    mov.i128 [rbp-96], [rbp-80]
    mov.i128 [rbp-128], [rbp-96]
    set.ne.i128 r8, [rbp-64], 0x00000000000000010000000000000029
    set.ne.i128 r9, [rbp-128], 0x00000000000000010000000000000029
    fmov.f80 [rbp-48], 41.0L
    fmov.f80 [rbp-144], [rbp-48]
    fmov.f80 [rbp-112], [rbp-48]
    fmov.f80 [rbp-160], [rbp-112]
    fne.f80 rdi, [rbp-144], 41.0L
    fne.f80 rsi, [rbp-160], 41.0L
    store.i64 [rbp-8], 73
    copy_bytes 8x8, [rbp-24], [rbp-8]
    copy_bytes 8x8, [rbp-16], [rbp-24]
    cmp.i64 [rbp-16], 73
    setne rdx
    movzx rdx, rdx
    store.i64 [rbp-8], 97
    copy_bytes 8x8, [rbp-16], [rbp-8]
    cmp.i64 [rbp-16], 97
    setne rcx
    movzx rcx, rcx
    or r8, r9
    or rdi, rsi
    or rdx, rcx
    or r8, rdi
    or r8, rdx
    ret r8
