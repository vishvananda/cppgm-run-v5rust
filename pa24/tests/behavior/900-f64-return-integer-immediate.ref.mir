machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @one
  abi
    return f64 -> xmm0
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fmov.f64 xmm0, 1.0
    ret xmm0

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    call @one [args=()]
    feq.f64 r8, xmm0, 1.0
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
