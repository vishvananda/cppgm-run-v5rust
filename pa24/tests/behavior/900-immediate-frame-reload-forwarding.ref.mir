machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @reload_to_return_register
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 13
    ret rax

function @reload_to_same_register
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 29
    add r8, 1
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @reload_to_return_register [args=()]
    mov rbx, rax
    call @reload_to_same_register [args=()]
    mov rdx, 13
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 30
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or rbx, rax
    sext.i32 rbx
    ret rbx
