machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14

  block ^entry
    mov r8, -1
    mov rdx, -1
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, -1
    shr r9, 1
    mov rdx, 9223372036854775807
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdi, -1
    and rdi, 7
    mov rdx, 7
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov r11, -9223372036854775808
    mov rax, -1
    mov rdx, 0
    div r11
    mov rdx, 1
    cmp.i64 rax, rdx
    setne rsi
    movzx rsi, rsi
    mov r11, -9223372036854775808
    mov rax, -1
    mov rdx, 0
    div r11
    mov rcx, rdx
    mov rdx, 9223372036854775807
    cmp.i64 rcx, rdx
    setne rcx
    movzx rcx, rcx
    mov rax, 255
    shr rax, 2
    mov rdx, 63
    cmp.u8 rax, rdx
    setne rbx
    movzx rbx, rbx
    mov rax, 65535
    and rax, 255
    mov rdx, 255
    cmp.u16 rax, rdx
    setne r12
    movzx r12, r12
    mov rax, 4294967295
    shr rax, 16
    mov rdx, 65535
    cmp.u32 rax, rdx
    setne r13
    movzx r13, r13
    mov r11, 7
    mov rax, 100
    mov rdx, 0
    div r11
    mov rdx, 14
    cmp.i64 rax, rdx
    setne r14
    movzx r14, r14
    mov r11, 7
    mov rax, 100
    mov rdx, 0
    div r11
    mov rax, rdx
    mov rdx, 2
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or r8, r9
    or rdi, rsi
    or rcx, rbx
    or r12, r13
    or r14, rax
    or r8, rdi
    or rcx, r12
    or r8, rcx
    or r8, r14
    sext.i32 r8
    ret r8
