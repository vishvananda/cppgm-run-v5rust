machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @table
  storage data
  item ptr addr @sum6

function @sum6
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, rsi
    add rdi, rdx
    add rdi, rcx
    add rdi, r8
    add rdi, r9
    ret rdi

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %r -> [rbp-8] : i64

  block ^entry
    load.ptr r8, @table
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r9, 6
    mov r11, r8
    mov r8, 5
    call *r11 [args=(rcx,rdx,rsi,rdi,r8,r9)]
    store.i64 [rbp-8], rax
    load.i64 r8, [rbp-8]
    sub r8, 21
    ret r8
