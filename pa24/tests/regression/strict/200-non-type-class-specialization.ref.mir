machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $b__0 -> [rbp-8] : i64

  block ^entry
    lea rdi, [rbp-8]
    call @Box_3___Box [args=(rdi)]
    lea rdi, [rbp-8]
    call @Box_3___get [args=(rdi)]
    mov rbx, rax
    lea rdi, [rbp-8]
    call @Box_3____Box [args=(rdi)]
    ret rbx

function @Box_3___get
  abi
    param %this -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 5
    ret rax

function @Box_3___Box
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @Box_3____Box
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret
