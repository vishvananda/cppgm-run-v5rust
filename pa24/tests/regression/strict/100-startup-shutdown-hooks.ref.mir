machine_ir x86_64 linux

startup
    call @__cppgm_init [args=()]
    call @main [args=()]
    mov r12, rax
    call @__cppgm_fini [args=()]
    mov rdi, r12
    exit

global @g
  storage scalar i64
  init i64 0

function @__cppgm_init
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 @g, 5
    ret

function @__cppgm_fini
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 @g, 9
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, @g
    ret rax
