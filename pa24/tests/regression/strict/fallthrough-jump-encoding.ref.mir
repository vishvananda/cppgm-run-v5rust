machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    jmp ^step_one

  block ^step_one
    jmp ^step_two

  block ^step_two
    jmp ^step_three

  block ^step_three
    jmp ^ok

  block ^ok
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax
