machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 5
    lock_xadd.i64 @g, r8
    add r8, 5
    cmp.i64 r8, 12
    sete r8
    movzx r8, r8
    ret r8
