machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $expected -> [rbp-8] : i64

  block ^entry
    store.i64 [rbp-8], 5
    mov rcx, 9
    load.i64 rax, [rbp-8]
    lock_cmpxchg.i64 @g, rcx
    store.i64 [rbp-8], rax
    sete r8
    movzx r8, r8
    load.i64 r9, @g
    load.i64 rdi, [rbp-8]
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 7
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 7
    cmp.i64 rdi, rdx
    sete rdi
    movzx rdi, rdi
    and r8, r9
    and r8, rdi
    ret r8
