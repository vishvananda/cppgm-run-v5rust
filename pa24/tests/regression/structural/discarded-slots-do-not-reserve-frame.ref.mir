machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r10, 42
    mov rdx, 42
    cmp.i64 r10, rdx
    setne rax
    movzx rax, rax
    ret rax
