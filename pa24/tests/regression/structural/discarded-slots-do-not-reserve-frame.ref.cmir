machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov <gpr0>, 42
    mov rdx, 42
    cmp.i64 <gpr0>, rdx
    setne rax
    movzx rax, rax
    ret rax
