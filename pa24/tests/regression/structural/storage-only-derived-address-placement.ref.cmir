machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

function @produce
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 29
    ret rax

function @write_second
  abi
    param %base -> rdi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>

  block ^entry
    mov <gpr0>, rdi
    lea <gpr1>, [<gpr0>+<off0>]
    jmp ^write

  block ^write
    call @produce [args=()]
    store.i64 [<gpr1>], rax
    store.i64 [<gpr0>], 11
    ret

function @initialize_tail
  abi
    param %base -> rdi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    lea r8, [rdi+<off0>]
    mov r9, 0
    jmp ^condition

  block ^condition
    cmp.i64 r9, 2
    jb ^body
    jmp ^done

  block ^body
    mov rdi, r9
    add rdi, 40
    store.i64 [r8+r9*8], rdi
    mov rdi, r9
    add rdi, 1
    mov r9, rdi
    jmp ^condition

  block ^done
    ret

function @read_before_call
  abi
    param %base -> rdi : ptr
    param %x -> rsi : i64
    param %y -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1> <gpr2> <gpr3>

  block ^entry
    mov <gpr0>, rdi
    mov <gpr1>, rsi
    mov <gpr2>, rdx
    lea <gpr3>, [<gpr0>+<off0>]
    jmp ^compute

  block ^compute
    add <gpr1>, 1
    add <gpr2>, 2
    mov r8, 10
    add r8, 20
    mov r9, 30
    add r9, 40
    add <gpr1>, <gpr2>
    load.i64 <gpr3>, [<gpr3>]
    add r8, r9
    add <gpr1>, r8
    add <gpr1>, <gpr3>
    call @produce [args=()]
    mov r8, rax
    store.i64 [<gpr0>], r8
    add <gpr1>, r8
    ret <gpr1>

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve <gpr0>

  block ^entry
    mov <gpr0>, @cells
    mov rdi, <gpr0>
    call @write_second [args=(rdi)]
    mov rdi, <gpr0>
    call @initialize_tail [args=(rdi)]
    mov rdi, <gpr0>
    mov rsi, 3
    mov rdx, 5
    call @read_before_call [args=(rdx,rsi,rdi)]
    load.i64 r8, [<gpr0>+<off0>]
    load.i64 r9, [<gpr0>+<off1>]
    load.i64 <gpr0>, [<gpr0>+<off2>]
    mov rdx, 29
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rdx, 40
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdx, 41
    cmp.i64 <gpr0>, rdx
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rdx, 169
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or r9, <gpr0>
    or r8, rax
    or r8, r9
    sext.i32 r8
    ret r8
