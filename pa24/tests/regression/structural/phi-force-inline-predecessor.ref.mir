machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    jmp ^left

  block ^left
    call @touch [args=()]
    mov r9, 40
    add r9, 2
    mov r8, r9
    jmp ^join

  block ^right
    mov r8, 7
    jmp ^join

  block ^join
    ret r8
