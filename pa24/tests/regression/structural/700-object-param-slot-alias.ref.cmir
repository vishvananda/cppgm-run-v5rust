machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @make_value
  abi
    return obj<8x8> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tmp -> [rbp-<off0>] : obj<8x8>

  block ^entry
    store.i64 [rbp-<off0>], 7
    load.i64 rax, [rbp-<off0>]
    ret

function @unwrap
  abi
    param %x -> rdi : obj<8x8>
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $x -> [rbp-<off0>] : obj<8x8>
    param-slot %x -> [rbp-<off1>] : obj<8x8>

  block ^entry
    store.i64 [rbp-<off1>], rdi
    copy_bytes 8x8, [rbp-<off0>], [rbp-<off1>]
    load.i64 rax, [rbp-<off0>]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %v -> [rbp-<off0>] : obj<8x8>

  block ^entry
    call @make_value [args=()]
    store.i64 [rbp-<off0>], rax
    load.i64 rdi, [rbp-<off0>]
    call @unwrap [args=(rdi)]
    ret rax
