machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @fp
  storage scalar ptr
  init addr @ret3

function @ret3
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 3
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @fp
    call *@fp [args=()]
    ret rax
