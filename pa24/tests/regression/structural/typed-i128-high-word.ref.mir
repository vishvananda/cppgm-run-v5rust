machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @wide
  storage scalar i128
  init i128 0x00000010000000000000000000000000

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %wide -> [rbp-16] : i128

  block ^entry
    mov.i128 [rbp-16], @wide
    set.ne.i128 rax, [rbp-16], 0x00000010000000000000000000000000
    ret rax
