machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cell
  storage data
  item i64 73

global @tag_source
  storage data
  item i8 1

function @observe
  abi
    param %base -> rdi : ptr
    param %tag -> rsi : obj<1x1>
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rdi]
    ret rax

function @forward
  abi
    param %base -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tag -> [rbp-<off0>] : obj<1x1>

  block ^entry
    mov r8, rdi
    copy_bytes 1x1, [rbp-<off0>], @tag_source
    mov rdi, r8
    load.i64 rsi, [rbp-<off0>]
    call @observe [args=(rsi,rdi)]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @cell
    call @forward [args=(rdi)]
    mov rdx, 73
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
