machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $x -> [rbp-<off0>] : i64

  block ^entry
    store.i64 [rbp-<off0>], 0
    lea r8, [rbp-<off0>]
    lea r9, [rbp-<off0>]
    cmp.ptr r8, r9
    je ^same
    jmp ^different

  block ^same
    mov rax, 0
    ret rax

  block ^different
    mov rax, 1
    ret rax
