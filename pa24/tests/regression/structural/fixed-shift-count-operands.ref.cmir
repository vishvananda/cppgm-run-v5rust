machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 3
    shl r8, 4
    mov r9, -16
    shr r9, 2
    mov rdi, -16
    sar rdi, 1
    mov rsi, 7
    shl rsi, 0
    mov rdx, 48
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rdx, 4611686018427387900
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdx, -8
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rdx, 7
    cmp.i64 rsi, rdx
    setne rsi
    movzx rsi, rsi
    or rdi, rsi
    or r9, rdi
    or r8, r9
    sext.i32 r8
    ret r8
