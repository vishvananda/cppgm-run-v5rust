machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov <gpr0>, 0
    cmp.ptr <gpr0>, 0
    je ^good
    jmp ^bad

  block ^bad
    mov rax, 0
    ret rax

  block ^good
    mov rax, 1
    ret rax
