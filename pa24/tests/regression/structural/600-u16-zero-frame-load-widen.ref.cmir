machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $x -> [rbp-<off0>] : u16

  block ^entry
    store.u16 [rbp-<off0>], 65535
    load.u16 r8, [rbp-<off0>]
    cmp.i64 r8, 65535
    sete r8
    movzx r8, r8
    ret r8
