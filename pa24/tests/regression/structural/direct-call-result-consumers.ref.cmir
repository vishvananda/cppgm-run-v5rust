machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @saved
  storage scalar i64
  init i64 0

function @produce
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @consume
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @saved_address
  abi
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, @saved
    ret rax

function @observe_reference
  abi
    param %value -> rdi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @load_saved
  abi
    param %value -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rdi]
    ret rax

function @store_result
  abi
    param %value -> rdi : i64
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @produce [args=(rdi)]
    store.i64 @saved, rax
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>

  block ^entry
    mov rdi, 41
    call @produce [args=(rdi)]
    mov rdi, rax
    call @consume [args=(rdi)]
    mov rdi, rax
    call @store_result [args=(rdi)]
    load.i64 <gpr0>, @saved
    call @saved_address [args=()]
    mov <gpr1>, rax
    mov rdi, <gpr1>
    call @observe_reference [args=(rdi)]
    mov rdi, <gpr1>
    call @load_saved [args=(rdi)]
    mov rdx, 41
    cmp.i64 <gpr0>, rdx
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rdx, 41
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    sext.i32 <gpr0>
    ret <gpr0>
