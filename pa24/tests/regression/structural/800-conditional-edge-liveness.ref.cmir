machine_ir x86_64 <host-target>

startup
    call @__cppgm_406d61696e [args=()]
    mov rdi, rax
    exit

function @f
  abi
    param %cond -> rdi : i64
    param %x -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.i64 rdi, 0
    jne ^then
    jmp ^else

  block ^then
    ret rsi

  block ^else
    mov rax, 0
    ret rax

function @__cppgm_406d61696e
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 41
    call @f [args=(rsi,rdi)]
    mov r8, rax
    cmp.i64 r8, 41
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax
