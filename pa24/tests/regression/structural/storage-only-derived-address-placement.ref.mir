machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

function @produce
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 29
    ret rax

function @write_second
  abi
    param %base -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov rbx, rdi
    lea r12, [rbx+8]
    jmp ^write

  block ^write
    call @produce [args=()]
    store.i64 [r12], rax
    store.i64 [rbx], 11
    ret

function @initialize_tail
  abi
    param %base -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    lea r8, [rdi+16]
    mov r9, 0
    jmp ^condition

  block ^condition
    cmp.i64 r9, 2
    jb ^body
    jmp ^done

  block ^body
    mov rdi, r9
    add rdi, 40
    store.i64 [r8+r9*8], rdi
    mov rdi, r9
    add rdi, 1
    mov r9, rdi
    jmp ^condition

  block ^done
    ret

function @read_before_call
  abi
    param %base -> rdi : ptr
    param %x -> rsi : i64
    param %y -> rdx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    lea r14, [rbx+8]
    jmp ^compute

  block ^compute
    add r12, 1
    add r13, 2
    mov r8, 10
    add r8, 20
    mov r9, 30
    add r9, 40
    add r12, r13
    load.i64 r14, [r14]
    add r8, r9
    add r12, r8
    add r12, r14
    call @produce [args=()]
    mov r8, rax
    store.i64 [rbx], r8
    add r12, r8
    ret r12

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @cells
    mov rdi, rbx
    call @write_second [args=(rdi)]
    mov rdi, rbx
    call @initialize_tail [args=(rdi)]
    mov rdi, rbx
    mov rsi, 3
    mov rdx, 5
    call @read_before_call [args=(rdx,rsi,rdi)]
    load.i64 r8, [rbx+8]
    load.i64 r9, [rbx+16]
    load.i64 rbx, [rbx+24]
    mov rdx, 29
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rdx, 40
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdx, 41
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 169
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or r9, rbx
    or r8, rax
    or r8, r9
    sext.i32 r8
    ret r8
