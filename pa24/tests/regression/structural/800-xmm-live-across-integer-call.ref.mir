machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @observed
  storage scalar f64
  init f64 0.0

function @clobber_xmm_from_integer
  abi
    param %value -> rdi : i32
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    sitofp.i32.f64 xmm0, rdi
    fadd.f64 xmm0, xmm0, 0.5
    fmul.f64 xmm0, xmm0, 3.0
    fmov.f64 @observed, xmm0
    sub rdi, 5
    sext.i32 rdi
    ret rdi

function @preserve_across_integer_call
  abi
    param %value -> xmm0 : f64
    return f64 -> xmm0
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    param-slot %value -> [rbp-8] : f64
    temp %live -> [rbp-16] : f64

  block ^entry
    fmov.f64 [rbp-8], xmm0
    fadd.f64 xmm14, [rbp-8], 1.25
    fmov.f64 [rbp-16], xmm14
    mov rdi, 7
    call @clobber_xmm_from_integer [args=(rdi)]
    sext.i32 rax
    sitofp.i32.f64 xmm0, rax
    fadd.f64 xmm0, [rbp-16], xmm0
    ret xmm0

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fmov.f64 xmm0, 4.0
    call @preserve_across_integer_call [args=(xmm0)]
    feq.f64 r8, xmm0, 7.25
    fmov.f64 xmm0, @observed
    feq.f64 r9, xmm0, 22.5
    and r8, r9
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    ret r8
