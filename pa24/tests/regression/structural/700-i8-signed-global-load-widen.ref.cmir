machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i8
  init i8 -1

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i8 r8, @g
    cmp.i64 r8, -1
    sete r8
    movzx r8, r8
    ret r8
