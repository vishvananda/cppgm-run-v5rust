machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @make_value
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tmp -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 7
    load.i64 rax, [rbp-8]
    ret

function @unwrap
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $x -> [rbp-8] : obj<8x8>
    temp %t -> [rbp-16] : obj<8x8>

  block ^entry
    call @make_value [args=()]
    store.i64 [rbp-16], rax
    copy_bytes 8x8, [rbp-8], [rbp-16]
    load.i64 rax, [rbp-8]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @unwrap [args=()]
    ret rax
