machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 10
  item i64 20
  item i64 30
  item i64 40

function @variable_address
  abi
    param %base -> rdi : ptr
    param %which -> rsi : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    lea rdi, [rdi+rsi*8]
    ret rdi

function @constant_address
  abi
    param %base -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    lea rdi, [rdi+24]
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov rbx, @values
    mov rdi, rbx
    mov rsi, 2
    call @variable_address [args=(rsi,rdi)]
    load.i64 r12, [rax]
    mov rdi, rbx
    call @constant_address [args=(rdi)]
    load.i64 rax, [rax]
    mov rdx, 30
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov rdx, 40
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or r12, rax
    sext.i32 r12
    ret r12
