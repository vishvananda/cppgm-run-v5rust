machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @table
  storage data
  item ptr addr @mix

function @mix
  abi
    param %a -> rdi : i64
    param %b -> xmm0 : f64
    param %c -> rsi : i64
    param %d -> xmm1 : f64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>
    param-slot %b -> [rbp-<off0>] : f64
    param-slot %d -> [rbp-<off1>] : f64

  block ^entry
    fmov.f64 [rbp-<off0>], xmm0
    fmov.f64 [rbp-<off1>], xmm1
    fptosi.f64.i64 r9, [rbp-<off0>]
    fptosi.f64.i64 <gpr0>, [rbp-<off1>]
    mov <gpr1>, rdi
    add <gpr1>, rsi
    add r9, <gpr0>
    add <gpr1>, r9
    ret <gpr1>

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    load.ptr r8, @table
    mov rdi, 10
    mov rsi, 20
    fmov.f64 xmm0, 1.5
    fmov.f64 xmm1, 2.5
    call *r8 [args=(rsi,rdi,xmm0,xmm1)]
    cmp.i64 rax, 33
    sete rax
    movzx rax, rax
    ret rax
