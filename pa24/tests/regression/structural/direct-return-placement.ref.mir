machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage scalar i32
  init i32 17

function @return_constant
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 11
    ret rax

function @return_load
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i32 rax, @value
    ret rax

function @return_global_address
  abi
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, @value
    ret rax

function @return_slot_address
  abi
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $local -> [rbp-8] : i32

  block ^entry
    lea rax, [rbp-8]
    ret rax

function @return_compare
  abi
    param %left -> rdi : i64
    param %right -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.i64 rdi, rsi
    setb rdi
    movzx rdi, rdi
    ret rdi

function @return_negated
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    neg rdi
    ret rdi

function @return_converted
  abi
    param %value -> rdi : i64
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    sext.i32 rdi
    ret rdi

function @return_quotient
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 7
    mov rax, rdi
    cqo
    idiv r11
    ret rax

function @return_remainder
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 7
    mov rax, rdi
    cqo
    idiv r11
    ret rdx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %converted -> [rbp-8] : i32
    temp %quotient -> [rbp-16] : i64

  block ^entry
    call @return_constant [args=()]
    mov rbx, rax
    sext.i32 rbx
    call @return_load [args=()]
    mov r12, rax
    sext.i32 r12
    call @return_global_address [args=()]
    mov r13, rax
    mov rdi, 3
    mov rsi, 5
    call @return_compare [args=(rsi,rdi)]
    mov r14, rax
    mov rdi, -7
    call @return_negated [args=(rdi)]
    mov r15, rax
    mov rdi, 4294967297
    call @return_converted [args=(rdi)]
    mov r10, rax
    sext.i32 r10
    store.i32 [rbp-8], r10
    mov rdi, 50
    call @return_quotient [args=(rdi)]
    mov r10, rax
    store.i64 [rbp-16], r10
    mov rdi, 50
    call @return_remainder [args=(rdi)]
    mov r8, @value
    mov rdx, 11
    cmp.i32 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 17
    cmp.i32 r12, rdx
    setne r12
    movzx r12, r12
    cmp.ptr r13, r8
    setne r13
    movzx r13, r13
    mov rdx, 1
    cmp.i64 r14, rdx
    setne r14
    movzx r14, r14
    mov rdx, 7
    cmp.i64 r15, rdx
    setne r15
    movzx r15, r15
    mov rdx, 1
    cmp.i32 [rbp-8], rdx
    setne r8
    movzx r8, r8
    mov rdx, 7
    cmp.i64 [rbp-16], rdx
    setne r9
    movzx r9, r9
    mov rdx, 1
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, r14
    or r13, r15
    or r13, r8
    or r9, rax
    or r13, r9
    or rbx, r13
    sext.i32 rbx
    ret rbx
