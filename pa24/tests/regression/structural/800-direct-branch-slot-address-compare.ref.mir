machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $x -> [rbp-8] : i64

  block ^entry
    store.i64 [rbp-8], 0
    lea r8, [rbp-8]
    lea r9, [rbp-8]
    cmp.ptr r8, r9
    je ^same
    jmp ^different

  block ^same
    mov rax, 0
    ret rax

  block ^different
    mov rax, 1
    ret rax
