machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g thread_local
  storage scalar i64
  init i64 0

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 @g, 7
    load.i64 r8, @g
    and r8, 4294967295
    sext.i32 r8
    ret r8
