machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i128
  init i128 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $expected -> [rbp-16] : i128
    temp %loaded -> [rbp-32] : i128
    temp %now -> [rbp-48] : i128

  block ^entry
    atomic_load.i128 [rbp-32], @g
    mov.i128 [rbp-16], [rbp-32]
    lock_cmpxchg16b.i128 r8, @g, [rbp-16], 9
    atomic_load.i128 [rbp-48], @g
    set.eq.i128 r9, [rbp-48], 9
    and r8, r9
    ret r8
