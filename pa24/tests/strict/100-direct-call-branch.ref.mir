machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @helper
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    jmp ^then

  block ^then
    mov rdi, 7
    call @helper [args=(rdi)]
    ret rax

  block ^else
    mov rax, 0
    ret rax
