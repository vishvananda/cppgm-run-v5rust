# budget from 100-direct-call-branch.ref.mir: the course solution's count, widened by 100% and rounded up, plus one, and at least three more than the count
instructions <= 15
blocks <= 9
count(call) <= 4
mem <= 4
instructions <= 4 in @helper
stack_size <= 320 in @helper
instructions <= 13 in @main
stack_size <= 320 in @main
