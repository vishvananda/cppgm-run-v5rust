machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @uncalled
  abi
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $destination -> [rbp-8] : ptr

  block ^entry
    load.ptr r11, [rbp]
    store.ptr [rbp-8], r11
    load.ptr rax, [rbp-8]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax
