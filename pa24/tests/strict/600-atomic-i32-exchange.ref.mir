machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i32
  init i32 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 11
    xchg.i32 @g, r8
    sext.i32 r8
    load.i32 r9, @g
    mov rdx, 7
    cmp.i32 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 11
    cmp.i32 r9, rdx
    sete r9
    movzx r9, r9
    and r8, r9
    ret r8
