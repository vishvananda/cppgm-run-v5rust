machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $area -> [rbp-16] : obj<12x4>

  block ^entry
    zero_bytes 12x4, [rbp-16]
    load.i64 rax, [rbp-16]
    ret rax
