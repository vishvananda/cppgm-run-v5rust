function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $b : obj<1x1>

  block ^entry:
    %t1 = addr $b
    %t2 = addr $b
    %t3 = call i32 @Box_int___get(%t2)
    return i32 %t3
}
function @Box_int___get(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZN3BoxIiE3getEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i32 2
}
