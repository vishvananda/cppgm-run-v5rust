function @use(%n : i32) -> i32 [binding=strong, object=_Z3usei] {
  slot $n : i32

  block ^entry:
    store typed i32 %n, $n
    %t1 = load typed i32 $n
    return i32 %t1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call i32 @expand()
    %t2 = cmp eq i32 %t1, 1
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load typed i32 $cond__1
    return i32 %t3
}
function @expand() -> i32 [binding=weak, object=_Z6expandIJLi0EEEiv] {
  block ^entry:
    %t1 = call i32 @value()
    %t2 = call i32 @use(%t1)
    return i32 %t2
}
function @value() -> i32 [binding=weak, object=_Z5valueILi1EEiv] {
  block ^entry:
    return i32 1
}
