global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  u32 1
  u32 2
  u32 3
  u32 4
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $constants : obj<16x4>

  block ^entry:
    %t1 = addr $constants
    copyobj 16x4 @__constexpr_template__1, %t1
    %t2 = addr $constants
    %t3 = index u32 [projection=array_element] %t2, 2
    %t4 = load typed u32 %t3
    %t5 = cmp ne u32 %t4, 3
    %t6 = convert trunc i32 i64 %t5
    return i32 %t6
}
