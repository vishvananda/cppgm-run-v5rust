function @add(%a : i32, %b : i32) -> i32 [binding=strong, object=_Z3addii] {
  slot $a : i32
  slot $b : i32

  block ^entry:
    store typed i32 %a, $a
    store typed i32 %b, $b
    %t1 = load typed i32 $a
    %t2 = load typed i32 $b
    %t3 = binary add nowrap i32 %t1, %t2
    return i32 %t3
}
