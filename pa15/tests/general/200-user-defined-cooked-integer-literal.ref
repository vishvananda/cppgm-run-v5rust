function @operator___add(%value : i64) -> i32 [binding=strong, object=_Zli4_addy] {
  slot $value : i64

  block ^entry:
    store typed i64 %value, $value
    %t1 = load typed i64 $value
    %t2 = convert trunc i32 i64 %t1
    %t3 = binary add nowrap i32 %t2, 7
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = convert sext i64 i32 35
    %t2 = call i32 @operator___add(%t1)
    %t3 = cmp eq i32 %t2, 42
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load typed i32 $cond__1
    return i32 %t4
}
