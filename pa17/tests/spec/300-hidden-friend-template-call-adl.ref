function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : obj<4x4>
  slot $a : obj<4x4>
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr $x
    %t2 = addr $a
    %t3 = addr $x
    %t4 = index i8 [projection=field] %t3, 0
    store typed i32 4, %t4
    %t5 = addr $a
    %t6 = index i8 [projection=field] %t5, 0
    store typed i32 5, %t6
    %t7 = addr $x
    %t8 = addr $a
    %t9 = call i32 @apply(%t7, %t8)
    %t10 = cmp eq i32 %t9, 9
    branch %t10, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t11 = addr $x
    %t12 = index i8 [projection=field] %t11, 0
    %t13 = load typed i32 %t12
    %t14 = cmp eq i32 %t13, 9
    %t15 = cmp ne i64 %t14, 0
    store typed i64 %t15, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t16 = load typed i64 $land__2
    branch %t16, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t17 = load typed i32 $cond__1
    return i32 %t17
}
function @apply(%x : ptr [pass=by_address, object_bytes=4], %a : ptr [pass=by_address, object_bytes=4]) -> i32 [binding=weak, object=_Z5applyI5valueEiRT_RK3adl, inline_hint=yes] {
  slot $x : ptr
  slot $a : ptr

  block ^entry:
    store typed ptr %x, $x
    store typed ptr %a, $a
    %t1 = load typed ptr $x
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load typed i32 %t2
    %t4 = load typed ptr $a
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load typed i32 %t5
    %t7 = binary add nowrap i32 %t3, %t6
    %t8 = load typed ptr $x
    %t9 = index i8 [projection=field] %t8, 0
    store typed i32 %t7, %t9
    %t10 = load typed ptr $x
    %t11 = index i8 [projection=field] %t10, 0
    %t12 = load typed i32 %t11
    return i32 %t12
}
