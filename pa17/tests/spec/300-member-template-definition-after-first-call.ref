  block ^entry:
    store typed i32 %value, $value
    %t1 = addr $object
    %t2 = addr $operation
    %t3 = load typed i32 $value
    %t4 = addr $operation
    %t5 = index i8 [projection=field] %t4, 0
    store typed i32 %t3, %t5
    %t6 = addr $object
    %t7 = addr $argobj__1
    %t8 = addr $operation
    copyobj 4x4 %t8, %t7
    %t9 = call i32 @box_int___apply(%t6, $argobj__1)
    return i32 %t9
}
