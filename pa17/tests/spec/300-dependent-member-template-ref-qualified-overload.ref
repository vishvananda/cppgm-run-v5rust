    store typed ptr %x, $x
    store typed ptr %v, $v
    %t1 = load typed ptr $x
    %t2 = load typed ptr $v
    %t3 = call i32 @X__f(%t1, %t2)
    return i32 %t3
}
function @X__f(%this : ptr [object_bytes=1], %__param1 : ptr [pass=by_address, object_bytes=4]) -> i32 [binding=weak, object=_ZNR1X1fIiEEiRT_, inline_hint=yes] {
