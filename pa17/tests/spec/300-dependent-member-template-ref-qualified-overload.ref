function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : obj<1x1>
  slot $v : i32

  block ^entry:
    %t1 = addr $x
    store typed i32 0, $v
    %t2 = addr $x
    %t3 = addr $v
    %t4 = call i32 @g(%t2, %t3)
    return i32 %t4
}
