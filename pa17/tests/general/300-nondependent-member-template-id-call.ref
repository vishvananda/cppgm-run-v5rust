function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @run()
    %t2 = binary sub nowrap i32 %t1, 4
    return i32 %t2
}
function @run() -> i32 [binding=weak, object=_Z3runIiEiv] {
  slot $h : obj<1x1>

  block ^entry:
    %t1 = addr $h
    %t2 = addr $h
    %t3 = call i32 @Holder_int___get(%t2, 4)
    return i32 %t3
}
function @Holder_int___get(%this : ptr [object_bytes=1], %value : i32) -> i32 [binding=weak, object=_ZN6HolderIiE3getIiEET_S2_, inline_hint=yes] {
  slot $this : ptr
  slot $value : i32

  block ^entry:
    store typed ptr %this, $this
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    return i32 %t1
}
