function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : obj<1x1>

  block ^entry:
    %t1 = addr $x
    %t2 = addr $x
    %t3 = call i32 @X_int___f(%t2, 1)
    %t4 = binary sub nowrap i32 %t3, 1
    return i32 %t4
}
function @X_int___f(%this : ptr [object_bytes=1], %u : i32) -> i32 [binding=weak, object=_ZN1XIiE1fIiEEiT_, inline_hint=yes] {
  slot $this : ptr
  slot $u : i32

  block ^entry:
    store typed ptr %this, $this
    store typed i32 %u, $u
    %t1 = load typed i32 $u
    return i32 %t1
}
