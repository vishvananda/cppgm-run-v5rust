function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $status : i32

  block ^entry:
    store typed i32 0, $status
    %t1 = cmp eq u8 1, 0
    branch %t1, ^if_then_1, ^if_else_2

  block ^if_then_1:
    store typed i32 1, $status
    jump ^if_end_3

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t2 = cmp eq u8 1, 0
    branch %t2, ^if_then_4, ^if_else_5

  block ^if_then_4:
    store typed i32 2, $status
    jump ^if_end_6

  block ^if_else_5:
    jump ^if_end_6

  block ^if_end_6:
    %t3 = load typed i32 $status
    return i32 %t3
}
