function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $input : i32

  block ^entry:
    store typed i32 0, $input
    %t1 = addr $input
    %t2 = call i32 @value(%t1)
    return i32 %t2
}
function @value(%input : ptr [pass=by_address, object_bytes=4]) -> i32 [binding=weak, object=_Z5valueIiET_RS0_] {
  slot $input : ptr

  block ^entry:
    store typed ptr %input, $input
    %t1 = load typed ptr $input
    %t2 = load typed i32 %t1
    return i32 %t2
}
