function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $tmpobj__2 : obj<1x1>

  block ^entry:
    %t1 = addr $tmpobj__2
    zeroinit 1x1 %t1
    %t2 = call i32 @holder__current_size(%t1)
    %t3 = cmp eq i32 %t2, 7
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load typed i32 $cond__1
    return i32 %t4
}
function @holder__current_size(%this : ptr [object_bytes=1]) -> i32 [unwind=no, binding=weak, object=_ZN6holder12current_sizeIiEEiv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = call i32 @holder__probe()
    return i32 %t1
}
function @holder__probe() -> i32 [unwind=no, binding=weak, object=_ZN6holder5probeEv, inline_hint=yes] {
  block ^entry:
    return i32 7
}
