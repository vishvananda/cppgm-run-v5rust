declare global @is_small_char___value : u8 [binding=weak, object=_ZN8is_smallIcE5valueE]
declare global @is_small_double___value : u8 [binding=weak, object=_ZN8is_smallIdE5valueE]

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $both_small : i8
  slot $one_large : f64
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    store i8 0, $both_small
    %t1 = convert sitofp f64 i32 0
    store typed f64 %t1, $one_large
    %t2 = const i64 1
    %t3 = convert sext i64 i32 1
    %t4 = cmp eq i64 %t2, %t3
    branch %t4, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t5 = const i64 8
    %t6 = const i64 8
    %t7 = cmp eq i64 %t5, %t6
    %t8 = cmp ne i64 %t7, 0
    store typed i64 %t8, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t9 = load typed i64 $land__2
    branch %t9, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t10 = load typed i32 $cond__1
    return i32 %t10
}
