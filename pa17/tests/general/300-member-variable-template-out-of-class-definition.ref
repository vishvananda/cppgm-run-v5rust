function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = cmp ne i32 4, 4
    branch %t1, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 10

