function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $item : obj<4x4>
  slot $number : i32
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $argobj__3 : obj<4x4>

  block ^entry:
    %t1 = addr $item
    %t2 = addr $item
    %t3 = index i8 [projection=field] %t2, 0
    store typed i32 5, %t3
    store typed i32 3, $number
    %t4 = addr $argobj__3
    %t5 = addr $item
    copyobj 4x4 %t5, %t4
    %t6 = call i32 @read($argobj__3)
    %t7 = cmp eq i32 %t6, 5
    branch %t7, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t8 = addr $number
    %t9 = call i32 @read__2(%t8)
    %t10 = cmp eq i32 %t9, 4
    %t11 = cmp ne i64 %t10, 0
    store typed i64 %t11, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t12 = load typed i64 $land__2
    branch %t12, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t13 = load typed i32 $cond__1
    return i32 %t13
}
function @read(%item : obj<4x4>) -> i32 [binding=weak, object=_Z4read5value, inline_hint=yes] {
  slot $item : obj<4x4>

  block ^entry:
    %t1 = addr $item
    copyobj 4x4 %item, %t1
    %t2 = addr $item
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = load typed i32 %t3
    return i32 %t4
}
function @read__2(%pointer : ptr) -> i32 [binding=weak, object=_Z4readIiEiPT_] {
  slot $pointer : ptr

  block ^entry:
    store typed ptr %pointer, $pointer
    %t1 = load typed ptr $pointer
    %t2 = load typed i32 %t1
    %t3 = binary add nowrap i32 %t2, 1
    return i32 %t3
}
