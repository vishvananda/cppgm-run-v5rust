1 translation units
start translation unit 1
translation-unit
  function-definition
    decl-specifier-seq
      decl-specifier KW_INT:int
    declarator
      identifier main
      parameter-clause
    compound-statement
      expression-statement
        assignment-expression OP_ASS:=
          id-expression x
          id-expression y
      expression-statement
        assignment-expression OP_STARASS:*=
          id-expression x
          id-expression y
      expression-statement
        assignment-expression OP_DIVASS:/=
          id-expression x
          id-expression y
      expression-statement
        assignment-expression OP_PLUSASS:+=
          id-expression x
          id-expression y
      expression-statement
        assignment-expression OP_MINUSASS:-=
          id-expression x
          id-expression y
      expression-statement
        assignment-expression OP_RSHIFTASS:>>=
          id-expression x
          id-expression y
      expression-statement
        assignment-expression OP_LSHIFTASS:<<=
          id-expression x
          id-expression y
      expression-statement
        assignment-expression OP_BANDASS:&=
          id-expression x
          id-expression y
      expression-statement
        assignment-expression OP_XORASS:^=
          id-expression x
          id-expression y
      expression-statement
        assignment-expression OP_BORASS:|=
          id-expression x
          id-expression y
end translation unit
