global @g : i64 = 0

function @facts(%p : ptr, %n : i32, %a : i64, %b : i64) -> i64 {
  slot $x : f64

  block ^entry:
    %v = load typed i32 %p
    %w = load volatile typed i64 @g
    %c = load i8 %p
    store typed f64 1.5, $x
    store volatile typed i64 %a, @g
    %s = binary add nowrap i32 %v, %n
    %d = binary sub nowrap i64 %a, %b
    %m = binary mul nowrap i32 %s, 3
    %l = binary shl nowrap i64 %a, 2
    %n2 = convert trunc u32 i64 %a
    %u = binary add nowrap u32 %n2, 16
    %q = binary div exact i64 %d, 12
    %r = binary shr exact i64 %d, 3
    %t = binary udiv exact u32 %u, 4
    %z = binary ushr exact i64 %l, 2
    %e = convert sext i64 i32 %m
    %f = binary add i64 %q, %r
    %h = binary add i64 %f, %e
    %i = binary add i64 %h, %z
    %t64 = convert zext i64 u32 %t
    %i2 = binary add i64 %i, %t64
    %j = binary add i64 %i2, %w
    return i64 %j
}
function @main() -> i64 [role=entry] {
  slot $cell : i32

  block ^entry:
    store typed i32 7, $cell
    %p = addr $cell
    %r = call i64 @facts(%p, 5, 48, 24)
    return i64 %r
}
