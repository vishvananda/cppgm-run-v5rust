function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $value
    %t2 = addr $value
    %t3 = call i32 @RefPick__pick__ov2(%t2)
    %t4 = cmp eq i32 %t3, 2
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load typed i32 $cond__1
    return i32 %t5
}
function @RefPick__pick__ov2(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZNKO7RefPick4pickEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i32 2
}
