function @take(%x : f64) -> i32 [binding=strong, object=_Z4taked] {
  slot $x : f64
  slot $cond__1 : i32

  block ^entry:
    store typed f64 %x, $x
    %t1 = load typed f64 $x
    %t2 = cmp eq f64 %t1, 2
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load typed i32 $cond__1
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : f64
  slot $h : obj<8x8>

  block ^entry:
    store typed f64 2, $x
    %t1 = addr $h
    %t2 = addr $x
    call void @holder__holder(%t1, %t2)
    %t3 = addr $h
    %t4 = index i8 [projection=field] %t3, 0
    %t5 = load typed ptr %t4
    %t6 = load typed f64 %t5
    %t7 = call i32 @take(%t6)
    return i32 %t7
}
function @holder__holder(%this : ptr [object_bytes=8], %x : ptr [pass=by_address, object_bytes=8]) -> void [binding=weak, object=_ZN6holderC1EOd, inline_hint=yes] {
  slot $this : ptr
  slot $x : ptr

  block ^entry:
    store typed ptr %this, $this
    store typed ptr %x, $x
    %t1 = load typed ptr $x
    %t2 = load typed ptr $this
    %t3 = index i8 [projection=field] %t2, 0
    store typed ptr %t1, %t3
    return void
}
alias object _ZN6holderC2EOd = @holder__holder
