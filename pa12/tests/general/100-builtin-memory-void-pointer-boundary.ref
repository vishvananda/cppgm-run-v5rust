declare function @__builtin_memcpy(%arg0 : ptr [alias=noalias], %arg1 : ptr [alias=noalias], %arg2 : i64) -> ptr [unwind=no, binding=strong, object=cppgm_builtin_memcpy]
declare function @__builtin_memmove(%arg0 : ptr, %arg1 : ptr, %arg2 : i64) -> ptr [unwind=no, binding=strong, object=cppgm_builtin_memmove]

function @copy(%dst : ptr, %src : ptr) -> void [binding=strong, object=_Z4copyPvPKv] {
  slot $dst : ptr
  slot $src : ptr

  block ^entry:
    store typed ptr %dst, $dst
    store typed ptr %src, $src
    %t1 = load typed ptr $dst
    %t2 = load typed ptr $src
    %t3 = convert sext i64 i32 258
    %t4 = call ptr @__builtin_memcpy(%t1, %t2, %t3)
    %t5 = load typed ptr $dst
    %t6 = load typed ptr $src
    %t7 = convert sext i64 i32 258
    %t8 = call ptr @__builtin_memmove(%t5, %t6, %t7)
    return void
}
