function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $store : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $store
    %t2 = addr $store
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = index i8 [projection=field] %t3, 0
    store i32 7, %t4
    %t5 = addr $store
    %t6 = call i32 @Store__get(%t5)
    %t7 = cmp eq i32 %t6, 7
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load typed i32 $cond__1
    return i32 %t8
}
function @Store__get(%this : ptr [object_bytes=4]) -> i32 [binding=weak, object=_ZN5Store3getEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load i32 %t2
    return i32 %t3
}
