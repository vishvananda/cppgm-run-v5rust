    %t10 = cmp eq i32 %t9, 0
    %t11 = cmp ne i64 %t10, 0
    store typed i64 %t11, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t12 = load typed i64 $land__2
    branch %t12, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t13 = load typed i32 $cond__1
    return i32 %t13
}
function @A__A__aggregate(%this : ptr [object_bytes=12], %x : i32) -> void [unwind=no, binding=internal] {
  slot $this : ptr
  slot $x : i32

  block ^entry:
    store typed ptr %this, $this
