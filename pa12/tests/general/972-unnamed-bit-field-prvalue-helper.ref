function @make(%x : i32) -> obj<12x4> [binding=strong, object=_Z4makei] {
  slot $x : i32
  slot $retobj__1 : obj<12x4>

  block ^entry:
    store typed i32 %x, $x
    %t1 = addr $retobj__1
    %t2 = load typed i32 $x
    call void @A__A__aggregate(%t1, %t2)
    return obj<12x4> $retobj__1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<12x4>
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr $a
    %t2 = call obj<12x4> @make(7)
    copyobj 12x4 %t2, %t1
    %t3 = addr $a
    %t4 = index i8 [projection=field] %t3, 4
    %t5 = load typed i32 %t4
    %t6 = cmp eq i32 %t5, 7
    branch %t6, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t7 = addr $a
