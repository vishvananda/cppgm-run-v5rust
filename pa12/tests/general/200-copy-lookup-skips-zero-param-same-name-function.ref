function @pass(%value : ptr [pass=by_address, object_bytes=1]) -> obj<1x1> [result_classes=none, binding=strong, object=_Z4passO1A] {
  slot $value : ptr
  slot $retobj__1 : obj<1x1>

  block ^entry:
    store typed ptr %value, $value
    %t1 = addr $retobj__1
    %t2 = load typed ptr $value
    return obj<1x1> $retobj__1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<1x1>
  slot $discard__1 : obj<1x1>

  block ^entry:
    %t1 = addr $value
    %t2 = addr $discard__1
    %t3 = addr $value
    %t4 = call obj<1x1> @pass(%t3)
