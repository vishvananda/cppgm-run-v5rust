function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $tmpobj__1 : obj<1x1>

  block ^entry:
    %t1 = addr $tmpobj__1
    zeroinit 1x1 %t1
    %t2 = call i32 @X__f__ov2(%t1)
    %t3 = binary sub nowrap i32 %t2, 2
    return i32 %t3
}
function @X__f__ov2(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZNO1X1fEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i32 2
}
