    %t33 = load typed ptr $aggregate
    %t34 = index i8 [projection=field] %t33, 8
    %t35 = load typed i32 %t34
    %t36 = cmp ne i32 %t35, 8
    branch %t36, ^if_then_6, ^if_else_7

  block ^if_then_6:
