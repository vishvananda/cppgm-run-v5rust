function @operatornew__ov2(%__param0 : i64, %place : ptr) -> ptr [unwind=no, binding=weak, object=_ZnwmPv, inline_hint=yes] {
  slot $__param0 : i64
  slot $place : ptr

  block ^entry:
    store typed i64 %__param0, $__param0
    store typed ptr %place, $place
