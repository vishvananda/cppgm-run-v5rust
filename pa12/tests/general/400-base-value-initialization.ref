}

function @fill() -> void [binding=strong, object=_Z4fillv] {
  slot $i : u32

  block ^entry:
    store typed u32 0, $i
    jump ^for_cond_1

  block ^for_cond_1:
    %t1 = load typed u32 $i
    %t2 = const i64 32
    %t3 = convert zext i64 u32 %t1
    %t4 = cmp ult i64 %t3, %t2
    branch %t4, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t5 = addr @buffer
    %t6 = load typed u32 $i
    %t7 = index u8 [projection=array_element] %t5, %t6
    store u8 85, %t7
    jump ^for_iter_3

  block ^for_iter_3:
    %t8 = load typed u32 $i
    %t9 = binary add u32 %t8, 1
    store typed u32 %t9, $i
    jump ^for_cond_1

  block ^for_end_4:
    return void
}
