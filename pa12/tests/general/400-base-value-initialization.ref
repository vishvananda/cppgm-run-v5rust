    %t26 = load typed i32 %t25
    %t27 = cmp ne i32 %t26, 0
    branch %t27, ^if_then_6, ^lor_rhs_9

  block ^lor_rhs_9:
    %t28 = load typed ptr $aggregate
    %t29 = index i8 %t28, 0
