function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<4x4>

  block ^entry:
    %t1 = addr $value
    %t2 = addr $value
    %t3 = index i8 [projection=field] %t2, 0
    store i32 7, %t3
    %t4 = addr $value
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load i32 %t5
    %t7 = cmp ne i32 %t6, 7
    %t8 = convert trunc i32 i64 %t7
    return i32 %t8
}
