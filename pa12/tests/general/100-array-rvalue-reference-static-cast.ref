global @__strlit__1 [storage=readonly, binding=internal] = {
  i8 120
  i8 0
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr @__strlit__1
    store typed ptr %t1, $value
    %t2 = load typed ptr $value
    %t3 = index i8 [projection=array_element] %t2, 0
    %t4 = load i8 %t3
    %t5 = convert sext i32 i8 %t4
    %t6 = cmp eq i32 %t5, 120
    branch %t6, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t7 = load typed i32 $cond__1
    return i32 %t7
}
