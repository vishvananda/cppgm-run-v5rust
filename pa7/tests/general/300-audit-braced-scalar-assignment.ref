translation-unit
  function-definition f function of (int, pointer to int, bool) returning void
    parameter x int
    parameter p pointer to int
    parameter b bool
    compound-statement
      expression-statement
        assignment-expression lvalue int OP_ASS:=
          id-expression lvalue int x
          braced-init-list lvalue int
            literal prvalue int 3
      expression-statement
        assignment-expression lvalue int OP_ASS:=
          id-expression lvalue int x
          braced-init-list lvalue int
      expression-statement
        assignment-expression lvalue pointer to int OP_ASS:=
          id-expression lvalue pointer to int p
          braced-init-list lvalue pointer to int
            literal prvalue pointer to int 0
      expression-statement
        assignment-expression lvalue pointer to int OP_ASS:=
          id-expression lvalue pointer to int p
          braced-init-list lvalue pointer to int
      expression-statement
        assignment-expression lvalue bool OP_ASS:=
          id-expression lvalue bool b
          braced-init-list lvalue bool
            literal prvalue bool KW_TRUE:true
end translation unit
