    %t2 = load typed ptr $this
    %t3 = index i8 [projection=field] %t2, 0
    store typed i32 %t1, %t3
    return void
}
function @wrap_longint___wrap(%this : ptr [object_bytes=4], %other : ptr [pass=by_address, object_bytes=4]) -> void [binding=weak, object=_ZN4wrapIlEC1IiEERKS_IT_E, inline_hint=yes] {
