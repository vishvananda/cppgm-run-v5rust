function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $src : obj<4x4>
  slot $dst : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $src
    call void @wrap_int___wrap(%t1, 3)
    %t2 = addr $dst
    %t3 = addr $src
    call void @wrap_longint___wrap(%t2, %t3)
    %t4 = addr $dst
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load typed i32 %t5
    %t7 = cmp eq i32 %t6, 13
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load typed i32 $cond__1
    return i32 %t8
}
function @wrap_int___wrap(%this : ptr [object_bytes=4], %v : i32) -> void [binding=weak, object=_ZN4wrapIiEC1Ei, inline_hint=yes] {
