    %t1 = load typed ptr $other
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load typed i32 %t2
    %t4 = binary add nowrap i32 %t3, 10
    %t5 = load typed ptr $this
    %t6 = index i8 [projection=field] %t5, 0
    store typed i32 %t4, %t6
