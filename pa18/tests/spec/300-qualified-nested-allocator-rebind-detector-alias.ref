function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<1x1>
  slot $expected : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $value
    %t2 = addr $value
    store typed ptr %t2, $expected
    %t3 = load typed ptr $expected
    %t4 = addr $value
    %t5 = cmp eq ptr %t3, %t4
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t6 = load typed i32 $cond__1
    return i32 %t6
}
