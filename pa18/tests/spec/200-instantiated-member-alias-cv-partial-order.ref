function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $s : obj<1x1>
  slot $p : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $s
    store typed ptr 0, $p
    %t2 = const i64 4
    %t3 = const i64 4
    %t4 = cmp eq i64 %t2, %t3
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load typed i32 $cond__1
    return i32 %t5
}
