function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : i32
  slot $pointer : ptr
  slot $cond__1 : i32

  block ^entry:
    store typed i32 0, $value
    %t1 = addr $value
    store typed ptr %t1, $pointer
    %t2 = load typed ptr $pointer
    %t3 = call ptr @address(%t2)
    %t4 = addr $value
    %t5 = cmp eq ptr %t3, %t4
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t6 = load typed i32 $cond__1
    return i32 %t6
}
function @address(%pointer : ptr) -> ptr [binding=weak, object=_Z7addressIiEPT_S1_] {
  slot $pointer : ptr

  block ^entry:
    store typed ptr %pointer, $pointer
    %t1 = load typed ptr $pointer
    return ptr %t1
}
