1 translation units
start translation unit 1
translation-unit
  scope namespace <global>
    type-alias LRI lvalue-reference to int
    type-alias RRI rvalue-reference to int
    function f function of (lvalue-reference to int, lvalue-reference to int, lvalue-reference to int, lvalue-reference to int, rvalue-reference to int) returning void
    type-alias LRR lvalue-reference to int
    type-alias RRL lvalue-reference to int
    type-alias RRR rvalue-reference to int
    variable a lvalue-reference to int
    variable b lvalue-reference to int
    variable c rvalue-reference to int
end translation unit
