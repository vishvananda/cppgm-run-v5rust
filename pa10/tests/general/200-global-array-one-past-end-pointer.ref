global @data : obj<800x8> [binding=strong] = {
  zero 800
}
global @dpa : ptr [binding=strong] = addr @data
global @dpb : ptr [binding=strong] = addr @data + 800

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = load typed ptr @dpb
    %t2 = load typed ptr @dpa
    %t3 = binary sub ptr %t1, %t2
    %t4 = binary shr exact i64 %t3, 3
    %t5 = cmp eq i64 %t4, 100
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t6 = load typed i32 $cond__1
    return i32 %t6
}
