function @forever() -> i32 [binding=strong, object=_Z7foreverv] {
  block ^entry:
    jump ^while_cond_1

  block ^while_cond_1:
    %t1 = cmp eq i32 1, 1
    branch %t1, ^while_body_2, ^while_end_3

  block ^while_body_2:
    jump ^while_cond_1

  block ^while_end_3:
    unreachable
}
function @constant_return() -> i32 [binding=strong, object=_Z15constant_returnv] {
  block ^entry:
    %t1 = binary add nowrap i32 1, 2
    %t2 = binary mul nowrap i32 %t1, 3
    %t3 = cmp eq i32 %t2, 9
    branch %t3, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 4

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    unreachable
}
function @label_return() -> i32 [binding=strong, object=_Z12label_returnv] {
  block ^entry:
    jump ^goto_1

  block ^unreachable_4:
    jump ^if_else_3

  block ^if_then_2:
    jump ^goto_1

  block ^goto_1:
    return i32 5

  block ^if_else_3:
    jump ^if_end_5

  block ^if_end_5:
    unreachable
}
function @maybe_value(%enabled : u8) -> i32 [binding=strong, object=_Z11maybe_valueb] {
  slot $enabled : u8

  block ^entry:
    store u8 %enabled, $enabled
    %t1 = load u8 $enabled
    branch %t1, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    unreachable
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @constant_return()
    %t2 = call i32 @label_return()
    %t3 = binary add nowrap i32 %t1, %t2
    %t4 = call i32 @maybe_value(1)
    %t5 = binary add nowrap i32 %t3, %t4
    %t6 = binary sub nowrap i32 %t5, 10
    return i32 %t6
}
