function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $e : i32
  slot $cond__1 : i32

  block ^entry:
    store typed i32 0, $e
    store typed i32 0, $e
    %t1 = load typed i32 $e
    %t2 = cmp eq i32 %t1, 0
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load typed i32 $cond__1
    return i32 %t3
}
