global @t5 : i32 [binding=strong] = 5

function @use(%t3 : i32, %other : i32) -> i32 [binding=strong, object=_Z3useii] {
  slot $t3 : i32
  slot $other : i32
  slot $t7 : i32
  slot $adjustment : i32
  slot $t2 : i32

  block ^entry:
    store typed i32 %t3, $t3
    store typed i32 %other, $other
    %t1 = load typed i32 $t3
    %t4 = load typed i32 $other
    %t5 = binary add nowrap i32 %t1, %t4
    store typed i32 %t5, $t7
    store typed i32 2, $adjustment
    %t6 = load typed i32 $t7
    %t8 = cmp gt i32 %t6, 3
    branch %t8, ^if_then_1, ^if_else_2

  block ^if_then_1:
    %t9 = load typed i32 $t7
    %t10 = load typed i32 @t5
    %t11 = binary add nowrap i32 %t9, %t10
    store typed i32 %t11, $t7
    jump ^if_end_3

  block ^if_else_2:
    %t12 = load typed i32 $t7
    %t13 = load typed i32 $adjustment
    %t14 = binary sub nowrap i32 %t12, %t13
    store typed i32 %t14, $t7
    jump ^if_end_3

  block ^if_end_3:
    store typed i32 0, $t2
    jump ^for_cond_4

  block ^for_cond_4:
    %t15 = load typed i32 $t2
    %t16 = cmp lt i32 %t15, 3
    branch %t16, ^for_body_5, ^for_end_7

  block ^for_body_5:
    %t17 = load typed i32 $t7
    %t18 = load typed i32 $t2
    %t19 = binary add nowrap i32 %t17, %t18
    store typed i32 %t19, $t7
    jump ^for_iter_6

  block ^for_iter_6:
    %t20 = load typed i32 $t2
    %t21 = binary add nowrap i32 %t20, 1
    store typed i32 %t21, $t2
    jump ^for_cond_4

  block ^for_end_7:
    %t22 = load typed i32 $t7
    return i32 %t22
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call i32 @use(2, 2)
    %t2 = cmp eq i32 %t1, 12
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load typed i32 $cond__1
    return i32 %t3
}
