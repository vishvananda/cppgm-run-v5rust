global @full [storage=readonly, binding=internal, object=_ZL4full] = {
  i8 1
  zero 3
  i32 2
  i32 3
  zero 4
  f64 4.5
  i32 6
  i32 0
}
global @empty [storage=readonly, binding=internal, object=_ZL5empty] = {
  zero 16
  f64 0
  i32 0
  i32 0
}
global @value : i32 [binding=strong] = 9
global @alias [storage=readonly, binding=internal, object=_ZL5alias] = {
  ptr addr @value
}
global @overlay : obj<8x8> [binding=strong] = {
  i32 4
  i32 5
}

function @read(%object : ptr) -> i32 [binding=strong, object=_Z4readP6Access] {
  slot $object : ptr

  block ^entry:
    store typed ptr %object, $object
    %t1 = load typed ptr $object
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load volatile i32 %t2
    %t4 = load typed ptr $object
    %t5 = index i8 [projection=field] %t4, 4
    %t6 = load typed i32 %t5
    %t7 = binary add nowrap i32 %t3, %t6
    return i32 %t7
}
function @quiet(%object : ptr [pass=by_address, object_bytes=8]) -> i32 [binding=strong, object=_Z5quietRK4Pair] {
  slot $object : ptr

  block ^entry:
    store typed ptr %object, $object
    return i32 0
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = addr @overlay
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = index i32 [projection=array_element] %t2, 0
    %t4 = load i32 %t3
    %t5 = binary add nowrap i32 %t4, 1
    store i32 %t5, %t3
    %t6 = addr @full
    %t7 = index i8 [projection=field] %t6, 4
    %t8 = index i8 [projection=field] %t7, 4
    %t9 = load typed i32 %t8
    %t10 = addr @full
    %t11 = index i8 [projection=field] %t10, 24
    %t12 = index i32 [projection=array_element] %t11, 1
    %t13 = load typed i32 %t12
    %t14 = binary add nowrap i32 %t9, %t13
    %t15 = addr @empty
    %t16 = index i8 [projection=field] %t15, 0
    %t17 = load i8 %t16
    %t18 = convert sext i32 i8 %t17
    %t19 = binary add nowrap i32 %t14, %t18
    %t20 = addr @alias
    %t21 = index i8 [projection=field] %t20, 0
    %t22 = load typed ptr %t21
    %t23 = load typed i32 %t22
    %t24 = binary add nowrap i32 %t19, %t23
    %t25 = addr @overlay
    %t26 = index i8 [projection=field] %t25, 0
    %t27 = index i32 [projection=array_element] %t26, 0
    %t28 = load i32 %t27
    %t29 = binary add nowrap i32 %t24, %t28
    return i32 %t29
}
