global @object : i32 [binding=strong] = zero
global @function_address : ptr [binding=strong] = addr @target
global @object_address : ptr [binding=strong] = addr @object

function @target() -> void [binding=strong, object=_Z6targetv] {
  block ^entry:
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = load typed ptr @function_address
    %t2 = cmp ne ptr %t1, 0
    branch %t2, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t3 = load typed ptr @object_address
    %t4 = addr @object
    %t5 = cmp eq ptr %t3, %t4
    %t6 = cmp ne i64 %t5, 0
    store typed i64 %t6, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t7 = load typed i64 $land__2
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load typed i32 $cond__1
    return i32 %t8
}
