function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $direct : obj<4x1>
  slot $nested : obj<4x1>

  block ^entry:
    %t1 = addr $direct
    store i8 97, %t1
    %t2 = index i8 %t1, 1
    store i8 98, %t2
    %t3 = index i8 %t1, 2
    store i8 99, %t3
    %t4 = index i8 %t1, 3
    store i8 0, %t4
    %t5 = addr $nested
    store i8 120, %t5
    %t6 = index i8 %t5, 1
    store i8 121, %t6
    %t7 = index i8 %t5, 2
    store i8 122, %t7
    %t8 = index i8 %t5, 3
    store i8 0, %t8
    %t9 = addr $direct
    %t10 = index i8 [projection=array_element] %t9, 1
    %t11 = load i8 %t10
    %t12 = addr $nested
    %t13 = index i8 [projection=array_element] %t12, 2
    %t14 = load i8 %t13
    %t15 = convert sext i32 i8 %t11
    %t16 = convert sext i32 i8 %t14
    %t17 = binary add nowrap i32 %t15, %t16
    %t18 = binary sub nowrap i32 %t17, 98
    %t19 = binary sub nowrap i32 %t18, 122
    return i32 %t19
}
