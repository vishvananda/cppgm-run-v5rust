global @side : i32 [binding=strong] = zero

function @pick(%values : ptr, %index : i32) -> ptr [binding=strong, object=_Z4pickPii] {
  slot $values : ptr
  slot $index : i32

  block ^entry:
    store typed ptr %values, $values
    store typed i32 %index, $index
    %t1 = load typed i32 $index
    store typed i32 %t1, @side
    %t2 = load typed ptr $values
    %t3 = load typed i32 $index
    %t4 = index i32 [projection=array_element] %t2, %t3
    return ptr %t4
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<8x4>
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64

  block ^entry:
    %t1 = addr $values
    %t2 = index i32 [projection=array_element] %t1, 0
    store typed i32 3, %t2
    %t3 = addr $values
    %t4 = index i32 [projection=array_element] %t3, 1
    store typed i32 5, %t4
    %t5 = addr $values
    %t6 = call ptr @pick(%t5, 1)
    store typed i32 9, %t6
    %t7 = addr $values
    %t8 = index i32 [projection=array_element] %t7, 0
    %t9 = load typed i32 %t8
    %t10 = cmp eq i32 %t9, 3
    branch %t10, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t11 = addr $values
    %t12 = index i32 [projection=array_element] %t11, 1
    %t13 = load typed i32 %t12
    %t14 = cmp eq i32 %t13, 9
    %t15 = cmp ne i64 %t14, 0
    store typed i64 %t15, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t16 = load typed i64 $land__2
    branch %t16, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t17 = load typed i32 @side
    %t18 = cmp eq i32 %t17, 1
    %t19 = cmp ne i64 %t18, 0
    store typed i64 %t19, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t20 = load typed i64 $land__3
    branch %t20, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t21 = load typed i32 $cond__1
    return i32 %t21
}
