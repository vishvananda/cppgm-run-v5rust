global @text [storage=readonly, binding=internal, object=_ZL4text] = {
  i8 65
  i8 0
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = addr @text
    %t2 = index i8 [projection=array_element] %t1, 0
    %t3 = load i8 %t2
    %t4 = convert sext i32 i8 %t3
    %t5 = binary sub nowrap i32 %t4, 65
    return i32 %t5
}
