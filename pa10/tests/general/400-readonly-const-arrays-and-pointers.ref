global @scalar : i32 [storage=readonly, binding=internal, object=_ZL6scalar] = 3
global @table [storage=readonly, binding=internal, object=_ZL5table] = {
  i32 1
  i32 2
  i32 3
  i32 4
}
global @matrix [storage=readonly, binding=internal, object=_ZL6matrix] = {
  i32 5
  i32 6
  i32 7
  i32 8
}
global @__strlit__1 [storage=readonly, binding=internal] = {
  i8 97
  i8 0
}
global @__strlit__2 [storage=readonly, binding=internal] = {
  i8 98
  i8 99
  i8 0
}
global @names [storage=readonly, binding=internal, object=_ZL5names] = {
  ptr addr @__strlit__1
  ptr addr @__strlit__2
}
global @fixed_pointer : ptr [storage=readonly, binding=internal, object=_ZL13fixed_pointer] = 0
global @__strlit__3 [storage=readonly, binding=internal] = {
  i8 100
  i8 0
}
global @movable_pointer : ptr [binding=strong] = addr @__strlit__3
global @volatile_scalar : i32 [binding=internal, object=_ZL15volatile_scalar] = 9
global @single_table [storage=readonly, binding=internal, object=_ZL12single_table] = {
  i32 10
}
global @writable_table [binding=strong] = {
  i32 12
  i32 13
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $sum : i32
  slot $cond__1 : i32
  slot $cond__2 : i32

  block ^entry:
    %t1 = load typed i32 @scalar
    %t2 = addr @table
    %t3 = index i32 [projection=array_element] %t2, 3
    %t4 = load typed i32 %t3
    %t5 = binary add nowrap i32 %t1, %t4
    %t6 = addr @matrix
    %t7 = binary mul i64 1, 8
    %t8 = index i8 [projection=array_element] %t6, %t7
    %t9 = index i32 [projection=array_element] %t8, 1
    %t10 = load typed i32 %t9
    %t11 = binary add nowrap i32 %t5, %t10
    %t12 = addr @names
    %t13 = index ptr [projection=array_element] %t12, 1
    %t14 = load typed ptr %t13
    %t15 = index i8 [projection=array_element] %t14, 1
    %t16 = load i8 %t15
    %t17 = convert sext i32 i8 %t16
    %t18 = binary add nowrap i32 %t11, %t17
    %t19 = load typed ptr @fixed_pointer
    branch %t19, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t20 = load typed i32 $cond__1
    %t21 = binary add nowrap i32 %t18, %t20
    %t22 = load typed ptr @movable_pointer
    %t23 = index i8 [projection=array_element] %t22, 0
    %t24 = load i8 %t23
    %t25 = convert sext i32 i8 %t24
    %t26 = binary add nowrap i32 %t21, %t25
    %t27 = load volatile i32 @volatile_scalar
    %t28 = binary add nowrap i32 %t26, %t27
    %t29 = addr @single_table
    %t30 = index i32 [projection=array_element] %t29, 0
    %t31 = load typed i32 %t30
    %t32 = binary add nowrap i32 %t28, %t31
    %t33 = addr @writable_table
    %t34 = index i32 [projection=array_element] %t33, 1
    %t35 = load typed i32 %t34
    %t36 = binary add nowrap i32 %t32, %t35
    store typed i32 %t36, $sum
    %t37 = load typed i32 $sum
    %t38 = binary add nowrap i32 3, 4
    %t39 = binary add nowrap i32 %t38, 8
    %t40 = binary add nowrap i32 %t39, 99
    %t41 = binary add nowrap i32 %t40, 0
    %t42 = binary add nowrap i32 %t41, 100
    %t43 = binary add nowrap i32 %t42, 9
    %t44 = binary add nowrap i32 %t43, 10
    %t45 = binary add nowrap i32 %t44, 13
    %t46 = cmp eq i32 %t37, %t45
    branch %t46, ^cond_then_4, ^cond_else_5

  block ^cond_then_4:
    store typed i32 0, $cond__2
    jump ^cond_end_6

  block ^cond_else_5:
    store typed i32 1, $cond__2
    jump ^cond_end_6

  block ^cond_end_6:
    %t47 = load typed i32 $cond__2
    return i32 %t47
}
