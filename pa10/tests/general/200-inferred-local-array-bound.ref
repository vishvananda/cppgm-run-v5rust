global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i32 1
  i32 2
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<8x4>

  block ^entry:
    %t1 = addr $values
    copyobj 8x4 @__constexpr_template__1, %t1
    %t2 = const i64 8
    %t3 = const i64 4
    %t4 = convert sext i64 i32 2
    %t5 = binary mul i64 %t4, %t3
    %t6 = binary sub i64 %t2, %t5
    %t7 = convert trunc i32 i64 %t6
    return i32 %t7
}
