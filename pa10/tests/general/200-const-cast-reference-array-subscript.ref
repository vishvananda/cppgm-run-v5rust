global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i8 1
  i8 0
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $data : obj<2x1>
  slot $r : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $data
    copyobj 2x1 @__constexpr_template__1, %t1
    %t2 = addr $data
    %t3 = index i8 [projection=array_element] %t2, 0
    store typed ptr %t3, $r
    %t4 = load typed ptr $r
    %t5 = load i8 %t4
    %t6 = convert sext i32 i8 %t5
    %t7 = cmp eq i32 %t6, 1
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load typed i32 $cond__1
    return i32 %t8
}
