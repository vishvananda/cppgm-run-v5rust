declare function @consume(%arg0 : ptr [pass=by_address, object_bytes=4]) -> i32 [linkage=c, binding=strong]

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : i32

  block ^entry:
    store typed i32 1, $value
    %t1 = addr $value
    %t2 = call i32 @consume(%t1)
    return i32 %t2
}
