function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $f : u16
  slot $cond__1 : i32

  block ^entry:
    store typed u16 2, $f
    %t1 = load typed u16 $f
    %t2 = convert zext i32 u16 %t1
    %t3 = cmp eq i32 %t2, 2
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load typed i32 $cond__1
    return i32 %t4
}
