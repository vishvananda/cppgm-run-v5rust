function @f() -> i32 [binding=strong, object=_Z1fv] {
  slot $a : obj<12x4>

  block ^entry:
    %t1 = addr $a
    %t2 = index i32 [projection=array_element] %t1, 1
    store typed i32 5, %t2
    %t3 = addr $a
    %t4 = index i32 [projection=array_element] %t3, 1
    %t5 = load typed i32 %t4
    %t6 = const i64 12
    %t7 = convert sext i64 i32 %t5
    %t8 = binary add i64 %t7, %t6
    %t9 = convert trunc i32 i64 %t8
    return i32 %t9
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @f()
    return i32 %t1
}
