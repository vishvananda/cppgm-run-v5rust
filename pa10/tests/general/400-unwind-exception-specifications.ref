function @bare_noexcept(%x : i32) -> i32 [unwind=no, binding=strong, object=_Z13bare_noexcepti] {
  slot $x : i32

  block ^entry:
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    %t2 = binary add nowrap i32 %t1, 1
    return i32 %t2
}
