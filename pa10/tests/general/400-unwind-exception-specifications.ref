function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call i32 @bare_noexcept(0)
    %t2 = call i32 @true_noexcept(0)
    %t3 = binary add nowrap i32 %t1, %t2
    %t4 = call i32 @empty_throw(0)
    %t5 = binary add nowrap i32 %t3, %t4
    %t6 = call i32 @false_noexcept(0)
    %t7 = binary add nowrap i32 %t5, %t6
    %t8 = call i32 @typed_throw(0)
    %t9 = binary add nowrap i32 %t7, %t8
    %t10 = call i32 @plain(0)
    %t11 = binary add nowrap i32 %t9, %t10
    %t12 = cmp eq i32 %t11, 21
    branch %t12, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t13 = load typed i32 $cond__1
    return i32 %t13
}
