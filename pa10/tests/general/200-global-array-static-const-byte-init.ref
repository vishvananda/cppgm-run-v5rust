global @syntax_char : u8 [storage=readonly, binding=internal, object=_ZL11syntax_char] = 0
global @syntax_newline : u8 [storage=readonly, binding=internal, object=_ZL14syntax_newline] = 26
global @char_syntax [binding=internal, object=_ZL11char_syntax] = {
  u8 0
  u8 26
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr @char_syntax
    %t2 = index u8 [projection=array_element] %t1, 0
    %t3 = load u8 %t2
    %t4 = convert zext i32 u8 %t3
    %t5 = cmp eq i32 %t4, 0
    branch %t5, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t6 = addr @char_syntax
    %t7 = index u8 [projection=array_element] %t6, 1
    %t8 = load u8 %t7
    %t9 = convert zext i32 u8 %t8
    %t10 = cmp eq i32 %t9, 26
    %t11 = cmp ne i64 %t10, 0
    store typed i64 %t11, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t12 = load typed i64 $land__2
    branch %t12, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t13 = load typed i32 $cond__1
    return i32 %t13
}
