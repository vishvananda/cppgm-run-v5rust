function @g(%x : i32) -> i32 [binding=strong, object=_Z1gi] {
  slot $x : i32

  block ^entry:
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    %t2 = binary add nowrap i32 %t1, 1
    return i32 %t2
}
function @call(%fp : ptr) -> i32 [binding=strong, object=_Z4callPFiiE] {
  slot $fp : ptr

  block ^entry:
    store typed ptr %fp, $fp
    %t1 = load typed ptr $fp
    %t2 = call i32 %t1(4) as (%arg0 : i32) -> i32
    return i32 %t2
}
function @invoke(%rf : ptr [pass=by_address], %x : i32) -> i32 [binding=strong, object=_Z6invokeRFiiEi] {
  slot $rf : ptr
  slot $x : i32

  block ^entry:
    store typed ptr %rf, $rf
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    %t2 = load typed ptr $rf
    %t3 = call i32 %t2(%t1) as (%arg0 : i32) -> i32
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = addr @g
    %t2 = call i32 @call(%t1)
    %t3 = addr @g
    %t4 = call i32 @invoke(%t3, 1)
    %t5 = binary add nowrap i32 %t2, %t4
    return i32 %t5
}
