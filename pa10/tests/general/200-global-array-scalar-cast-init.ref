global @escaped [storage=readonly, binding=internal, object=_ZL7escaped] = {
  i8 40
  i8 63
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr @escaped
    %t2 = index i8 [projection=array_element] %t1, 0
    %t3 = load i8 %t2
    %t4 = convert sext i32 i8 %t3
    %t5 = cmp eq i32 %t4, 40
    branch %t5, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t6 = addr @escaped
    %t7 = index i8 [projection=array_element] %t6, 1
    %t8 = load i8 %t7
    %t9 = convert sext i32 i8 %t8
    %t10 = cmp eq i32 %t9, 63
    %t11 = cmp ne i64 %t10, 0
    store typed i64 %t11, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t12 = load typed i64 $land__2
    branch %t12, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t13 = load typed i32 $cond__1
    return i32 %t13
}
