global @default_value : i32 [binding=strong] = 99

function @library__read(%value : i32) -> i32 [binding=strong, object=_ZN7library4readEi] {
  slot $value : i32

  block ^entry:
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    return i32 %t1
}
