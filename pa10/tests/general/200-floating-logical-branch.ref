function @both(%lhs : f64, %rhs : i32) -> u8 [binding=strong, object=_Z4bothdi] {
  slot $lhs : f64
  slot $rhs : i32
  slot $land__1 : i64

  block ^entry:
    store typed f64 %lhs, $lhs
    store typed i32 %rhs, $rhs
    %t1 = load typed f64 $lhs
    %t2 = cmp ne f64 %t1, 0
    branch %t2, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t3 = load typed i32 $rhs
    %t4 = cmp ne i64 %t3, 0
    store typed i64 %t4, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t5 = load typed i64 $land__1
    %t6 = convert trunc u8 i64 %t5
    return u8 %t6
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $guard : i32
  slot $cond__1 : i32

  block ^entry:
    store typed i32 0, $guard
    %t1 = cmp ne f64 0, 0
    branch %t1, ^land_rhs_3, ^if_else_2

  block ^land_rhs_3:
    %t2 = load typed i32 $guard
    %t3 = binary add nowrap i32 %t2, 1
    store typed i32 %t3, $guard
    branch %t3, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_4

  block ^if_end_4:
    %t4 = call u8 @both(2.0, 1)
    %t5 = cmp eq u8 %t4, 0
    branch %t5, ^if_then_5, ^if_else_6

  block ^if_then_5:
    return i32 2

  block ^if_else_6:
    jump ^if_end_7

  block ^if_end_7:
    %t6 = load typed i32 $guard
    %t7 = cmp eq i32 %t6, 0
    branch %t7, ^cond_then_8, ^cond_else_9

  block ^cond_then_8:
    store typed i32 0, $cond__1
    jump ^cond_end_10

  block ^cond_else_9:
    store typed i32 3, $cond__1
    jump ^cond_end_10

  block ^cond_end_10:
    %t8 = load typed i32 $cond__1
    return i32 %t8
}
