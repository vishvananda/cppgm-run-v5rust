function @identity(%x : i32) -> i32 [binding=strong, object=_Z8identityi] {
  slot $x : i32

  block ^entry:
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    return i32 %t1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $first : i64
  slot $second : i64
  slot $third : i64

  block ^entry:
    store typed i64 3, $first
    %t1 = convert sext i64 i32 4
    store typed i64 %t1, $second
    store typed i64 5, $third
    %t2 = load typed i64 $first
    %t3 = load typed i64 $second
    %t4 = copy i64 %t2
    %t5 = binary add i64 %t4, %t3
    %t6 = load typed i64 $third
    %t7 = copy i64 %t6
    %t8 = binary add i64 %t5, %t7
    %t9 = convert trunc i32 i64 %t8
    %t10 = call i32 @identity(%t9)
    return i32 %t10
}
