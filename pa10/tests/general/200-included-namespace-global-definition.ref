global @inc__counter : i64 [binding=strong, object=_ZN3inc7counterE] = 0

function @inc__touch() -> i32 [binding=strong, object=_ZN3inc5touchEv] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = convert sext i64 i32 7
    store volatile i64 %t1, @inc__counter
    %t2 = load volatile i64 @inc__counter
    %t3 = convert sext i64 i32 7
    %t4 = cmp eq i64 %t2, %t3
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load typed i32 $cond__1
    return i32 %t5
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @inc__touch()
    return i32 %t1
}
