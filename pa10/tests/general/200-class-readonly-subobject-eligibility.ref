global @ordinary [storage=readonly, binding=internal, object=_ZL8ordinary] = {
  i32 1
}
global @changeable [binding=internal, object=_ZL10changeable] = {
  i32 2
}
global @observable [binding=internal, object=_ZL10observable] = {
  i32 3
}
global @nested [binding=internal, object=_ZL6nested] = {
  i32 4
  i32 5
  i32 6
}
global @target : i32 [binding=strong] = 7
global @reference [storage=readonly, binding=internal, object=_ZL9reference] = {
  ptr addr @target
}
global @pointer [storage=readonly, binding=internal, object=_ZL7pointer] = {
  ptr addr @target
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = addr @changeable
    %t2 = index i8 [projection=field] %t1, 0
    store typed i32 8, %t2
    %t3 = addr @ordinary
    %t4 = index i8 [projection=field] %t3, 0
    %t5 = load typed i32 %t4
    %t6 = addr @changeable
    %t7 = index i8 [projection=field] %t6, 0
    %t8 = load typed i32 %t7
    %t9 = binary add nowrap i32 %t5, %t8
    %t10 = addr @observable
    %t11 = index i8 [projection=field] %t10, 0
    %t12 = load volatile i32 %t11
    %t13 = binary add nowrap i32 %t9, %t12
    %t14 = addr @nested
    %t15 = index i8 [projection=field] %t14, 0
    %t16 = binary mul i64 1, 4
    %t17 = index i8 [projection=array_element] %t15, %t16
    %t18 = index i8 [projection=field] %t17, 0
    %t19 = load volatile i32 %t18
    %t20 = binary add nowrap i32 %t13, %t19
    %t21 = addr @reference
    %t22 = index i8 [projection=field] %t21, 0
    %t23 = load typed ptr %t22
    %t24 = load volatile i32 %t23
    %t25 = binary add nowrap i32 %t20, %t24
    %t26 = addr @pointer
    %t27 = index i8 [projection=field] %t26, 0
    %t28 = load typed ptr %t27
    %t29 = load volatile i32 %t28
    %t30 = binary add nowrap i32 %t25, %t29
    return i32 %t30
}
