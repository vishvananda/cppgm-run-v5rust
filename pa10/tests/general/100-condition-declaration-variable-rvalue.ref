function @f(%p : ptr) -> i32 [binding=strong, object=_Z1fPKh] {
  slot $p : ptr
  slot $n : i32
  slot $c : u8

  block ^entry:
    store typed ptr %p, $p
    store typed i32 0, $n
    jump ^while_cond_1

  block ^while_cond_1:
    %t1 = load typed ptr $p
    %t2 = index i8 %t1, 1
    store typed ptr %t2, $p
    %t3 = load u8 %t1
    store u8 %t3, $c
    %t4 = load u8 $c
    branch %t4, ^while_body_2, ^while_end_3

  block ^while_body_2:
    %t5 = load u8 $c
    %t6 = convert zext i32 u8 %t5
    %t7 = load typed i32 $n
    %t8 = binary add nowrap i32 %t7, %t6
    store typed i32 %t8, $n
    jump ^while_cond_1

  block ^while_end_3:
    %t9 = load typed i32 $n
    return i32 %t9
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    return i32 0
}
