function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : i32

  block ^entry:
    store typed i32 1, $x
    %t1 = addr $x
    %t2 = call ptr @lvalue(%t1)
    store typed i32 2, %t2
    %t3 = addr $x
    %t4 = call ptr @pointer(%t3)
    store typed i32 3, %t4
    %t5 = addr $x
    %t6 = call ptr @collapse(%t5)
    store typed i32 4, %t6
    %t7 = load typed i32 $x
    %t8 = call i32 @value(%t7)
    %t9 = call i32 @value(0)
    %t10 = binary add nowrap i32 %t8, %t9
    %t11 = binary sub nowrap i32 %t10, 4
    return i32 %t11
}
