    %t8 = load typed i32 %t7
    %t9 = binary add nowrap i32 %t8, 1
    store typed i32 %t9, %t7
    %t10 = addr $counter
    %t11 = index i8 [projection=field] %t10, 0
    %t12 = load typed i32 %t11
    %t13 = cmp eq i32 %t12, 5
