    jump ^land_end_6

  block ^land_end_6:
    %t19 = load typed i64 $land__2
    branch %t19, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
