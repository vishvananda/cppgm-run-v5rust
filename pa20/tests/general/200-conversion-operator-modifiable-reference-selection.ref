  block ^land_rhs_4:
    %t14 = addr $counter
    %t15 = index i8 [projection=field] %t14, 4
    %t16 = load typed i32 %t15
    %t17 = cmp eq i32 %t16, 19
    %t18 = cmp ne i64 %t17, 0
    store typed i64 %t18, $land__2
    jump ^land_end_6

  block ^land_short_5:
