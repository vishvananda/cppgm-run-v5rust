global @calls : i32 [binding=strong] = zero
global @values [binding=strong] = {
  i32 1
  i32 2
  i32 3
}

function @range() -> ptr [binding=strong, object=_Z5rangev] {
  block ^entry:
    %t1 = load typed i32 @calls
    %t2 = binary add nowrap i32 %t1, 1
    store typed i32 %t2, @calls
    %t3 = addr @values
    return ptr %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $sum : i32
  slot $__range1 : ptr
  slot $__idx2 : i32
  slot $value : i32
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    store typed i32 0, $sum
    %t1 = call ptr @range()
    store typed ptr %t1, $__range1
    store typed i32 0, $__idx2
    jump ^for_cond_1

  block ^for_cond_1:
    %t2 = load typed i32 $__idx2
    %t3 = cmp lt i32 %t2, 3
    branch %t3, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t4 = load typed ptr $__range1
    %t5 = load typed i32 $__idx2
    %t6 = index i32 [projection=array_element] %t4, %t5
    %t7 = load typed i32 %t6
    store typed i32 %t7, $value
    %t8 = load typed i32 $sum
    %t9 = load typed i32 $value
    %t10 = binary add nowrap i32 %t8, %t9
    store typed i32 %t10, $sum
    jump ^for_iter_3

  block ^for_iter_3:
    %t11 = load typed i32 $__idx2
    %t12 = binary add nowrap i32 %t11, 1
    store typed i32 %t12, $__idx2
    jump ^for_cond_1

  block ^for_end_4:
    %t13 = load typed i32 @calls
    %t14 = cmp eq i32 %t13, 1
    branch %t14, ^land_rhs_8, ^land_short_9

  block ^land_rhs_8:
    %t15 = load typed i32 $sum
    %t16 = cmp eq i32 %t15, 6
    %t17 = cmp ne i64 %t16, 0
    store typed i64 %t17, $land__2
    jump ^land_end_10

  block ^land_short_9:
    store typed i64 0, $land__2
    jump ^land_end_10

  block ^land_end_10:
    %t18 = load typed i64 $land__2
    branch %t18, ^cond_then_5, ^cond_else_6

  block ^cond_then_5:
    store typed i32 0, $cond__1
    jump ^cond_end_7

  block ^cond_else_6:
    store typed i32 1, $cond__1
    jump ^cond_end_7

  block ^cond_end_7:
    %t19 = load typed i32 $cond__1
    return i32 %t19
}
