function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $s : obj<4x1>
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr $s
    %t2 = addr $s
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = index i8 [projection=array_element] %t3, 0
    store i8 97, %t4
    %t5 = addr $s
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = index i8 [projection=array_element] %t6, 1
    store i8 98, %t7
    %t8 = addr $s
    %t9 = index i8 [projection=field] %t8, 0
    %t10 = index i8 [projection=array_element] %t9, 2
    store i8 99, %t10
    %t11 = addr $s
    %t12 = index i8 [projection=field] %t11, 0
    %t13 = index i8 [projection=array_element] %t12, 3
    store i8 0, %t13
    %t14 = addr $s
    %t15 = index i8 [projection=field] %t14, 0
    %t16 = index i8 [projection=array_element] %t15, 2
    %t17 = load i8 %t16
    %t18 = convert sext i32 i8 %t17
    %t19 = cmp eq i32 %t18, 99
    branch %t19, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t20 = addr $s
    %t21 = index i8 [projection=field] %t20, 0
    %t22 = index i8 [projection=array_element] %t21, 3
    %t23 = load i8 %t22
    %t24 = convert sext i32 i8 %t23
    %t25 = cmp eq i32 %t24, 0
    %t26 = cmp ne i64 %t25, 0
    store typed i64 %t26, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t27 = load typed i64 $land__2
    branch %t27, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t28 = load typed i32 $cond__1
    return i32 %t28
}
