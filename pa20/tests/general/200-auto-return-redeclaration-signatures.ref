global @object : i32 [binding=strong] = 5

function @value() -> i32 [binding=strong, object=_Z5valuev] {
  block ^entry:
    return i32 3
}
function @Counter__get(%this : ptr [object_bytes=1]) -> i64 [binding=strong, object=_ZN7Counter3getEv] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i64 4
}
function @reference() -> ptr [binding=strong, object=_Z9referencev] {
  block ^entry:
    %t1 = addr @object
    return ptr %t1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $counter : obj<1x1>
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr $counter
    %t2 = call i32 @value()
    %t3 = call ptr @reference()
    %t4 = load typed i32 %t3
    %t5 = binary add nowrap i32 %t4, %t2
    store typed i32 %t5, %t3
    %t6 = load typed i32 @object
    %t7 = cmp eq i32 %t6, 8
    branch %t7, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t8 = addr $counter
    %t9 = call i64 @Counter__get(%t8)
    %t10 = cmp eq i64 %t9, 4
    %t11 = cmp ne i64 %t10, 0
    store typed i64 %t11, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t12 = load typed i64 $land__2
    branch %t12, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t13 = load typed i32 $cond__1
    return i32 %t13
}
