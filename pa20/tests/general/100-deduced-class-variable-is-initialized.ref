    copyobj 4x4 %t3, %t2
    %t4 = addr $empty
    zeroinit 1x1 %t4
    %t5 = addr $empty
    %t6 = addr $spelled
    call void @Counted__Counted(%t6)
    %t7 = addr $counted
    %t8 = index i8 [projection=field] %t7, 0
    %t9 = load typed i32 %t8
    %t10 = cmp eq i32 %t9, 7
    branch %t10, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t11 = addr $spelled
    %t12 = index i8 [projection=field] %t11, 0
    %t13 = load typed i32 %t12
    %t14 = cmp eq i32 %t13, 7
    %t15 = cmp ne i64 %t14, 0
    store typed i64 %t15, $land__2
    jump ^land_end_6

  block ^land_short_5:
