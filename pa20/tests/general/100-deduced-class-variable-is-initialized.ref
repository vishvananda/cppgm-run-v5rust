    %t5 = index i8 [projection=field] %t4, 0
    store typed i32 3, %t5
    %t6 = addr $retobj__1
    %t7 = addr $p
    copyobj 4x4 %t7, %t6
    return obj<4x4> $retobj__1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $counted : obj<4x4>
  slot $from_call : obj<4x4>
  slot $empty : obj<1x1>
  slot $spelled : obj<4x4>
