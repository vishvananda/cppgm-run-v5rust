  block ^land_end_12:
    %t26 = load typed i64 $land__4
    branch %t26, ^land_rhs_13, ^land_short_14

  block ^land_rhs_13:
    %t27 = load typed i32 @calls
    %t28 = cmp eq i32 %t27, 1
    %t29 = cmp ne i64 %t28, 0
    store typed i64 %t29, $land__5
    jump ^land_end_15

  block ^land_short_14:
    store typed i64 0, $land__5
    jump ^land_end_15

  block ^land_end_15:
    %t30 = load typed i64 $land__5
    branch %t30, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t31 = load typed i32 $cond__1
    return i32 %t31
}
function @Counted__Counted(%this : ptr [object_bytes=4]) -> void [binding=weak, object=_ZN7CountedC1Ev, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
