    branch %t16, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t17 = load typed i32 @constructions
    %t18 = cmp eq i32 %t17, 2
    %t19 = cmp ne i64 %t18, 0
    store typed i64 %t19, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t20 = load typed i64 $land__3
    branch %t20, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t21 = addr $from_call
    %t22 = index i8 [projection=field] %t21, 0
    %t23 = load typed i32 %t22
    %t24 = cmp eq i32 %t23, 3
    %t25 = cmp ne i64 %t24, 0
    store typed i64 %t25, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
