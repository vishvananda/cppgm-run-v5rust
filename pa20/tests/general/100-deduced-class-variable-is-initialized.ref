global @constructions : i32 [binding=strong] = 0
global @calls : i32 [binding=strong] = 0

function @make() -> obj<4x4> [binding=strong, object=_Z4makev] {
  slot $p : obj<4x4>
  slot $retobj__1 : obj<4x4>

  block ^entry:
    %t1 = load typed i32 @calls
