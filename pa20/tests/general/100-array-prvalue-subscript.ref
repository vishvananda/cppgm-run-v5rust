function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $arraytmp__2 : obj<1x1>

  block ^entry:
    %t1 = addr $arraytmp__2
    store u8 1, %t1
    %t2 = index u8 [projection=array_element] %t1, 0
    %t3 = load u8 %t2
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load typed i32 $cond__1
    return i32 %t4
}
