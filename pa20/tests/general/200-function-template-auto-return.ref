function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @identity(0)
    return i32 %t1
}
function @identity(%value : i32) -> i32 [binding=weak, object=_Z8identityIiET_S0_, inline_hint=yes] {
  slot $value : i32

  block ^entry:
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    return i32 %t1
}
