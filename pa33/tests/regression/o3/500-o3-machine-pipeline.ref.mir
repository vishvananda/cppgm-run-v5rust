machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, 40
    add r8, 2

  block ^next
    cmp.i64 r8, 42
    setne r8
    movzx r8, r8
    ret r8
