machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @state
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

global @arena
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0

global @stats
  storage scalar i64
  init i64 0

global @result
  storage scalar i64
  init i64 0

global @node
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

global @edges
  storage data
  item u32 0
  item u32 1
  item u32 0
  item u32 4294967295

global @no_edge
  storage scalar u32
  init u32 4294967295

function @edge_at
  abi
    param %base -> rdi : ptr
    param %index -> rsi : i64
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    imul rsi, 8
    mov <gpr0>, @edges
    add rsi, <gpr0>
    ret rsi

function @node_at
  abi
    param %base -> rdi : ptr
    param %index -> rsi : i64
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, @node
    ret rax

function @payload
  abi
    param %arena_pointer -> rdi : ptr
    param %value -> rsi : u32
    return u32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rsi

function @append
  abi
    param %destination -> rdi : ptr
    param %value -> rsi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret

function @walk
  abi
    param %this -> rdi : ptr
    param %declarator -> rsi : u32
    param %fallback -> rdx : u32
    param %names -> rcx : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1> <gpr2> <gpr3> <gpr4>
    slot $fallback -> [rbp-<off0>] : u32
    slot $payload -> [rbp-<off1>] : u32

  block ^entry
    mov <gpr4>, rcx
    store.u32 [rbp-<off0>], rdx
    lea <gpr1>, [rdi+<off0>]
    load.ptr r8, [<gpr1>]
    lea rdi, [r8+<off0>]
    call @node_at [args=(rsi,rdi), unwind=no]
    load.u32 <gpr2>, [rax+<off0>]

  block ^outer_condition
    cmp.u32 <gpr2>, @no_edge
    je ^outer_done

  block ^outer_body
    load.ptr r8, [<gpr1>]
    lea rdi, [r8+<off1>]
    mov rsi, <gpr2>
    call @edge_at [args=(rsi,rdi), unwind=no]
    load.u32 <gpr3>, [rax]
    load.ptr r8, [<gpr1>]
    load.ptr r9, [r8+<off2>]
    cmp.ptr r9, 0
    je ^inspect

  block ^record
    add [r9], 1

  block ^inspect
    lea rdi, [r8+<off0>]
    mov rsi, <gpr3>
    call @node_at [args=(rsi,rdi), unwind=no]
    cmp.u16 [rax+<off1>], 121
    sete r8
    cmp.u8 r8, 0
    jne ^inner_start

  block ^outer_iterate
    load.ptr r8, [<gpr1>]
    lea rdi, [r8+<off1>]
    mov rsi, <gpr2>
    call @edge_at [args=(rsi,rdi), unwind=no]
    load.u32 <gpr2>, [rax+<off2>]
    cmp.u32 <gpr2>, @no_edge
    jne ^outer_body

  block ^outer_done
    mov rdi, <gpr4>
    lea rsi, [rbp-<off0>]
    call @append [args=(rsi,rdi), unwind=no]
    ret

  block ^inner_body
    load.ptr <gpr3>, [<gpr1>]
    lea rdi, [<gpr3>+<off0>]
    mov rsi, <gpr2>
    call @edge_at [args=(rsi,rdi), unwind=no]
    load.u32 rsi, [rax]
    mov rdi, <gpr3>
    call @payload [args=(rsi,rdi), unwind=no]
    store.u32 [rbp-<off1>], rax
    mov rdi, <gpr4>
    lea rsi, [rbp-<off1>]
    call @append [args=(rsi,rdi), unwind=no]
    load.ptr r8, [<gpr1>]
    lea rdi, [r8+<off1>]
    mov rsi, <gpr2>
    call @edge_at [args=(rsi,rdi), unwind=no]
    load.u32 <gpr2>, [rax+<off2>]
    cmp.u32 <gpr2>, @no_edge
    jne ^inner_body
    jmp ^inner_done

  block ^inner_start
    load.ptr r8, [<gpr1>]
    lea rdi, [r8+<off0>]
    mov rsi, <gpr3>
    call @node_at [args=(rsi,rdi), unwind=no]
    load.u32 <gpr2>, [rax+<off0>]

  block ^inner_condition
    cmp.u32 <gpr2>, @no_edge
    jne ^inner_body

  block ^inner_done
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov <gpr5>, @arena
    store.ptr @state+24, <gpr5>
    mov <gpr5>, @stats
    store.ptr @arena+8, <gpr5>
    mov rdi, @state
    mov rsi, 0
    mov rdx, 0
    mov rcx, @result
    call @walk [args=(rcx,rdx,rsi,rdi), unwind=no]
    cmp.i64 @stats, 2
    setne rax
    movzx rax, rax
    ret rax
