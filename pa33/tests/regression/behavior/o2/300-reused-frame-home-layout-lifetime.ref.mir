machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @make_value
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @clobber
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 5
    ret rax

function @probe
  abi
    param %take_old_path -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx
    slot $joined -> [rbp-8] : i64

  block ^entry
    cmp.i64 rdi, 0
    jne ^old_value

  block ^constant_value
    store.i64 [rbp-8], 7

  block ^merge
    load.i64 rbx, [rbp-8]
    cmp.i64 rbx, 0
    jne ^use_current

  block ^return_zero
    mov rax, 0
    ret rax

  block ^store_fallback
    store.i64 [rbp-8], 3
    jmp ^merge

  block ^old_value
    mov rdi, 91
    call @make_value [args=(rdi)]
    mov rbx, rax
    call @clobber [args=()]
    cmp.i64 rbx, rax
    je ^store_fallback

  block ^store_old
    store.i64 [rbp-8], rbx
    load.i64 rbx, [rbp-8]
    cmp.i64 rbx, 0
    je ^return_zero

  block ^use_current
    call @clobber [args=()]
    add rbx, rax
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 0
    call @probe [args=(rdi)]
    cmp.i64 rax, 12
    setne rax
    movzx rax, rax
    ret rax
