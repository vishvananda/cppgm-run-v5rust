machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @data
  storage data
  item i64 0
  item i64 0

global @a
  storage scalar i64
  init i64 1

global @b
  storage scalar i64
  init i64 2

global @c
  storage scalar i64
  init i64 3

global @d
  storage scalar i64
  init i64 4

function @noop
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0
    ret rax

function @probe
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    slot $counter -> [rbp-<off0>] : i64
    temp %a -> [rbp-<off1>] : i64

  block ^entry
    mov <gpr1>, @data
    load.i64 r8, @a
    store.i64 [rbp-<off1>], r8
    load.i64 <gpr4>, @b
    load.i64 <gpr3>, @c
    load.i64 <gpr2>, @d
    store.i64 [rbp-<off0>], 0

  block ^condition
    load.i64 <gpr0>, [rbp-<off0>]
    cmp.i64 <gpr0>, 2
    jae ^done

  block ^body
    store.i64 [<gpr1>+<gpr0>*8], <gpr0>
    call @noop [args=(), unwind=no]
    mov r8, <gpr4>
    add r8, [rbp-<off1>]
    lea r9, [<gpr3>+<gpr2>]
    lea r8, [r8+r9+<off0>]
    add <gpr0>, 1
    store.i64 [rbp-<off0>], <gpr0>
    cmp.i64 r8, 17
    je ^condition

  block ^failure
    mov rax, 1
    ret rax

  block ^done
    cmp.i64 [<gpr1>+<off0>], 1
    setne rax
    movzx rax, rax
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    call @probe [args=(), unwind=no]
    ret rax
