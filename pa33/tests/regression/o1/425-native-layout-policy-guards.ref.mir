machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @frameless_leaf
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add rdi, 1
    ret rdi

function @frameless_call
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    call @identity [args=(rdi), unwind=no]
    ret rax

function @frame_operand
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 31
    ret rax

function @dynamic_stack
  abi
    param %bytes -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    stack_alloc r8, rdi
    store.i64 [r8], 37
    load.i64 rax, [r8]
    ret rax

function @floating_scratch
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fadd.f64 xmm0, 1.25, 2.5
    fne.f64 rax, xmm0, 3.75
    ret rax

function @host_eh
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    eh_push ^handler, 0
    mov rdi, 41
    call @identity [args=(rdi), unwind=no]
    eh_pop
    ret rax

  block ^handler
    mov rax, 99
    ret rax

function @direct_returns
  abi
    param %condition -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rdi, 0
    je ^no

  block ^yes
    mov rax, 43
    ret rax

  block ^no
    mov rax, 47
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    temp %eh_value -> [rbp-8] : i64

  block ^entry
    mov rdi, 28
    call @frameless_leaf [args=(rdi), unwind=no]
    mov rbx, rax
    mov rdi, 30
    call @frameless_call [args=(rdi), unwind=no]
    mov r12, rax
    call @frame_operand [args=(), unwind=no]
    mov r13, rax
    mov rdi, 16
    call @dynamic_stack [args=(rdi), unwind=no]
    mov r14, rax
    call @floating_scratch [args=(), unwind=no]
    mov r15, rax
    call @host_eh [args=()]
    mov r10, rax
    store.i64 [rbp-8], r10
    mov rdi, 1
    call @direct_returns [args=(rdi), unwind=no]
    cmp.i64 rbx, 29
    setne rbx
    movzx rbx, rbx
    cmp.i64 r12, 30
    setne r12
    movzx r12, r12
    cmp.i64 r13, 31
    setne r13
    movzx r13, r13
    cmp.i64 r14, 37
    setne r14
    movzx r14, r14
    cmp.i64 [rbp-8], 41
    setne r8
    movzx r8, r8
    cmp.i64 rax, 43
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, r14
    or r15, r8
    or rbx, r13
    or r15, rax
    or rbx, r15
    ret rbx
