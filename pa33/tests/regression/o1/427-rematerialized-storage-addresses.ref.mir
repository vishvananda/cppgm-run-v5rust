machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @global_value
  storage scalar i64
  init i64 11

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @frame_storage_after_call
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $value -> [rbp-8] : i64

  block ^entry
    store.i64 [rbp-8], 19
    mov rdi, 3
    call @identity [args=(rdi), unwind=no]
    load.i64 rax, [rbp-8]
    ret rax

function @global_storage_after_call
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 5
    call @identity [args=(rdi), unwind=no]
    load.i64 rax, @global_value
    ret rax

function @constant_field_after_call
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $object -> [rbp-24] : obj<24x8>

  block ^entry
    store.i64 [rbp-16], 23
    mov rdi, 7
    call @identity [args=(rdi), unwind=no]
    load.i64 rax, [rbp-16]
    ret rax

function @variable_index_after_call
  abi
    param %index -> rdi : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx
    slot $object -> [rbp-24] : obj<24x8>

  block ^entry
    mov rbx, rdi
    store.i64 [rbp+rbx*8-24], 29
    mov rdi, 9
    call @identity [args=(rdi), unwind=no]
    load.i64 rax, [rbp+rbx*8-24]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13

  block ^entry
    call @frame_storage_after_call [args=(), unwind=no]
    mov rbx, rax
    call @global_storage_after_call [args=(), unwind=no]
    mov r12, rax
    call @constant_field_after_call [args=(), unwind=no]
    mov r13, rax
    mov rdi, 1
    call @variable_index_after_call [args=(rdi), unwind=no]
    cmp.i64 rbx, 19
    setne rbx
    movzx rbx, rbx
    cmp.i64 r12, 11
    setne r12
    movzx r12, r12
    cmp.i64 r13, 23
    setne r13
    movzx r13, r13
    cmp.i64 rax, 29
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, rax
    or rbx, r13
    ret rbx
