machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>
    slot $box__0 -> [rbp-<off0>] : i64

  block ^entry
    lea rdi, [rbp-<off0>]
    call @Box_int___Box [args=(rdi)]
    store.i32 [rbp-<off0>], 7
    load.i32 r8, [rbp-<off0>]
    lea <gpr0>, [r8-<off0>]
    lea rdi, [rbp-<off0>]
    call @Box_int____Box [args=(rdi)]
    ret <gpr0>

function @Box_int___Box
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret

function @Box_int____Box
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret
