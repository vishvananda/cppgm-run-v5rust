machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, 40 !dbg(test.cpp, 3, 3)
    add r8, 2 !dbg(test.cpp, 3, 3)
    cmp.i64 r8, 42 !dbg(test.cpp, 5, 3)
    setne r8 !dbg(test.cpp, 5, 3)
    movzx r8, r8 !dbg(test.cpp, 5, 3)
    ret r8 !dbg(test.cpp, 6, 3)
