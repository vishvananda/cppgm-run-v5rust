machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, 1 !dbg(test.cpp, 3, 1)
    add r8, 2 !dbg(test.cpp, 3, 1)
    ret r8 !dbg(test.cpp, 4, 1)
