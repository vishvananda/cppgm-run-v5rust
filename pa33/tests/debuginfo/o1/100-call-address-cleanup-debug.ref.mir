machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @id
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i32 rax, [rdi] !dbg(test.cpp, 1, 1)
    ret rax !dbg(test.cpp, 2, 1)

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $x -> [rbp-8] : i64

  block ^entry
    store.i32 [rbp-8], 7 !dbg(test.cpp, 7, 1)
    lea rdi, [rbp-8] !dbg(test.cpp, 9, 1)
    call @id [args=(rdi)] !dbg(test.cpp, 9, 1)
    ret rax !dbg(test.cpp, 10, 1)
