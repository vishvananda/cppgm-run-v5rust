machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @id
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i32 rax, [rdi] !dbg(test.cpp, 1, 1)
    ret rax !dbg(test.cpp, 2, 1)

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $x -> [rbp-<off0>] : i64

  block ^entry
    store.i32 [rbp-<off0>], 7 !dbg(test.cpp, 7, 1)
    lea rdi, [rbp-<off0>] !dbg(test.cpp, 9, 1)
    call @id [args=(rdi)] !dbg(test.cpp, 9, 1)
    ret rax !dbg(test.cpp, 10, 1)
