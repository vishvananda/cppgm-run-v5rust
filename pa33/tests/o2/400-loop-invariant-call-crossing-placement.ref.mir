machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @float_loop
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated

  block ^entry

  block ^loop
    fcmp.f64 3.5, 3.5
    jp ^loop
    jne ^loop

  block ^done
    mov rax, 0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov rbx, 40
    add rbx, 2

  block ^loop
    mov rdi, rbx
    call @identity [args=(rdi), unwind=no]
    cmp.i64 rax, 0
    je ^loop

  block ^done
    cmp.i64 rax, 42
    setne rbx
    movzx rbx, rbx
    call @float_loop [args=(), unwind=no]
    or rbx, rax
    ret rbx
