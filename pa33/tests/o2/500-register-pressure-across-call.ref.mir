machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pressure
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    param-slot %n -> [rbp-40] : i64
    temp %t50 -> [rbp-8] : i64
    temp %t51 -> [rbp-16] : i64
    temp %t52 -> [rbp-24] : i64
    temp %t53 -> [rbp-32] : i64

  block ^entry
    store.i64 [rbp-40], rdi
    mov r12, 1
    mov r13, 2
    mov r14, 3
    mov r15, 4
    store.i64 [rbp-8], 5
    store.i64 [rbp-16], 6
    store.i64 [rbp-24], 7
    store.i64 [rbp-32], 8
    mov rbx, 0

  block ^for_cond_1
    cmp.i64 rbx, rdi
    jl ^for_body_2

  block ^for_end_4
    add r12, r13
    add r12, r14
    add r12, r15
    add r12, [rbp-8]
    add r12, [rbp-16]
    add r12, [rbp-24]
    add r12, [rbp-32]
    ret r12

  block ^for_body_2
    mov rdi, rbx
    call @step [args=(rdi)]
    add r12, rax
    add r13, r12
    add r14, r13
    add r15, r14
    mov r8, r15
    add r8, [rbp-8]
    mov r9, r8
    add r9, [rbp-16]
    mov rdi, r9
    add rdi, [rbp-24]
    mov rsi, rdi
    add rsi, [rbp-32]
    add rbx, 1
    store.i64 [rbp-8], r8
    store.i64 [rbp-16], r9
    store.i64 [rbp-24], rdi
    store.i64 [rbp-32], rsi
    cmp.i64 rbx, [rbp-40]
    jl ^for_body_2
    jmp ^for_end_4

function @step
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add rdi, 1
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 3
    call @pressure [args=(rdi)]
    cmp.i64 rax, 1008
    je ^cond_then_1

  block ^cond_else_2
    mov rax, 1

  block ^cond_end_3
    ret rax

  block ^cond_then_1
    mov rax, 0
    jmp ^cond_end_3
