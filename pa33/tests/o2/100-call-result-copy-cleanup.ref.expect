# budget from 100-call-result-copy-cleanup.ref.mir: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 12
blocks <= 7
count(call) <= 4
mem <= 4
instructions <= 5 in @zero
stack_size <= 32 in @zero
instructions <= 10 in @main
stack_size <= 32 in @main
