machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @id
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i32 rax, [rdi]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $x -> [rbp-8] : i64

  block ^entry
    store.i32 [rbp-8], 7
    lea rdi, [rbp-8]
    call @id [args=(rdi)]
    ret rax
