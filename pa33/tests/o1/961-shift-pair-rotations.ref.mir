machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @left
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    rol rdi, 13
    ret rdi

function @right
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ror rdi, 13
    ret rdi

function @tie
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    rol rdi, 32
    ret rdi

function @u32left
  abi
    param %x -> rdi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    rol.u32 rdi, 7
    ret rdi

function @u32right
  abi
    param %x -> rdi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ror.u32 rdi, 7
    ret rdi

function @one
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    rol rdi, 1
    ret rdi

function @shared
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, rdi
    shl r8, 13
    shr rdi, 51
    or rdi, r8
    add rdi, r8
    ret rdi

function @signed32
  abi
    param %x -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, rdi
    shl r8, 7
    sext.i32 r8
    zext.i32 rdi
    shr rdi, 25
    sext.i32 rdi
    or r8, rdi
    ret r8

function @separate
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r9, rdi
    shl r9, 13
    mov r8, rdi
    shr r8, 51

  block ^next
    or r9, r8
    ret r9

function @main
  abi
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    temp %badone -> [rbp-8] : i64
    temp %badshared -> [rbp-16] : i64
    temp %badsigned32 -> [rbp-24] : i64

  block ^entry
    mov rdi, 1
    call @left [args=(rdi)]
    cmp.i64 rax, 8192
    setne rbx
    movzx rbx, rbx
    mov rdi, 1
    call @right [args=(rdi)]
    cmp.i64 rax, 2251799813685248
    setne r12
    movzx r12, r12
    mov rdi, 1
    call @tie [args=(rdi)]
    cmp.i64 rax, 4294967296
    setne r13
    movzx r13, r13
    mov rdi, 1
    call @u32left [args=(rdi)]
    cmp.u32 rax, 128
    setne r14
    movzx r14, r14
    mov rdi, 1
    call @u32right [args=(rdi)]
    cmp.u32 rax, 33554432
    setne r15
    movzx r15, r15
    mov rdi, 1
    call @one [args=(rdi)]
    cmp.i64 rax, 2
    setne r10
    movzx r10, r10
    store.i64 [rbp-8], r10
    mov rdi, 1
    call @shared [args=(rdi)]
    cmp.i64 rax, 16384
    setne r10
    movzx r10, r10
    store.i64 [rbp-16], r10
    mov rdi, 1
    call @signed32 [args=(rdi)]
    cmp.i32 rax, 128
    setne r10
    movzx r10, r10
    store.i64 [rbp-24], r10
    mov rdi, 1
    call @separate [args=(rdi)]
    cmp.i64 rax, 8192
    setne rax
    movzx rax, rax
    or rbx, r12
    or rbx, r13
    or rbx, r14
    or rbx, r15
    load.i64 r11, [rbp-8]
    or rbx, r11
    load.i64 r11, [rbp-16]
    or rbx, r11
    load.i64 r11, [rbp-24]
    or rbx, r11
    or rbx, rax
    ret rbx
