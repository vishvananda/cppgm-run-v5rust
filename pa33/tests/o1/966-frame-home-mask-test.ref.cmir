machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @mask
  abi
    param %value -> rdi : u8
    return u32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %flags -> [rbp-<off0>] : u32

  block ^entry
    eh_push ^handler, 0
    eh_pop
    test.u8 rdi, rdi
    mov <gpr0>, 24
    mov r8, 0
    cmovne r8, <gpr0>
    store.u32 [rbp-<off0>], r8
    test.u32 r8, 8
    je ^no

  block ^next
    test.u32 r8, 16
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

  block ^handler
    mov rax, 99
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1>

  block ^entry
    mov rdi, 1
    call @mask [args=(rdi)]
    mov <gpr1>, rax
    mov rdi, 0
    call @mask [args=(rdi)]
    cmp.u32 <gpr1>, 1
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.u32 rax, 0
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    ret <gpr1>
