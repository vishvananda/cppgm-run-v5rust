machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @observe
  abi
    param %object -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i32 rax, [rdi]
    ret rax

function @probe
  abi
    param %choice -> rdi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $left -> [rbp-<off0>] : obj<1600x4>
    slot $right -> [rbp-<off0>] : obj<1600x4>

  block ^entry
    cmp.i32 rdi, 0
    je ^right

  block ^left
    store.i32 [rbp-<off0>], 7
    lea rdi, [rbp-<off0>]
    call @observe [args=(rdi)]
    ret rax

  block ^right
    store.i32 [rbp-<off0>], 9
    lea rdi, [rbp-<off0>]
    call @observe [args=(rdi)]
    ret rax

function @loop_overlap
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $first -> [rbp-<off1>] : obj<1600x4>
    slot $second -> [rbp-<off2>] : obj<1600x4>
    slot $saved -> [rbp-<off3>] : ptr
    slot $iteration -> [rbp-<off4>] : i32

  block ^entry
    store.i32 [rbp-<off4>], 0

  block ^dispatch
    cmp.i32 [rbp-<off4>], 0
    jne ^second

  block ^first
    lea r8, [rbp-<off1>]
    store.i32 [r8], 7
    store.ptr [rbp-<off3>], r8
    store.i32 [rbp-<off4>], 1
    cmp.i32 [rbp-<off4>], 0
    je ^first

  block ^second
    load.ptr r8, [rbp-<off3>]
    cmp.i32 [r8], 7
    setne rax
    movzx rax, rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>

  block ^entry
    mov rdi, 1
    call @probe [args=(rdi)]
    mov <gpr0>, rax
    mov rdi, 0
    call @probe [args=(rdi)]
    cmp.i32 <gpr0>, 7
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.i32 rax, 9
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    call @loop_overlap [args=()]
    or <gpr0>, rax
    ret <gpr0>
