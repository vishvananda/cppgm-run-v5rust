# budget from 300-call-result-across-eh-push.ref.mir: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 20
blocks <= 7
count(call) <= 5
mem <= 6
instructions <= 5 in @address
stack_size <= 32 in @address
instructions <= 5 in @read
stack_size <= 48 in @read
instructions <= 16 in @main
stack_size <= 48 in @main

# contract from 300-call-result-across-eh-push.ref.mir: the exception regions, calls, callee-saved registers and memory accesses the fixture requires
count(eh_push) == 1 in @main
count(eh_pop) == 1 in @main
count(call @address) == 1 in @main
count(call @read) == 1 in @main
