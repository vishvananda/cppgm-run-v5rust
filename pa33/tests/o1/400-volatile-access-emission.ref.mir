machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @spin_flag
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $flag -> [rbp-8] : i32

  block ^entry
    store.i32 [rbp-8], 0
    store.i32 [rbp-8], 1
    load.i32 r8, [rbp-8]
    load.i32 r9, [rbp-8]
    add r8, r9
    sext.i32 r8
    ret r8

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    call @spin_flag [args=(), unwind=no]
    cmp.i32 rax, 2
    setne rax
    movzx rax, rax
    ret rax
