machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @node1
  storage data
  item ptr addr @node2

global @node2
  storage data
  item ptr 0

global @number
  storage scalar i64
  init i64 42

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @walk_unavoidable
  abi
    param %head -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i64 r9, @number
    mov r8, rdi
    mov rax, 0

  block ^loop
    cmp.ptr r8, 0
    je ^exit

  block ^body
    cmp.i64 r9, 42
    jne ^failure

  block ^advance
    load.ptr r8, [r8]
    add rax, 1
    cmp.ptr r8, 0
    jne ^body

  block ^exit
    ret rax

  block ^failure
    mov rax, 99
    ret rax

function @walk_guarded
  abi
    param %head -> rdi : ptr
    param %run -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rsi, 0
    je ^entry~exit

  block ^entry~loop
    mov r8, rdi
    mov r9, 0

  block ^loop
    cmp.ptr r8, 0
    je ^loop~exit

  block ^body
    load.ptr r8, [r8]
    add r9, 1
    cmp.ptr r8, 0
    jne ^body

  block ^loop~exit
    ret r9

  block ^exit
    ret r9

  block ^entry~exit
    mov r9, 0
    ret r9

function @call_free_eh_load
  abi
    param %address -> rdi : ptr
    param %choose -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %value -> [rbp-8] : i64
    temp %result -> [rbp-16] : i64

  block ^entry
    eh_push ^handler, 0
    eh_pop
    load.i64 rdi, [rdi]
    store.i64 [rbp-8], rdi
    cmp.i64 rsi, 0
    je ^right

  block ^left
    lea r8, [rdi+1]
    store.i64 [rbp-16], r8

  block ^done
    mov rax, r8
    ret rax

  block ^right
    lea r8, [rdi-1]
    store.i64 [rbp-16], r8
    jmp ^done

  block ^handler
    mov rax, 99
    ret rax

function @call_crossing_eh_value
  abi
    param %address -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %value -> [rbp-8] : i64

  block ^entry
    eh_push ^handler, 0
    load.i64 rdi, [rdi]
    store.i64 [rbp-8], rdi
    mov rdi, 7
    call @identity [args=(rdi), unwind=no]
    eh_pop

  block ^done
    load.i64 r8, [rbp-8]
    add r8, 1
    ret r8

  block ^handler
    mov rax, 99
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14

  block ^entry
    lea rdi, @node1
    call @walk_unavoidable [args=(rdi), unwind=no]
    mov rbx, rax
    lea rdi, @node1
    mov rsi, 0
    call @walk_guarded [args=(rsi,rdi), unwind=no]
    mov r12, rax
    lea rdi, @number
    mov rsi, 1
    call @call_free_eh_load [args=(rsi,rdi)]
    mov r13, rax
    lea rdi, @number
    mov rsi, 0
    call @call_free_eh_load [args=(rsi,rdi)]
    mov r14, rax
    lea rdi, @number
    call @call_crossing_eh_value [args=(rdi)]
    cmp.i64 rbx, 2
    setne rbx
    movzx rbx, rbx
    cmp.i64 r12, 0
    setne r12
    movzx r12, r12
    cmp.i64 r13, 43
    setne r13
    movzx r13, r13
    cmp.i64 r14, 41
    setne r14
    movzx r14, r14
    cmp.i64 rax, 43
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, r14
    or rbx, r13
    or rbx, rax
    ret rbx
