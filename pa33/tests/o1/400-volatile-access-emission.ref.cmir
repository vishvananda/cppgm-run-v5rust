machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @spin_flag
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $flag -> [rbp-<off0>] : i32

  block ^entry
    store.i32 [rbp-<off0>], 0
    store.i32 [rbp-<off0>], 1
    load.i32 r8, [rbp-<off0>]
    load.i32 r9, [rbp-<off0>]
    add r8, r9
    sext.i32 r8
    ret r8

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    call @spin_flag [args=(), unwind=no]
    cmp.i32 rax, 2
    setne rax
    movzx rax, rax
    ret rax
