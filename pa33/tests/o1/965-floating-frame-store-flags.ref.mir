machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @store80
  abi
    param %value -> [rbp+16] : f80
    return void -> void
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated
    slot $local -> [rbp-16] : f80

  block ^entry
    ret

function @store32
  abi
    param %value -> xmm0 : f64
    return void -> void
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated
    slot $local -> [rbp-16] : f32
    param-slot %value -> [rbp-8] : f64

  block ^entry
    fmov.f64 [rbp-8], xmm0
    fptrunc.f64.f32 xmm14, [rbp-8]
    ret

function @store64
  abi
    param %value -> xmm0 : f64
    return void -> void
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated
    slot $local -> [rbp-16] : f64
    param-slot %value -> [rbp-8] : f64

  block ^entry
    fmov.f64 [rbp-8], xmm0
    fmov.f64 [rbp-16], [rbp-8]
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0
    ret rax
