# budget from 500-zero-index-canonicalization.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 8
blocks <= 5
count(call) <= 3
count(load) <= 5
count(store) <= 3
count(phi) <= 3
