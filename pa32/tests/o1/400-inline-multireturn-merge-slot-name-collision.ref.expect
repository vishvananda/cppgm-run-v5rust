# budget from 400-inline-multireturn-merge-slot-name-collision.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 27
blocks <= 17
count(call) <= 3
count(load) <= 3
count(store) <= 6
count(phi) <= 5
instructions <= 7 in @callee
instructions <= 8 in @caller
instructions <= 10 in @object_callee
instructions <= 8 in @object_caller

# outcomes from 400-inline-multireturn-merge-slot-name-collision.ref: what the course solution removed stays removed (a call inlined, memory promoted, a definition pruned)
none(call @callee)
none(call @object_callee)
none(load)
none(copyobj)
