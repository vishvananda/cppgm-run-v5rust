# budget from 500-late-aggregate-split-after-forwarding.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 14
blocks <= 5
count(call) <= 4
count(load) <= 5
count(store) <= 5
count(phi) <= 3
instructions <= 6 in @late_split
instructions <= 10 in @keep_escaping_object
