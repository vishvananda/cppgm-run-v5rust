# budget from 500-nonzero-underflow-predicate.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 30
blocks <= 16
count(call) <= 4
count(load) <= 8
count(store) <= 3
count(phi) <= 3
instructions <= 7 in @fold_after_nonzero_edge
instructions <= 14 in @retain_after_mutation
instructions <= 12 in @retain_volatile_reload
