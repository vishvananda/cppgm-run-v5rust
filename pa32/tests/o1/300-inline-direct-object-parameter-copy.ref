function @read_object(%value : obj<8x8>) -> i64 {
  slot $local : obj<8x8>

  block ^entry:
    %local_address = addr $local
    copyobj 8x8 %value, %local_address
    %result = load i64 %local_address
    return i64 %result
}
function @main() -> i64 [role=entry] {
  block ^entry:
    return i64 37
}
