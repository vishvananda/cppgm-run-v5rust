declare function @__cppgm_builtin_memset(%arg0 : ptr, %arg1 : i32, %arg2 : i64) -> ptr [unwind=no, binding=strong, object=cppgm_builtin_memset]

function @zero_words(%first : ptr, %n : i64) -> void {
  block ^entry:
    %bytes = binary shl i64 %n, 2
    %t2 = call ptr @__cppgm_builtin_memset(%first, 0, %bytes)
