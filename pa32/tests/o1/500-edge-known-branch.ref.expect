# budget from 500-edge-known-branch.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 9
blocks <= 8
count(call) <= 3
count(load) <= 3
count(store) <= 3
count(phi) <= 3
instructions <= 5 in @fold_false_edge
instructions <= 7 in @retain_removed_phi_edge

# outcomes from 500-edge-known-branch.ref: what the course solution removed stays removed (a call inlined, memory promoted, a definition pruned)
none(phi)
