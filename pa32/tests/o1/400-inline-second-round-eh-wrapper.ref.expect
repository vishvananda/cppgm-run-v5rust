# budget from 400-inline-second-round-eh-wrapper.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 6
blocks <= 6
count(call) <= 3
count(load) <= 3
count(store) <= 3
count(phi) <= 3
instructions <= 4 in @caller
instructions <= 4 in @mid
instructions <= 4 in @leaf

# outcomes from 400-inline-second-round-eh-wrapper.ref: what the course solution removed stays removed (a call inlined, memory promoted, a definition pruned)
none(call @leaf)
none(call @mid)
none(load)
none(store)
