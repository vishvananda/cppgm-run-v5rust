declare function @may_throw() -> void

function @leaf() -> void [unwind=no, prefer_local=yes] {
  block ^entry:
    return void
}
function @main() -> void [role=entry] {
  block ^entry:
    eh_try ^landing
    call void @may_throw()
    eh_end
    return void

  block ^landing:
    eh_end
    resume
}
