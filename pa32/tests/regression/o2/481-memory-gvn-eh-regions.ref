declare function @readonly_may_throw() -> i64 [effects=readonly]
declare function @consume(%value : i64) -> void [unwind=no]

global @value : i64 = 3

function @region_barriers() -> i64 {
  block ^entry:
    %before = load i64 @value
    eh_try ^cleanup
    %protected_sum = binary add i64 %before, %before
    %observed = call i64 @readonly_may_throw()
    eh_end
    %left = binary add i64 %before, %protected_sum
    %middle = binary add i64 %observed, %left
    %right = binary add i64 %protected_sum, %protected_sum
    %result = binary add i64 %middle, %right
    return i64 %result

  block ^cleanup:
    %landing_first = load i64 @value
    %landing_sum = binary add i64 %landing_first, %landing_first
    call void @consume(%landing_sum)
    resume
}
function @equal_protected_state(%choose : i64) -> i64 {
  block ^entry:
    eh_try ^cleanup
    %first = load i64 @value
    %sum = binary add i64 %first, %first
    %observed = call i64 @readonly_may_throw()
    %result = binary add i64 %sum, %observed
    eh_end
    return i64 %result

  block ^cleanup:
    resume
}
function @conflicting_normal_and_handler_state() -> i64 {
  block ^entry:
    eh_try ^handler
    %normal = load i64 @value
    %observed = call i64 @readonly_may_throw()
    eh_end
    jump ^join

  block ^handler:
    %caught = load i64 @value
    jump ^join

  block ^join:
    %joined = phi i64 [^entry: %normal, ^handler: %caught]
    %result = binary add i64 %joined, %joined
    return i64 %result
}
