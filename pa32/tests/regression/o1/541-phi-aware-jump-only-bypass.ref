declare function @observe(%value : i64) -> void [unwind=no]

function @empty_diamond_in_loop(%n : i64, %flag : u8) -> i64 {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^join: %next]
    %sum = phi i64 [^entry: 0, ^join: %sum2]
    %done = cmp eq i64 %n, %i
    branch %done, ^exit, ^join

  block ^join:
    %sum2 = binary add i64 %i, %sum
    %next = binary add i64 %i, 1
    jump ^head

  block ^exit:
    return i64 %sum
}
function @distinct_arm_values_stay(%flag : u8, %x : i64, %y : i64) -> i64 {
  block ^entry:
    branch %flag, ^join, ^right

  block ^right:
    jump ^join

  block ^join:
    %r = phi i64 [^right: %y, ^entry: %x]
    return i64 %r
}
function @one_arm_same_value(%flag : u8, %x : i64) -> i64 {
  block ^entry:
    return i64 %x
}
function @jump_chain_into_phi(%flag : u8, %x : i64, %y : i64) -> i64 {
  block ^entry:
    branch %flag, ^left, ^right

  block ^left:
    call void @observe(%x)
    jump ^join

  block ^right:
    call void @observe(%y)
    jump ^join

  block ^join:
    %r = phi i64 [^right: %y, ^left: %x]
    return i64 %r
}
