function @leaf(%x : i64) -> i64 [unwind=no] {
  block ^entry:
    %t1 = binary add i64 %x, 1
    return i64 %t1
}
function @wrapper(%x : i64) -> i64 [unwind=no] {
  block ^entry:
    %t1_1 = binary add i64 %x, 1
    return i64 %t1_1
}
function @main(%x : i64) -> i64 [role=entry] {
  block ^entry:
    %t1_1 = binary add i64 %x, 1
    %t2 = binary mul i64 %t1_1, 2
    return i64 %t2
}
