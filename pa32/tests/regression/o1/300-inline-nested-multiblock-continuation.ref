function @main(%outer : i64, %inner : i64) -> i64 [role=entry] {
  block ^entry:
    %is_zero_1 = cmp eq i64 %outer, 0
    branch %is_zero_1, ^inline_entry_1, ^inline_cont_4

  block ^inline_entry_1:
    %is_zero_2 = cmp eq i64 %inner, 0
    branch %is_zero_2, ^inline_cont_3, ^inline_copy_2

  block ^inline_copy_2:
    jump ^inline_cont_3

  block ^inline_cont_3:
    %from_leaf_3 = phi i64 [^inline_copy_2: 20, ^inline_entry_1: 10]
    jump ^inline_cont_4

  block ^inline_cont_4:
    %result = phi i64 [^inline_cont_3: %from_leaf_3, ^entry: %outer]
    %adjusted = binary add i64 %result, 1
    return i64 %adjusted
}
function @wrapper(%outer : i64, %inner : i64) -> i64 {
  block ^entry:
    %is_zero = cmp eq i64 %outer, 0
    branch %is_zero, ^inline_entry_1, ^nonzero

  block ^inline_entry_1:
    %is_zero_2 = cmp eq i64 %inner, 0
    branch %is_zero_2, ^inline_cont_3, ^nonzero_2

  block ^nonzero_2:
    jump ^inline_cont_3

  block ^inline_cont_3:
    %from_leaf = phi i64 [^nonzero_2: 20, ^inline_entry_1: 10]
    return i64 %from_leaf

  block ^nonzero:
    return i64 %outer
}
function @leaf(%inner : i64) -> i64 {
  block ^entry:
    %is_zero = cmp eq i64 %inner, 0
    branch %is_zero, ^zero, ^nonzero

  block ^zero:
    return i64 10

  block ^nonzero:
    return i64 20
}
