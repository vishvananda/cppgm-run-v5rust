function @guarded_value(%impossible : u8) -> i32 [binding=strong, object=_Z13guarded_valueb, no_inline=yes] {
  block ^entry:
    return i32 7
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @guarded_value(0)
    %t2 = binary sub nowrap i32 %t1, 7
    return i32 %t2
}
