# budget from 500-unroll-linear-1.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 4
blocks <= 4
count(call) <= 3
count(load) <= 3
count(store) <= 3
count(phi) <= 3
instructions <= 4 in @loop0

