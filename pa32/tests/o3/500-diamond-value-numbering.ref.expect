# budget from 500-diamond-value-numbering.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 60
blocks <= 17
count(call) <= 4
count(load) <= 12
count(store) <= 4
count(phi) <= 8
instructions <= 32 in @repeated_size
instructions <= 29 in @size_after_store
