# budget from 500-unroll-linear-2.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 5
blocks <= 5
count(call) <= 3
count(load) <= 3
count(store) <= 3
count(phi) <= 3
instructions <= 4 in @loop0
instructions <= 4 in @loop1

# outcomes from 500-unroll-linear-2.ref: what the course solution removed stays removed (a call inlined, memory promoted, a definition pruned)
none(phi)
