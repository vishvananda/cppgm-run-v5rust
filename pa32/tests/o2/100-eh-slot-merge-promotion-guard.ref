declare function @may_throw() -> void [binding=strong]

function @f() -> i64 [binding=strong] {
  block ^entry:
    eh_try ^catch_1
    call void @may_throw()
    eh_end
    jump ^after

  block ^catch_1:
    jump ^after

  block ^after:
    %t1 = phi i64 [^entry: 1, ^catch_1: 2]
    return i64 %t1
}
