global @take_outer : i64 = 1
global @take_path : i64 = 1
global @take_right : i64 = 0
global @repeat_inner : i64 = 0
global @result : i64 = 0

function @main() -> i64 [role=entry] {
  block ^entry:
    %t1 = load i64 @take_outer
    branch %t1, ^loop_preheader_1, ^exit

  block ^loop_preheader_1:
    %take = load i64 @take_path
    %again = load i64 @repeat_inner
    %right = load i64 @take_right
    jump ^inner_header

  block ^inner_header:
    branch %take, ^choose, ^inner_merge

  block ^choose:
    %t5 = select i64 %right, 9, 7
    store i64 %t5, @result
    jump ^inner_merge

  block ^inner_merge:
    branch %again, ^inner_header, ^outer_latch

  block ^outer_latch:
    store i64 0, @take_outer
    jump ^exit

  block ^exit:
    %answer = load i64 @result
    return i64 %answer
}
