declare function @may_throw() -> void
declare function @sink(%value : ptr) -> void [unwind=no]

function @probe(%condition : i64) -> void {
  slot $object : obj<8x8>

  block ^entry:
    eh_try ^cleanup_start
    call void @may_throw()
    eh_end
    return void

  block ^cleanup_start:
    %address = addr $object
    branch %condition, ^use, ^resume

  block ^use:
    call void @sink(%address)
    jump ^resume

  block ^resume:
    resume
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
