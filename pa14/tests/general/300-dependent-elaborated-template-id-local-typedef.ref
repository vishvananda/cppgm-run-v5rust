function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call i32 @library__read()
    %t2 = cmp eq i32 %t1, 7
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load typed i32 $cond__1
    return i32 %t3
}
function @library__read() -> i32 [binding=weak, object=_ZN7library4readIiEEiv] {
  slot $value : obj<4x4>

  block ^entry:
    %t1 = addr $value
    %t2 = addr $value
    %t3 = index i8 [projection=field] %t2, 0
    store typed i32 7, %t3
    %t4 = addr $value
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load typed i32 %t5
    return i32 %t6
}
