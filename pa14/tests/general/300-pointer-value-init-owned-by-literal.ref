function @make_pointer() -> ptr [binding=strong, object=_Z12make_pointerv] {
  block ^entry:
    return ptr 0
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : ptr
  slot $cond__1 : i32

  block ^entry:
    store typed ptr 0, $value
    %t1 = call ptr @make_pointer()
    %t2 = load typed ptr $value
    %t3 = cmp eq ptr %t1, %t2
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load typed i32 $cond__1
    return i32 %t4
}
