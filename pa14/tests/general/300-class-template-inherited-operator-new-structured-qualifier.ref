declare function @allocation__operatornew(%arg0 : i64) -> ptr [binding=strong, object=_ZN10allocationnwEm]

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $pointer : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = convert sext i64 i32 1
    %t2 = call ptr @allocation__operatornew(%t1)
    store typed ptr %t2, $pointer
    %t3 = load typed ptr $pointer
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load typed i32 $cond__1
    return i32 %t4
}
