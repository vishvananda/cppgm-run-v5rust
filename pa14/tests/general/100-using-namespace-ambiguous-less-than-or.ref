global @A [storage=readonly, binding=internal, object=_ZL1A] = {
  i32 1
  i32 4
}

function @f(%value : i32) -> u8 [binding=strong, object=_Z1fi] {
  slot $value : i32

  block ^entry:
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    %t2 = addr @A
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = load typed i32 %t3
    %t5 = cmp lt i32 %t1, %t4
    branch %t5, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t6 = load typed i32 $value
    %t7 = addr @A
    %t8 = index i8 [projection=field] %t7, 4
    %t9 = load typed i32 %t8
    %t10 = cmp gt i32 %t6, %t9
    branch %t10, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return u8 0

  block ^if_else_2:
    jump ^if_end_4

  block ^if_end_4:
    return u8 1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call u8 @f(3)
    branch %t1, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t2 = load typed i32 $cond__1
    return i32 %t2
}
