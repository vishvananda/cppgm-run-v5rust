function @use_identity(%value : i32) -> i32 [binding=strong, object=_Z12use_identityi] {
  slot $value : i32

  block ^entry:
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    %t2 = call i32 @identity(%t1)
    return i32 %t2
}
