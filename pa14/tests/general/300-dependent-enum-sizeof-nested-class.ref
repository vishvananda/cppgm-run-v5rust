function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $box : obj<16x4>

  block ^entry:
    %t1 = addr $box
    %t2 = addr $box
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = index i32 [projection=array_element] %t3, 0
    store typed i32 7, %t4
    %t5 = addr $box
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = index i32 [projection=array_element] %t6, 0
    %t8 = load typed i32 %t7
    return i32 %t8
}
