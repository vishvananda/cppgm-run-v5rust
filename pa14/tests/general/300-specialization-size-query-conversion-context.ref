function @sizes(%object : ptr [pass=by_address, object_bytes=8]) -> i64 [binding=strong, object=_Z5sizesR4cellIlE] {
  slot $object : ptr

  block ^entry:
    store typed ptr %object, $object
    %t1 = const i64 8
    %t2 = convert sext i64 i32 2
    %t3 = binary add i64 %t1, %t2
    %t4 = const i64 8
    %t5 = convert sext i64 i32 3
    %t6 = binary add i64 %t4, %t5
    %t7 = binary add i64 %t3, %t6
    %t8 = const i64 16
    %t9 = binary add i64 %t8, 4
    %t10 = binary add i64 %t7, %t9
    %t11 = const i64 8
    %t12 = convert sext i64 i32 5
    %t13 = binary add i64 %t11, %t12
    %t14 = binary add i64 %t10, %t13
    %t15 = const i64 8
    %t16 = convert sext i64 i32 6
    %t17 = binary add i64 %t15, %t16
    %t18 = binary add i64 %t14, %t17
    %t19 = const i64 8
    %t20 = binary add i64 %t19, 7
    %t21 = binary add i64 %t18, %t20
    %t22 = const i64 8
    %t23 = binary add i64 %t22, 8
    %t24 = binary add i64 %t21, %t23
    %t25 = const i64 8
    %t26 = binary add i64 %t25, 9
    %t27 = binary add i64 %t24, %t26
    %t28 = copy i64 %t27
    return i64 %t28
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $object : obj<8x8>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $object
    %t2 = addr $object
    %t3 = call i64 @sizes(%t2)
    %t4 = cmp eq i64 %t3, 116
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load typed i32 $cond__1
    return i32 %t5
}
