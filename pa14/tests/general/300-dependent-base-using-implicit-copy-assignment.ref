function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $source : obj<4x4>
  slot $target : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $source
    %t2 = addr $source
    %t3 = index i8 [projection=field] %t2, 0
    store typed i32 7, %t3
    %t4 = addr $target
    %t5 = addr $target
    %t6 = index i8 %t5, 0
    %t7 = index i8 [projection=field] %t6, 0
    store typed i32 0, %t7
    %t8 = addr $target
    %t9 = index i8 %t8, 0
    %t10 = addr $source
    %t11 = call ptr @slot__operator_(%t9, %t10)
    %t12 = addr $target
    %t13 = index i8 %t12, 0
    %t14 = index i8 [projection=field] %t13, 0
    %t15 = load typed i32 %t14
    %t16 = cmp eq i32 %t15, 7
    branch %t16, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t17 = load typed i32 $cond__1
    return i32 %t17
}
function @slot__operator_(%this : ptr [object_bytes=4], %other : ptr [pass=by_address, object_bytes=4]) -> ptr [unwind=no, binding=weak, object=_ZN4slotaSERKS_, inline_hint=yes] {
  slot $this : ptr
  slot $other : ptr

  block ^entry:
    store typed ptr %this, $this
    store typed ptr %other, $other
    %t1 = load typed ptr $this
    %t2 = load typed ptr $other
    copyobj 4x4 %t2, %t1
    %t3 = load typed ptr $this
    return ptr %t3
}
