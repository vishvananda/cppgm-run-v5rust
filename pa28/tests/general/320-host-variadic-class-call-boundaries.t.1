// Caller-owned class bytes and classifications must cross every variadic call.
struct F { float n; };
struct D { double n; };
struct M { double n; int m; };
struct L { long n[3]; };
struct E {};
struct G { int n; G(int, ...); };
struct C { int n; int read(int, ...); void method(); };
int read(int, ...);
int read_empty(int, ...);
int read_pointer(int, ...);
extern "C" int host_status();
typedef decltype(sizeof(0)) size_t;
void* operator new(size_t, ...);

int main()
{
  F f = { 2.0f };
  D d = { 3.0 };
  M m = { 4.0, 5 };
  L l = { { 6, 7, 8 } };
  if (!read(0, f, d, m, l)) return 1;
  if (!read(read(0, f, d, m, l), F{2.0f}, D{3.0}, M{4.0, 5}, l)) return 2;
  int (*p)(int, ...) = read;
  if (!p(0, f, d, m, l)) return 3;
  G g(0, f, d, m, l);
  if (g.n != 1) return 4;
  C c = { 9 };
  if (!c.read(0, f, d, m, l)) return 5;
  if (!read_empty(0, E{}, 10)) return 6;
  if (!read_pointer(0, &C::method)) return 7;
  int* q = new(f) int(11);
  if (*q != 11) return 8;
  delete q;
  return host_status();
}
