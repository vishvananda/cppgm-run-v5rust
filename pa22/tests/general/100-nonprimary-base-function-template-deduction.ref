    return i32 %t21
}
function @select(%target : ptr [pass=by_address, object_bytes=4]) -> i32 [binding=weak, object=_Z6selectIiEiR6TargetIT_E] {
  slot $target : ptr

  block ^entry:
    store typed ptr %target, $target
