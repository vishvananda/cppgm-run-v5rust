    %t8 = load typed i32 $got
    %t9 = const i64 4
    %t10 = convert sext i64 i32 %t8
    %t11 = cmp eq i64 %t10, %t9
    branch %t11, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
