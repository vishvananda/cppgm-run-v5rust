    %t14 = index i8 [projection=field] %t13, 0
    %t15 = load typed i32 %t14
    %t16 = const i64 4
    %t17 = convert sext i64 i32 %t15
    %t18 = cmp eq i64 %t17, %t16
    %t19 = cmp ne i64 %t18, 0
    store typed i64 %t19, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t20 = load typed i64 $land__2
    branch %t20, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
