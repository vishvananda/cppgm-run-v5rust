function @dot(%s : ptr [pass=by_address, object_bytes=4], %p : i64) -> void [binding=strong, object=_Z3dotR1SMS_Vi] {
  slot $s : ptr
  slot $p : i64

  block ^entry:
    store typed ptr %s, $s
    store typed i64 %p, $p
    %t1 = load typed ptr $s
    %t2 = load typed i64 $p
    %t3 = index i8 [projection=field] %t1, %t2
    %t4 = load volatile i32 %t3
    return void
}
