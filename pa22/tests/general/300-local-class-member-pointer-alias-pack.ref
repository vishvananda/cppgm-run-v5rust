function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @check()
    return i32 %t1
}
function @check() -> i32 [binding=internal, object=_Z5checkIZ4mainE5localEiv] {
  slot $value : i128
  slot $cond__1 : i32

  block ^entry:
    store typed i128 0, $value
    %t1 = load typed i128 $value
    %t2 = cmp eq i128 %t1, 0
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load typed i32 $cond__1
    return i32 %t3
}
