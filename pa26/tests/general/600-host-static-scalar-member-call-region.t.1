int attempts;
struct Base {
  int read(int value) const {
    if (++attempts == 1) throw 7;
    return value + 3;
  }
};
struct Reader : Base {
  int get() const {
    static int value = read(8);
    return value;
  }
};
int main() {
  Reader reader;
  try { reader.get(); return 1; } catch (int value) { if (value != 7) return 2; }
  if (reader.get() != 11 || reader.get() != 11 || attempts != 2) return 3;
  return 0;
}
