// N3485 5.2.9p4, 5.4p4, 12.2p5: a cast to a reference type whose operand's
// binding makes a temporary (a converting constructor's, a conversion
// function's, a converted scalar) designates it; a reference bound to the
// cast's result extends it as one bound to the operand would (as g++ and clang
// do): a local reference until its scope ends (also when an exception leaves
// it), a static or namespace-scope one until the program ends.
extern "C" int printf(const char*, ...);
struct V
{
	int id;
	explicit V(int k) : id(k) {}
};
struct W
{
	int w;
	W(V v) : w(v.id) { printf("W%d\n", w); }
	W(int x) : w(x) { printf("W%d\n", w); }
	~W() { printf("~W%d\n", w); }
};
struct C
{
	operator W() const { return W(77); }
};
const W& g = static_cast<const W&>(10);
const W& g2 = (const W&)11;
const int& gi = static_cast<const int&>(2.5);
int f(int k)
{
	static const W& s = static_cast<const W&>(k);
	return s.w;
}
void thrower(int k)
{
	if (k)
		throw k;
}
int main(int argc, char**)
{
	printf("main\n");
	{
		const W& r = static_cast<const W&>(V(3));
		printf("r %d\n", r.w);
	}
	{
		const W& r = static_cast<const W&>(4);
		printf("r %d\n", r.w);
	}
	{
		const W& r = (const W&)5;
		printf("r %d\n", r.w);
	}
	{
		W&& r = static_cast<W&&>(6);
		printf("r %d\n", r.w);
	}
	{
		const W& r = static_cast<const W&>(C());
		printf("r %d\n", r.w);
	}
	{
		const W& r = (static_cast<const W&>(12));
		printf("r %d\n", r.w);
	}
	try
	{
		const W& r = static_cast<const W&>(argc + 20);
		thrower(r.w);
	}
	catch (int e)
	{
		printf("caught %d\n", e);
	}
	int a = f(30);
	int b = f(31);
	printf("f %d %d g %d %d %d\n", a, b, g.w, g2.w, gi);
	return 0;
}
