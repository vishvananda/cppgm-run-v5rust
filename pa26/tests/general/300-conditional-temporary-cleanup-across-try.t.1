struct Value
{
  Value();
  Value(const Value &);
  ~Value();
  operator bool() const;
};

Value make_value();
bool next_value();

int calls;
int live_values;

void probe(bool first)
{
  if(first && make_value() && next_value()) {}
  try {
    if(first && make_value() && next_value()) {}
  } catch(...) {}
}

Value::Value() { ++live_values; }
Value::Value(const Value &) { ++live_values; }
Value::~Value() { --live_values; }
Value::operator bool() const { return true; }
Value make_value() { return Value(); }
bool next_value()
{
  if(++calls == 2) throw 7;
  return true;
}

int main()
{
  try {
    probe(true);
  } catch(...) {
    return 1;
  }
  return calls == 2 && live_values == 0 ? 0 : 2;
}
