// Itanium 5.1.8: a variadic lambda's signature is UlzE_ and a () lambda's
// UlvE_, numbered separately; two closures in an inline function must get
// distinct names; expect exit 0
inline int a() { auto v = [](...) { return 1; }; auto x = [] { return 2; }; return v() + x() * 10; }
int main() { return a() - 21; }
