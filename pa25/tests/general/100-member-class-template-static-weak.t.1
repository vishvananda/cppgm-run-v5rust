// N3485 14.7.1/3.2p6 + Itanium 5.2 (vague linkage): C<int>::I::b, a static
// data member of a member class of a class template, is instantiated in each
// TU that uses it and must be emitted weak/COMDAT; expect link ok and exit 0
template<class T> struct C { struct I { static int b; }; };
template<class T> int C<T>::I::b = 3;
int other();
int main() { return C<int>::I::b + other() == 6 ? 0 : 1; }
