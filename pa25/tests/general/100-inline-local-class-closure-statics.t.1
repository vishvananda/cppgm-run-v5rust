// N3485 7.1.2p4, 3.2p6, Itanium C++ ABI 5.1.6-5.1.8: the local classes and
// closure types of an extern inline function are the same entities in every
// unit, so their static locals (and cnt<L>'s) are one object
template<class T> int cnt() { static int n = 0; return ++n; }
inline int f() { struct L { static int g() { static int n = 0; return n += 1; } }; return L::g() + [] { static int m = 0; return m += 10; }() + cnt<L>() * 100; }
int other();
int main() { int a = f(); int b = other(); return a == 111 && b == 222 ? 0 : 1; }
