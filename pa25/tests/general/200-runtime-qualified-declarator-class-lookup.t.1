// Names after a qualified declarator-id are looked up in the member's class
// first (3.4.3p3): a conversion-function-id's type, the trailing return
// type, a dynamic or noexcept exception-specification and default
// arguments, where a namespace-scope name of another category would
// mislead the parser. A friend declaration naming a namespace's function
// looks its parameter types up as in the befriending class (g++ and
// clang++ both find C::T, an int, so N::f(int) is the friend).
struct X
{
	typedef int T;
	operator T();
	auto f() -> T;
	void h() throw(T);
	typedef int N;
	void g() noexcept((N) + 1 == 1);
	void d(int);
};
double T;
int N = 10;
X::operator T()
{
	return 1;
}
auto X::f() -> T
{
	return 2;
}
void X::h() throw(T)
{}
void X::g() noexcept((N) + 1 == 1)
{}
void X::d(int a = (T) + 1)
{
	(void)a;
}

namespace NS {
typedef char T;
int f(T);
int f(int);
}
struct C
{
	typedef int T;
	friend int NS::f(T);

private:
	static int p;
};
int C::p = 3;
int NS::f(int)
{
	return C::p;
}
int NS::f(char)
{
	return 0;
}

static_assert(noexcept(X().g()), "");
int main()
{
	X x;
	x.d();
	x.h();
	return (int)x + x.f() + NS::f(1) - 6;
}
