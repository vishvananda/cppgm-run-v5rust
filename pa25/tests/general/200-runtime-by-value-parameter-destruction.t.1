struct S {
  int * destroys;

  S(int * d)
    : destroys(d)
  {
  }

  S(const S & other)
    : destroys(other.destroys)
  {
  }

  ~S()
  {
    ++*destroys;
  }
};

bool f(S in)
{
  return true;
}

int main()
{
  int destroys = 0;
  S s(&destroys);
  bool alive_after_return = f(s) && destroys == 0;
  return alive_after_return && destroys == 1 ? 0 : 1;
}
