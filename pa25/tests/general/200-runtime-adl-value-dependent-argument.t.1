// A call whose argument's type is a template-id naming a non-type template
// parameter (`I<N - 1>`) is dependent (14.6.2.1p7, 14.6.2p1): in an
// instantiation its argument-dependent lookup sees the instantiation's
// context (14.6.4.2), which declares the template itself, so a trailing
// return type recurses through ADL. Where a non-template candidate is a
// perfect match the templates are not deduced (as GCC and Clang resolve,
// P3606): depth<0>'s return type, which would recurse without end, is
// never formed.
template<int N>
struct I
{};
template<int N>
struct Prev
{
	typedef I<N - 1> type;
};
template<>
struct Prev<0>
{};
int depth(I<0>)
{
	return 0;
}
template<int N>
auto depth(I<N>) -> decltype(depth(typename Prev<N>::type()))
{
	return 1 + depth(typename Prev<N>::type());
}
static_assert(sizeof(depth(I<3>())) == sizeof(int), "");

template<int N>
struct J
{};
int level(J<0>)
{
	return 0;
}
template<int N>
auto level(J<N>) -> decltype(level(J<N - 1>()))
{
	return 1 + level(J<N - 1>());
}

template<int N>
struct S
{
	int f() { return later(I<N>()); }
};
int later(I<2>)
{
	return 2;
}

int main()
{
	return depth(I<3>()) + level(J<4>()) + S<2>().f() - 9;
}
