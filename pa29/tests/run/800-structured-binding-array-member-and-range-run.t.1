struct Pair { int first; int second; };
template<class T> int sum(T& value) { auto& [x,y]=value; y+=3; return x+y; }
template<class T, int N> int run(T (&arr)[N]) { int n=0; for(auto& [x,y]:arr) { x+=1; n+=y; } return n; }
int run_copy(Pair (&arr)[2]){int n=0;for(auto [x,y]:arr){x+=y;n+=x;}return n;}
template<class T>struct Tree{template<class...A> __attribute__((visibility("hidden"))) int emplace(A&&...a){auto [x,y]=Pair{1,2};return x+y+sizeof...(a);}};
struct ReferencePair{int first;int& second;};
int reference(){int x=0;auto [a,b]=ReferencePair{1,x};b=7;return a+x;}
int class_array(){Pair a[2]={{1,2},{3,4}};auto& [x,y]=a;x.first+=y.second;return a[0].first;}
int main(){ Tree<int> tree; int a[2]={1,2}; Pair p[2]={{3,4},{5,6}}; return class_array()==5 && tree.emplace(1,2)==5 && reference()==8 && sum(a)==6 && a[1]==5 && run(p)==10 && run_copy(p)==20 && p[0].first==4?0:1; }
