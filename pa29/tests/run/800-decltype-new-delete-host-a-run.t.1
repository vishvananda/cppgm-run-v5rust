// same entities in every unit, whichever compiler builds it
#include "800-decltype-new-delete-host-a-run.helper.h"
#include <cstdio>
int main()
{
	long first = a_side();
	int v = 0, w = 0;
	release(&v);
	release_array(&w);
	long here = (long)counter(2) + (long)counter_init(2) + (long)counter_global(2) + v + w;
	long last = a_side();
	std::printf("%ld %ld %ld\n", first, here, last);
	return 0;
}
