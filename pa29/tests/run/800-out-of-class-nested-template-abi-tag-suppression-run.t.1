#define ABI_TAG(value) __attribute__((__abi_tag__(value)))

template<class T>
struct outer
{
  struct inner
  {
    explicit inner(outer *value) : result(detach(value))
    {
    }

    ABI_TAG("tagged_decl") static int detach(outer *);

    int result;
  };
};

template<class T>
int outer<T>::inner::detach(outer *)
{
  return 7;
}

int main()
{
  outer<int>::inner value(0);
  return value.result != 7;
}
