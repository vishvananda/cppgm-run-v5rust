// SysV psABI 3.2.3, 3.5.7: an __int128 or a pointer to member function passed
// to `...`, constant ones too (an __int128 literal, a null member function
// pointer), is read back by __builtin_va_arg from two INTEGER eightbytes, in
// memory 16-aligned for __int128 and 8-aligned for a member function pointer
struct S { int x; int f() { return x; } };
typedef int (S::*PF)();
static int wide(int n, ...)
{
	__builtin_va_list ap;
	__builtin_va_start(ap, n);
	int r = 0;
	for (int i = 0; i < n; ++i)
	{
		__int128 v = __builtin_va_arg(ap, __int128);
		r = r * 10 + (int)v + (int)(v >> 64);
	}
	__builtin_va_end(ap);
	return r;
}
static int pairs(int n, ...)
{
	__builtin_va_list ap;
	__builtin_va_start(ap, n);
	S s = { 3 };
	int r = 0;
	for (int i = 0; i < n; ++i)
	{
		PF pf = __builtin_va_arg(ap, PF);
		r = r * 10 + (pf ? (s.*pf)() : 0);
	}
	__builtin_va_end(ap);
	return r;
}
int main()
{
	__int128 a = 3;
	const int w = wide(5, a, (__int128)4, (__int128)0, a, ((__int128)1 << 64) | 4);
	const int p = pairs(5, &S::f, &S::f, PF(), &S::f, PF());
	return (w != 34035) + (p != 33030) * 2;
}
