// N3485 8.5p7, 8.5.4p3, 5.3.4p15: the elements of new T[n]() are
// value-initialized, and the elements of new T[n]{...} after those listed are
// value-initialized: scalars and classes without constructors are
// zero-initialized (a null pointer to data member is -1, Itanium C++ ABI 2.3),
// for counts up to 2^20
#include <cstdio>
#include <cstring>

struct P { int a; double b; char c; };
struct M { int x; int P::*m; };

volatile unsigned counts[] = { 0, 1, 3, 17, 4096, 1u << 20 };

template<class T> unsigned long nonzero(const T* p, unsigned n)
{
	unsigned long bad = 0;
	for (unsigned i = 0; i < n; ++i)
	{
		const unsigned char* bytes = reinterpret_cast<const unsigned char*>(p + i);
		for (unsigned k = 0; k < sizeof(T); ++k)
			bad += bytes[k] != 0;
	}
	return bad;
}

int main()
{
	unsigned long total = 0;
	for (unsigned c = 0; c < sizeof counts / sizeof counts[0]; ++c)
	{
		const unsigned n = counts[c];
		int* a = new int[n]();
		double* d = new double[n + 2]{ 1.5, 2.5 };
		P* p = new P[n]();
		M* m = new M[n + 1]{ { 7, &P::a } };
		char* s = new char[n + 3]{ 'x' };
		total += nonzero(a, n) + nonzero(d + 2, n) + nonzero(p, n) + nonzero(s + 1, n + 2);
		unsigned long nulls = 0;
		for (unsigned i = 1; i <= n; ++i)
			nulls += m[i].x == 0 && m[i].m == nullptr;
		std::printf("n=%u d0=%g d1=%g m0=%d s0=%c nulls=%lu\n", n, d[0], d[1], m[0].x, s[0], nulls);
		delete[] a;
		delete[] d;
		delete[] p;
		delete[] m;
		delete[] s;
	}
	std::printf("nonzero bytes %lu\n", total);
	return 0;
}
